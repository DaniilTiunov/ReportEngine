<UserControl
    x:Class="ReportEngine.App.Views.Controls.ProjectPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="800"
    Background="{DynamicResource PrimaryColor}"
    FontSize="15"
    Foreground="{DynamicResource PrimaryForeground}"
    PreviewKeyDown="DeleteSelectedEntity_KeyDown"
    Style="{DynamicResource AnimatedUserControlStyle}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ObvyazkaImagePathConverter x:Key="ObvyazkaImagePathConverter" />
        <converters:ByteArrayImageConverter x:Key="ByteArrayImageConverter" />

        <!--
            GridViewColumn does not have MinWidth. The minimum width of its
            header keeps an Auto-sized column readable when its cells are empty
            or contain short values, while longer content can still expand it.
        -->
        <Style
            x:Key="ContentSizedColumnHeaderStyle"
            BasedOn="{StaticResource {x:Type GridViewColumnHeader}}"
            TargetType="GridViewColumnHeader">
            <Setter Property="MinWidth" Value="120" />
        </Style>
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommandAsync}" />
    </UserControl.InputBindings>

    <ScrollViewer PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <!--  Главный грид  -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Левая часть, инфа по стендам  -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Стенды  -->
                <GroupBox
                    Grid.Row="0"
                    Grid.Column="0"
                    MinHeight="300"
                    MaxHeight="320"
                    Margin="5"
                    Padding="5"
                    VerticalAlignment="Top"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="⛭ Стенды в проекте — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.Company, TargetNullValue='(нет данных)'}" />
                            <Run FontSize="16" Text=" объекта — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.Object, TargetNullValue='(нет данных)'}" />
                        </TextBlock>
                    </GroupBox.Header>
                    <ui:ListView
                        x:Name="StandsList"
                        MaxHeight="300"
                        Background="{DynamicResource SecondaryColor}"
                        BorderBrush="{DynamicResource SecondaryColor}"
                        FontSize="15"
                        Foreground="{DynamicResource PrimaryForeground}"
                        ItemContainerStyle="{DynamicResource ThemedWpfUiListViewItemStyle}"
                        ItemsSource="{Binding CurrentProjectModel.Stands}"
                        MouseDoubleClick="StandListView_MouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand, Mode=TwoWay}"
                        SelectionChanged="StandsList_SelectionChanged"
                        SelectionMode="Extended">

                        <ui:ListView.View>
                            <ui:GridView ColumnHeaderContainerStyle="{StaticResource ContentSizedColumnHeaderStyle}">

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Number}">
                                    <GridViewColumn.Header>
                                        <ui:SymbolIcon
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryForeground}"
                                            Symbol="NumberSymbol24" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding KKSCode}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Key24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="KKS" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Design}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="DesignIdeas24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Обозначение" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding SerialNumber}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="BarcodeScanner24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Серийный номер" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding BraceType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Wrench24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Тип крепления" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Width}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Ruler24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Ширина, мм" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Weight}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="ScaleFill24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Масса, кг" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding StandSummCost}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Money24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Сум. стоимость" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                            </ui:GridView>
                        </ui:ListView.View>

                        <ui:ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.OpenCreateNewStandCommand}" Header="➕ Создать стенд" />
                                <MenuItem Command="{Binding ProjectCommandProvider.OpenEditStandCommand}" Header="✏️ Редактировать стенд" />
                                <MenuItem Command="{Binding ProjectCommandProvider.OnAddStandFromAllStandsCommand}" Header="📥 Добавить из других проектов" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.RenumerateStandsCommand}" Header="🔢 Пронумеровать стенды" />
                                <MenuItem Command="{Binding ProjectCommandProvider.CopyStandsCommand}" Header="📋 Создать копию" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.DeleteSelectedStandCommand}" Header="🗑 Удалить стенд" />
                                <Separator />
                                <MenuItem Header="📄 Создать отчет по выбранным">
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsSummaryReportCommand}" Header="📊 Сводная ведомость" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsComponentReportCommand}" Header="🔧 Комплектующие" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsNamePlatesReportCommand}" Header="🏷 Шильдики" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsMarksReportCommand}" Header="✏️ Маркировка" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsContainerReportCommand}" Header="📦 Тара" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsProductionReportCommand}" Header="🏭 Производство" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsFinPlaneReportCommand}" Header="💰 Фин. план" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsPassportReportCommand}" Header="📋 Паспорт" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsTechnoCardsReportCommand}" Header="📑 Тех. карты" />
                                </MenuItem>
                            </ContextMenu>
                        </ui:ListView.ContextMenu>
                    </ui:ListView>
                </GroupBox>

                <!--  Обвязки в стенде  -->
                <GroupBox
                    Grid.Row="1"
                    Grid.Column="0"
                    MinHeight="300"
                    MaxHeight="320"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">

                    <GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" HorizontalAlignment="Left">
                                <Run FontSize="15" Text="⚙️ Обвязки в стенде — " />
                                <Run
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(нет данных)'}" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" MinWidth="200" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right">
                                <Run FontSize="15" Text="Общее количество датчиков в стенде - " />
                                <Run Text=" (" />
                                <Run
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource StandWeightColor}"
                                    Text="{Binding CurrentProjectModel.SelectedStand.StandSensorsQuantity, TargetNullValue='(нет данных)'}" />
                                <Run Text=" шт.)" />
                            </TextBlock>
                        </Grid>
                    </GroupBox.Header>

                    <ui:ListView
                        x:Name="ObvyazkiListView"
                        MaxHeight="300"
                        Background="{DynamicResource SecondaryColor}"
                        BorderBrush="{DynamicResource SecondaryColor}"
                        FontSize="15"
                        Foreground="{DynamicResource PrimaryForeground}"
                        ItemContainerStyle="{DynamicResource ThemedWpfUiListViewItemStyle}"
                        ItemsSource="{Binding CurrentProjectModel.SelectedStand.ObvyazkiInStand}"
                        MouseDoubleClick="ListView_MouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedObvyazkaInStand, Mode=TwoWay}">

                        <ui:ListView.View>
                            <ui:GridView ColumnHeaderContainerStyle="{StaticResource ContentSizedColumnHeaderStyle}">
                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding NN}">
                                    <GridViewColumn.Header>
                                        <ui:SymbolIcon Foreground="{DynamicResource PrimaryForeground}" Symbol="NumberSymbol24" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding ObvyazkaName}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Pin24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Тип" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding MaterialLine}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Cube24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Материал" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Armature}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Settings24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Арматура" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding TreeSocket}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="BranchFork24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Тройник" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding KMCH}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Options24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="КМЧ" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding FirstSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="DeviceEq24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Датчик 1" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding SecondSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="DeviceEq24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Датчик 2" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding ThirdSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="DeviceEq24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Датчик 3" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                            </ui:GridView>
                        </ui:ListView.View>

                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.OpenObvSettingsWindowCommand}" Header="➕ Создать обвязку" />
                                <MenuItem Command="{Binding ProjectCommandProvider.FillStandFieldsFromObvyazkaCommand}" Header="✏️ Редактировать обвязку" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.RemoveObvFromStandCommand}" Header="🗑 Удалить обвязку" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.RenumerateObvInStandCommand}" Header="🔢 Пронумеровать обвязки" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ui:ListView>
                </GroupBox>

                <!--  Электрические компоненты  -->
                <GroupBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="⚡ Электрические компоненты — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(ошибка)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.SelectedStand.AllElectricalPurposesInStand.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>
                    <DataGrid
                        BeginningEdit="DataGrid_BeginningEdit"
                        CanUserAddRows="True"
                        FontSize="15"
                        ItemsSource="{Binding CurrentProjectModel.SelectedStand.AllElectricalPurposesInStand}"
                        LoadingRow="DataGrid_LoadingRow"
                        MouseDoubleClick="DataGrid_MouseDoubleClick"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedElectricalComponent}">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentProjectModel.SelectedStand.ElectricalPurposesChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UnsafeDetails}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Purpose}" Header="Назначение" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Material}"
                                Header="Доп. комплектующее" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Quantity}"
                                Header="Кол-во" />
                            <DataGridTextColumn
                                Width="75"
                                Binding="{Binding Measure}"
                                Header="Ед. изм." />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding CostPerUnit}"
                                Header="Цена" />
                            <DataGridTemplateColumn Width="90" Header="Выбрать">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="2,0,2,0"
                                            Padding="5,0,5,0"
                                            Command="{Binding DataContext.ProjectCommandProvider.OpenAllSortamentsDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Выбрать" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70" Header="Авто">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:ToggleSwitch
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsAutoCalculationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{DynamicResource FluentToggleSwitchStyle}"
                                            ToolTip="Автоматический расчёт" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.UpdateElectricalComponentInStandCommand}" Header="Сохранить изменения" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.DeleteElectricalComponentFromStandCommand}" Header="Удалить" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </GroupBox>

                <!--  Дополнительные компоненты в стенде  -->
                <GroupBox
                    Grid.Row="3"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="🧩 Дополнительные компоненты — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(ошибка)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.SelectedStand.AllAdditionalEquipPurposesInStand.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>
                    <DataGrid
                        BeginningEdit="DataGrid_BeginningEdit"
                        CanUserAddRows="True"
                        FontSize="15"
                        ItemsSource="{Binding CurrentProjectModel.SelectedStand.AllAdditionalEquipPurposesInStand}"
                        LoadingRow="DataGrid_LoadingRow"
                        MouseDoubleClick="DataGrid_MouseDoubleClick"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedAdditionalEquip}">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentProjectModel.SelectedStand.AdditionalPurposesChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UnsafeDetails}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Purpose}" Header="Назначение" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Material}"
                                Header="Доп. комплектующее" />
                            <DataGridTextColumn Binding="{Binding Quantity}" Header="Кол-во" />
                            <DataGridTextColumn Binding="{Binding Measure}" Header="Ед. изм." />
                            <DataGridTextColumn Binding="{Binding CostPerUnit}" Header="Цена" />
                            <DataGridTemplateColumn Header="Выбрать">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="2,0,2,0"
                                            Padding="5,0,5,0"
                                            Command="{Binding DataContext.ProjectCommandProvider.OpenAllSortamentsDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Выбрать" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70" Header="Авто">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:ToggleSwitch
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsAutoCalculationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{DynamicResource FluentToggleSwitchStyle}"
                                            ToolTip="Автоматический расчёт" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.UpdateAdditionalComponentInStandCommand}" Header="Сохранить изменения" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.DeleteAdditionalComponentFromStandCommand}" Header="Удалить" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </GroupBox>

                <!--  Дренаж в стенде  -->
                <GroupBox
                    Grid.Row="4"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="💧 Дренаж — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(ошибка)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.SelectedStand.AllDrainagePurposesInStand.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>
                    <DataGrid
                        BeginningEdit="DataGrid_BeginningEdit"
                        CanUserAddRows="True"
                        FontSize="15"
                        ItemsSource="{Binding CurrentProjectModel.SelectedStand.AllDrainagePurposesInStand}"
                        LoadingRow="DataGrid_LoadingRow"
                        MouseDoubleClick="DataGrid_MouseDoubleClick"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedDrainagePurpose}">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentProjectModel.SelectedStand.DrainagePurposesChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UnsafeDetails}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Purpose}" Header="Назначение" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Material}"
                                Header="Материал" />
                            <DataGridTextColumn Binding="{Binding Quantity}" Header="Кол-во" />
                            <DataGridTextColumn Binding="{Binding Measure}" Header="Ед. изм." />
                            <DataGridTextColumn Binding="{Binding CostPerUnit}" Header="Цена" />
                            <DataGridTemplateColumn Header="Выбрать">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button
                                            Margin="2,0,2,0"
                                            Padding="5,0,5,0"
                                            Command="{Binding DataContext.ProjectCommandProvider.OpenAllSortamentsDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Выбрать" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70" Header="Авто">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:ToggleSwitch
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsAutoCalculationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            Style="{DynamicResource FluentToggleSwitchStyle}"
                                            ToolTip="Автоматический расчёт" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.UpdateDrainageComponentInStandCommand}" Header="Сохранить изменения" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.DeleteDrainageComponentFromStandCommand}" Header="Удалить" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </GroupBox>

                <StackPanel
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Right">
                    <Button Command="{Binding ProjectCommandProvider.SaveAllChangesInComponentsCommand}" Content="💾 Сохранить все изменения" />
                </StackPanel>
            </Grid>

            <!--  Правая часть, инфа по проекту + чертёж  -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GroupBox
                    Grid.Row="0"
                    Margin="5"
                    Padding="5"
                    VerticalAlignment="Top"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="🖼 Рамы в стенде — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(нет данных)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.SelectedStand.FramesInStand.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <!--  Рамы  -->
                        <ui:ListView
                            Grid.Column="0"
                            MaxHeight="150"
                            BorderBrush="{DynamicResource SecondaryColor}"
                            DisplayMemberPath="Name"
                            FontSize="15"
                            Foreground="{DynamicResource PrimaryForeground}"
                            ItemContainerStyle="{DynamicResource ThemedWpfUiListViewItemStyle}"
                            ItemsSource="{Binding CurrentProjectModel.SelectedStand.FramesInStand}"
                            ScrollViewer.HorizontalScrollBarVisibility="Auto"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedFrame}">

                            <ui:ListView.View>
                                <ui:GridView ColumnHeaderContainerStyle="{StaticResource ContentSizedColumnHeaderStyle}">
                                    <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Name}">
                                        <GridViewColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Symbol="Pin24" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Text="Наименование" />
                                            </StackPanel>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>

                                    <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding FrameType}">
                                        <GridViewColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Symbol="Tag24" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Text="Тип" />
                                            </StackPanel>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>

                                    <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Width}">
                                        <GridViewColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Symbol="Ruler24" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Text="Ширина" />
                                            </StackPanel>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>

                                    <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Height}">
                                        <GridViewColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Symbol="ArrowUp24" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Text="Высота" />
                                            </StackPanel>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>

                                    <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Depth}">
                                        <GridViewColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Symbol="ArrowRight24" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Text="Глубина" />
                                            </StackPanel>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>

                                    <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Weight}">
                                        <GridViewColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Symbol="ScaleFit24" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Text="Масса" />
                                            </StackPanel>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>

                                    <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Designe}">
                                        <GridViewColumn.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon
                                                    Margin="0,0,6,0"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Symbol="DocumentText24" />
                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource PrimaryForeground}"
                                                    Text="Описание" />
                                            </StackPanel>
                                        </GridViewColumn.Header>
                                    </GridViewColumn>
                                </ui:GridView>

                            </ui:ListView.View>
                            <ui:ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ProjectCommandProvider.RemoveFrameStandCommand}" Header="Удалить раму">
                                        <MenuItem.Icon>
                                            <ui:SymbolIcon Foreground="IndianRed" Symbol="Delete24" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </ui:ListView.ContextMenu>
                        </ui:ListView>

                        <Button
                            Grid.Column="1"
                            Width="30"
                            Height="30"
                            Margin="5,5,5,5"
                            Command="{Binding ProjectCommandProvider.ShowFrameDialogCommand}"
                            Content="➕"
                            ToolTip="Добавить раму" />
                    </Grid>
                </GroupBox>

                <!--  Обвязки в проекте  -->
                <GroupBox
                    Grid.Row="1"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">

                    <GroupBox.Header>
                        <ui:TextBlock>
                            <Run FontSize="15" Text="📦 Обвязки в проекте — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.Company, TargetNullValue='(нет данных)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.ObvyazkiInProject.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </ui:TextBlock>
                    </GroupBox.Header>

                    <ui:ListView
                        MaxHeight="300"
                        Background="{DynamicResource SecondaryColor}"
                        BorderBrush="{DynamicResource SecondaryColor}"
                        FontSize="15"
                        ItemContainerStyle="{DynamicResource ThemedWpfUiListViewItemStyle}"
                        ItemsSource="{Binding CurrentProjectModel.ObvyazkiInProject}"
                        ScrollViewer.HorizontalScrollBarVisibility="Auto"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        SelectedItem="{Binding CurrentProjectModel.SelectedObvyazkaToCopy}">

                        <ui:ListView.View>
                            <ui:GridView ColumnHeaderContainerStyle="{StaticResource ContentSizedColumnHeaderStyle}">

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding ObvyazkaName}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Pin24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Тип" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding MaterialLine}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Cube24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Материал" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding Armature}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Settings24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Арматура" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding TreeSocket}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="BranchFork24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Тройник" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding KMCH}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Options24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="КМЧ" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding FirstSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Pulse24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Датчик 1" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding SecondSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Pulse24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Датчик 2" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="Auto" DisplayMemberBinding="{Binding ThirdSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Pulse24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Датчик 3" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                            </ui:GridView>
                        </ui:ListView.View>

                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.CopyObvyazkaToStandsCommand}" Header="Скопировать в выбранный стенд">
                                    <MenuItem.Icon>
                                        <ui:SymbolIcon Symbol="Copy24" />
                                    </MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ui:ListView>
                </GroupBox>

                <!--  Объединённая секция: Чертёж стенда + инфо  -->
                <GroupBox
                    Grid.Row="2"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="🎨 Чертёж стенда — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(ошибка)'}" />
                        </TextBlock>
                    </GroupBox.Header>
                    <Border
                        Padding="8"
                        Background="{DynamicResource SecondaryColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Чертеж  -->
                            <Border
                                Grid.Column="0"
                                Padding="4"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource PrimaryColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Image
                                    x:Name="StandDrawingImage"
                                    MaxHeight="500"
                                    Focusable="True"
                                    Source="{Binding CurrentProjectModel.SelectedStand.ImageData, Converter={StaticResource ByteArrayImageConverter}}"
                                    Stretch="Uniform" />
                            </Border>

                            <GridSplitter
                                Grid.Column="1"
                                Width="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource BorderColor}"
                                Cursor="SizeWE"
                                ResizeBehavior="PreviousAndNext"
                                ResizeDirection="Columns" />

                            <!--  Обвязка  -->
                            <Border
                                Grid.Column="2"
                                Padding="4"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource PrimaryColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Text="🖼 Обвязка" />
                                    <Image
                                        Grid.Row="1"
                                        MaxHeight="400"
                                        Source="{Binding CurrentProjectModel.SelectedStand.SelectedObvyazkaInStand.ImageName, Converter={StaticResource ObvyazkaImagePathConverter}}"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </GroupBox>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
