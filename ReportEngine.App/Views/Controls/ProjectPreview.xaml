<UserControl
    x:Class="ReportEngine.App.Views.Controls.ProjectPreview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="700"
    d:DesignWidth="800"
    Background="{DynamicResource PrimaryColor}"
    FontSize="15"
    Foreground="{DynamicResource PrimaryForeground}"
    PreviewKeyDown="DeleteSelectedEntity_KeyDown"
    Style="{DynamicResource AnimatedUserControlStyle}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ObvyazkaImagePathConverter x:Key="ObvyazkaImagePathConverter" />
        <converters:ByteArrayImageConverter x:Key="ByteArrayImageConverter" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommandAsync}" />
    </UserControl.InputBindings>

    <ScrollViewer PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
        <!--  Главный грид  -->
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Левая часть, инфа по стендам  -->
            <Grid Grid.Row="0" Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Стенды  -->
                <GroupBox
                    Grid.Row="0"
                    Grid.Column="0"
                    MinHeight="300"
                    MaxHeight="320"
                    Margin="5"
                    Padding="5"
                    VerticalAlignment="Top"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="⛭ Стенды в проекте — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.Company, TargetNullValue='(нет данных)'}" />
                            <Run FontSize="16" Text=" объекта — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.Object, TargetNullValue='(нет данных)'}" />
                        </TextBlock>
                    </GroupBox.Header>
                    <ui:ListView
                        x:Name="StandsList"
                        MaxHeight="300"
                        Background="{DynamicResource SecondaryColor}"
                        FontSize="15"
                        Foreground="{DynamicResource PrimaryForeground}"
                        ItemContainerStyle="{DynamicResource ThemedWpfUiListViewItemStyle}"
                        ItemsSource="{Binding CurrentProjectModel.Stands}"
                        MouseDoubleClick="StandListView_MouseDoubleClick"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand, Mode=TwoWay}"
                        SelectionChanged="StandsList_SelectionChanged"
                        SelectionMode="Extended">

                        <ui:ListView.View>
                            <ui:GridView>

                                <GridViewColumn Width="40" DisplayMemberBinding="{Binding Number}">
                                    <GridViewColumn.Header>
                                        <ui:SymbolIcon
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource PrimaryForeground}"
                                            Symbol="NumberSymbol24" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding KKSCode}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Key24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="KKS" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="200" DisplayMemberBinding="{Binding Design}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="DesignIdeas24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Обозначение" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="200" DisplayMemberBinding="{Binding SerialNumber}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="BarcodeScanner24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Серийный номер" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="130" DisplayMemberBinding="{Binding BraceType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Wrench24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Тип крепления" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding Width}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Ruler24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Ширина, мм" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding Weight}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="ScaleFill24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Масса, кг" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="150" DisplayMemberBinding="{Binding StandSummCost}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon
                                                Margin="0,0,6,0"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Symbol="Money24" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Text="Сум. стоимость" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                            </ui:GridView>
                        </ui:ListView.View>

                        <ui:ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.OpenCreateNewStandCommand}" Header="➕ Создать стенд" />
                                <MenuItem Command="{Binding ProjectCommandProvider.OpenEditStandCommand}" Header="✏️ Редактировать стенд" />
                                <MenuItem Command="{Binding ProjectCommandProvider.OnAddStandFromAllStandsCommand}" Header="📥 Добавить из других проектов" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.RenumerateStandsCommand}" Header="🔢 Пронумеровать стенды" />
                                <MenuItem Command="{Binding ProjectCommandProvider.CopyStandsCommand}" Header="📋 Создать копию" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.DeleteSelectedStandCommand}" Header="🗑 Удалить стенд" />
                                <Separator />
                                <MenuItem Header="📄 Создать отчет по выбранным">
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsSummaryReportCommand}" Header="📊 Сводная ведомость" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsComponentReportCommand}" Header="🔧 Комплектующие" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsNamePlatesReportCommand}" Header="🏷 Шильдики" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsMarksReportCommand}" Header="✏️ Маркировка" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsContainerReportCommand}" Header="📦 Тара" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsProductionReportCommand}" Header="🏭 Производство" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsFinPlaneReportCommand}" Header="💰 Фин. план" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsPassportReportCommand}" Header="📋 Паспорт" />
                                    <MenuItem Command="{Binding ProjectCommandProvider.SelectedStandsTechnoCardsReportCommand}" Header="📑 Тех. карты" />
                                </MenuItem>
                            </ContextMenu>
                        </ui:ListView.ContextMenu>
                    </ui:ListView>
                </GroupBox>

                <!--  Обвязки в стенде  -->
                <GroupBox
                    Grid.Row="1"
                    Grid.Column="0"
                    MinHeight="300"
                    MaxHeight="320"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">

                    <GroupBox.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" HorizontalAlignment="Left">
                                <Run FontSize="15" Text="Обвязки в стенде — " />
                                <Run
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(нет данных)'}" />
                            </TextBlock>
                            <TextBlock Grid.Column="1" MinWidth="200" />
                            <TextBlock Grid.Column="2" HorizontalAlignment="Right">
                                <Run FontSize="15" Text="Общее количество датчиков в стенде - " />
                                <Run
                                    FontSize="15"
                                    FontWeight="Bold"
                                    Text="{Binding CurrentProjectModel.SelectedStand.StandSensorsQuantity, TargetNullValue='(нет данных)'}" />
                                <Run FontSize="14" Text="шт." />
                            </TextBlock>
                        </Grid>
                    </GroupBox.Header>

                    <ui:ListView
                        x:Name="ObvyazkiListView"
                        MaxHeight="300"
                        FontSize="15"
                        Foreground="{DynamicResource PrimaryForeground}"
                        ItemContainerStyle="{DynamicResource ThemedWpfUiListViewItemStyle}"
                        ItemsSource="{Binding CurrentProjectModel.SelectedStand.ObvyazkiInStand}"
                        MouseDoubleClick="ListView_MouseDoubleClick"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedObvyazkaInStand, Mode=TwoWay}">

                        <ui:ListView.View>
                            <ui:GridView>
                                <GridViewColumn Width="60" DisplayMemberBinding="{Binding NN}">
                                    <GridViewColumn.Header>
                                        <ui:SymbolIcon Symbol="NumberSymbol24" />
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="100" DisplayMemberBinding="{Binding ObvyazkaName}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Pin24" />
                                            <TextBlock VerticalAlignment="Center" Text="Тип" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding MaterialLine}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Cube24" />
                                            <TextBlock VerticalAlignment="Center" Text="Материал" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding Armature}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Settings24" />
                                            <TextBlock VerticalAlignment="Center" Text="Арматура" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding TreeSocket}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="BranchFork24" />
                                            <TextBlock VerticalAlignment="Center" Text="Тройник" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding KMCH}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="Options24" />
                                            <TextBlock VerticalAlignment="Center" Text="КМЧ" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding FirstSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="DeviceEq24" />
                                            <TextBlock VerticalAlignment="Center" Text="Датчик 1" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding SecondSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="DeviceEq24" />
                                            <TextBlock VerticalAlignment="Center" Text="Датчик 2" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>

                                <GridViewColumn Width="120" DisplayMemberBinding="{Binding ThirdSensorType}">
                                    <GridViewColumn.Header>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:SymbolIcon Margin="0,0,6,0" Symbol="DeviceEq24" />
                                            <TextBlock VerticalAlignment="Center" Text="Датчик 3" />
                                        </StackPanel>
                                    </GridViewColumn.Header>
                                </GridViewColumn>
                            </ui:GridView>
                        </ui:ListView.View>

                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.OpenObvSettingsWindowCommand}" Header="➕ Создать обвязку" />
                                <MenuItem Command="{Binding ProjectCommandProvider.FillStandFieldsFromObvyazkaCommand}" Header="✏️ Редактировать обвязку" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.RemoveObvFromStandCommand}" Header="🗑 Удалить обвязку" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.RenumerateObvInStandCommand}" Header="🔢 Пронумеровать обвязки" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ui:ListView>
                </GroupBox>

                <!--  Электрические компоненты  -->
                <GroupBox
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="⚡ Электрические компоненты — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(ошибка)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.SelectedStand.AllElectricalPurposesInStand.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>
                    <DataGrid
                        BeginningEdit="DataGrid_BeginningEdit"
                        CanUserAddRows="True"
                        FontSize="15"
                        ItemsSource="{Binding CurrentProjectModel.SelectedStand.AllElectricalPurposesInStand}"
                        LoadingRow="DataGrid_LoadingRow"
                        MouseDoubleClick="DataGrid_MouseDoubleClick"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedElectricalComponent}">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentProjectModel.SelectedStand.ElectricalPurposesChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UnsafeDetails}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Purpose}" Header="Назначение" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Material}"
                                Header="Доп. комплектующее" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Quantity}"
                                Header="Кол-во" />
                            <DataGridTextColumn
                                Width="75"
                                Binding="{Binding Measure}"
                                Header="Ед. изм." />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding CostPerUnit}"
                                Header="Цена" />
                            <DataGridTemplateColumn Width="90" Header="Выбрать">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button
                                            Margin="2,0,2,0"
                                            Padding="5,0,5,0"
                                            Command="{Binding DataContext.ProjectCommandProvider.OpenAllSortamentsDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Выбрать"
                                            Style="{DynamicResource FluentButton}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70" Header="Авто">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsAutoCalculationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.UpdateElectricalComponentInStandCommand}" Header="Сохранить изменения" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.DeleteElectricalComponentFromStandCommand}" Header="Удалить" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </GroupBox>

                <!--  Дополнительные компоненты в стенде  -->
                <GroupBox
                    Grid.Row="3"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="🧩 Дополнительные компоненты — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(ошибка)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.SelectedStand.AllAdditionalEquipPurposesInStand.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>
                    <DataGrid
                        BeginningEdit="DataGrid_BeginningEdit"
                        CanUserAddRows="True"
                        FontSize="15"
                        ItemsSource="{Binding CurrentProjectModel.SelectedStand.AllAdditionalEquipPurposesInStand}"
                        LoadingRow="DataGrid_LoadingRow"
                        MouseDoubleClick="DataGrid_MouseDoubleClick"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedAdditionalEquip}">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentProjectModel.SelectedStand.AdditionalPurposesChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UnsafeDetails}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Purpose}" Header="Назначение" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Material}"
                                Header="Доп. комплектующее" />
                            <DataGridTextColumn Binding="{Binding Quantity}" Header="Кол-во" />
                            <DataGridTextColumn Binding="{Binding Measure}" Header="Ед. изм." />
                            <DataGridTextColumn Binding="{Binding CostPerUnit}" Header="Цена" />
                            <DataGridTemplateColumn Header="Выбрать">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button
                                            Margin="2,0,2,0"
                                            Padding="5,0,5,0"
                                            Command="{Binding DataContext.ProjectCommandProvider.OpenAllSortamentsDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Выбрать"
                                            Style="{DynamicResource FluentButton}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70" Header="Авто">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsAutoCalculationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.UpdateAdditionalComponentInStandCommand}" Header="Сохранить изменения" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.DeleteAdditionalComponentFromStandCommand}" Header="Удалить" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </GroupBox>

                <!--  Дренаж в стенде  -->
                <GroupBox
                    Grid.Row="4"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="💧 Дренаж — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(ошибка)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.SelectedStand.AllDrainagePurposesInStand.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>
                    <DataGrid
                        BeginningEdit="DataGrid_BeginningEdit"
                        CanUserAddRows="True"
                        FontSize="15"
                        ItemsSource="{Binding CurrentProjectModel.SelectedStand.AllDrainagePurposesInStand}"
                        LoadingRow="DataGrid_LoadingRow"
                        MouseDoubleClick="DataGrid_MouseDoubleClick"
                        SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedDrainagePurpose}">
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.CurrentProjectModel.SelectedStand.DrainagePurposesChanges, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource UnsafeDetails}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Purpose}" Header="Назначение" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Material}"
                                Header="Материал" />
                            <DataGridTextColumn Binding="{Binding Quantity}" Header="Кол-во" />
                            <DataGridTextColumn Binding="{Binding Measure}" Header="Ед. изм." />
                            <DataGridTextColumn Binding="{Binding CostPerUnit}" Header="Цена" />
                            <DataGridTemplateColumn Header="Выбрать">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ui:Button
                                            Margin="2,0,2,0"
                                            Padding="5,0,5,0"
                                            Command="{Binding DataContext.ProjectCommandProvider.OpenAllSortamentsDialogCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Content="Выбрать"
                                            Style="{DynamicResource FluentButton}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="70" Header="Авто">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsChecked="{Binding IsAutoCalculationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.UpdateDrainageComponentInStandCommand}" Header="Сохранить изменения" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.DeleteDrainageComponentFromStandCommand}" Header="Удалить" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </GroupBox>

                <StackPanel
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="5"
                    HorizontalAlignment="Right">
                    <ui:Button
                        Command="{Binding ProjectCommandProvider.SaveAllChangesInComponentsCommand}"
                        Content="💾 Сохранить все изменения"
                        Style="{DynamicResource FluentButton}" />
                </StackPanel>
            </Grid>

            <!--  Правая часть, инфа по проекту + чертёж  -->
            <Grid Grid.Row="0" Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <GroupBox
                    Grid.Row="0"
                    Margin="5"
                    Padding="5"
                    VerticalAlignment="Top"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="🖼 Рамы в стенде — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(нет данных)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.SelectedStand.FramesInStand.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>

                        <!--  Рамы  -->
                        <ListView
                            Grid.Column="0"
                            MaxHeight="150"
                            DisplayMemberPath="Name"
                            FontSize="15"
                            ItemsSource="{Binding CurrentProjectModel.SelectedStand.FramesInStand}"
                            SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedFrame}">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn
                                        Width="150"
                                        DisplayMemberBinding="{Binding Name}"
                                        Header="📌 Наименование" />
                                    <GridViewColumn
                                        Width="150"
                                        DisplayMemberBinding="{Binding FrameType}"
                                        Header="🏷 Тип" />
                                    <GridViewColumn
                                        Width="80"
                                        DisplayMemberBinding="{Binding Width}"
                                        Header="📏 Ширина" />
                                    <GridViewColumn
                                        Width="80"
                                        DisplayMemberBinding="{Binding Height}"
                                        Header="📐 Высота" />
                                    <GridViewColumn
                                        Width="80"
                                        DisplayMemberBinding="{Binding Depth}"
                                        Header="📏 Глубина" />
                                    <GridViewColumn
                                        Width="80"
                                        DisplayMemberBinding="{Binding Weight}"
                                        Header="⚖️ Масса" />
                                    <GridViewColumn
                                        Width="150"
                                        DisplayMemberBinding="{Binding Designe}"
                                        Header="📝 Описание" />
                                </GridView>
                            </ListView.View>
                            <ListView.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ProjectCommandProvider.RemoveFrameStandCommand}" Header="🗑 Удалить раму" />
                                </ContextMenu>
                            </ListView.ContextMenu>
                        </ListView>
                        <ui:Button
                            Grid.Column="1"
                            MaxHeight="20"
                            Margin="10,10,10,10"
                            Command="{Binding ProjectCommandProvider.ShowFrameDialogCommand}"
                            Content="➕"
                            Style="{DynamicResource FluentButton}" />
                    </Grid>
                </GroupBox>

                <!--  Обвязки в проекте  -->
                <GroupBox
                    Grid.Row="1"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="📦 Обвязки в проекте — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.Company, TargetNullValue='(нет данных)'}" />
                            <Run Text=" (" />
                            <Run
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StandWeightColor}"
                                Text="{Binding CurrentProjectModel.ObvyazkiInProject.Count, Mode=OneWay}" />
                            <Run Text=" шт.)" />
                        </TextBlock>
                    </GroupBox.Header>
                    <ListView
                        MaxHeight="300"
                        FontSize="15"
                        ItemsSource="{Binding CurrentProjectModel.ObvyazkiInProject}"
                        SelectedItem="{Binding CurrentProjectModel.SelectedObvyazkaToCopy}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn
                                    Width="100"
                                    DisplayMemberBinding="{Binding ObvyazkaName}"
                                    Header="📌 Тип" />
                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding MaterialLine}"
                                    Header="🧱 Материал" />
                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding Armature}"
                                    Header="🔩 Арматура" />
                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding TreeSocket}"
                                    Header="🔧 Тройник" />
                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding KMCH}"
                                    Header="⚙️ КМЧ" />
                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding FirstSensorType}"
                                    Header="📡 Датчик 1" />
                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding SecondSensorType}"
                                    Header="📡 Датчик 2" />
                                <GridViewColumn
                                    Width="120"
                                    DisplayMemberBinding="{Binding ThirdSensorType}"
                                    Header="📡 Датчик 3" />
                            </GridView>
                        </ListView.View>
                        <ListView.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.CopyObvyazkaToStandsCommand}" Header="📋 Скопировать в выбранный стенд" />
                            </ContextMenu>
                        </ListView.ContextMenu>
                    </ListView>
                </GroupBox>

                <!--  Объединённая секция: Чертёж стенда + инфо  -->
                <GroupBox
                    Grid.Row="2"
                    Margin="5"
                    Padding="5"
                    BorderThickness="0">
                    <GroupBox.Header>
                        <TextBlock>
                            <Run FontSize="15" Text="🎨 Чертёж стенда — " />
                            <Run
                                FontSize="15"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(ошибка)'}" />
                        </TextBlock>
                    </GroupBox.Header>
                    <Border
                        Padding="8"
                        Background="{DynamicResource SecondaryColor}"
                        BorderBrush="{DynamicResource BorderColor}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="6" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Чертеж  -->
                            <Border
                                Grid.Column="0"
                                Padding="4"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource PrimaryColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Image
                                    x:Name="StandDrawingImage"
                                    MaxHeight="500"
                                    Focusable="True"
                                    Source="{Binding CurrentProjectModel.SelectedStand.ImageData, Converter={StaticResource ByteArrayImageConverter}}"
                                    Stretch="Uniform" />
                            </Border>

                            <GridSplitter
                                Grid.Column="1"
                                Width="6"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource BorderColor}"
                                Cursor="SizeWE"
                                ResizeBehavior="PreviousAndNext"
                                ResizeDirection="Columns" />

                            <!--  Обвязка  -->
                            <Border
                                Grid.Column="2"
                                Padding="4"
                                VerticalAlignment="Stretch"
                                Background="{DynamicResource PrimaryColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                CornerRadius="6">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock
                                        Grid.Row="0"
                                        Margin="0,0,0,5"
                                        HorizontalAlignment="Center"
                                        FontSize="15"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Text="🖼 Обвязка" />
                                    <Image
                                        Grid.Row="1"
                                        MaxHeight="400"
                                        Source="{Binding CurrentProjectModel.SelectedStand.SelectedObvyazkaInStand.ImageName, Converter={StaticResource ObvyazkaImagePathConverter}}"
                                        Stretch="Uniform" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </GroupBox>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
