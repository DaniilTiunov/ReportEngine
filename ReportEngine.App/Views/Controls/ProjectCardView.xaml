<UserControl
    FontSize="16"
    HorizontalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    VerticalAlignment="Stretch"
    x:Class="ReportEngine.App.Views.Controls.ProjectCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer
        HorizontalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        Margin="10"
        VerticalAlignment="Stretch"
        VerticalScrollBarVisibility="Auto">

        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  =========================================================  -->
            <!--  ОСНОВНАЯ ИНФОРМАЦИЯ  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Column="0"
                Grid.Row="0"
                Header="Основная информация"
                Margin="0,0,0,12">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Height="21"
                                Kind="InformationOutline"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Width="21" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Основная информация"
                                VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  №  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="Pound"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="№ п/п:" VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Grid.Row="0"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.Number}" />


                    <!--  Обозначение  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="FileDocumentOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Обозначение КД:" VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Grid.Row="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.Description}" />


                    <!--  Дата  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="CalendarOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Дата запроса:" VerticalAlignment="Center" />

                    </StackPanel>

                    <DatePicker
                        Grid.Column="1"
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Margin="5"
                        MaxWidth="180"
                        SelectedDate="{Binding CurrentProjectModel.CreationDate}" />


                    <!--  Заказчик  -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="OfficeBuildingOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Заказчик:" VerticalAlignment="Center" />

                    </StackPanel>

                    <Grid Grid.Column="1" Grid.Row="3">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="5"
                            Text="{Binding CurrentProjectModel.Company}" />

                        <Button
                            Command="{Binding ProjectCommandProvider.ShowCompanyDialogCommand}"
                            Content="..."
                            Grid.Column="1"
                            Height="32"
                            Margin="5"
                            Width="32" />

                    </Grid>


                    <!--  Объект  -->
                    <StackPanel
                        Grid.Row="4"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="MapMarkerOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Объект:" VerticalAlignment="Center" />

                    </StackPanel>

                    <Grid Grid.Column="1" Grid.Row="4">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="5"
                            Text="{Binding CurrentProjectModel.Object}" />

                        <Button
                            Command="{Binding ProjectCommandProvider.ShowSubjectDialogCommand}"
                            Content="..."
                            Grid.Column="1"
                            Height="32"
                            Margin="5"
                            Width="32" />

                    </Grid>

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  СРОКИ ПРОЕКТА  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Column="2"
                Grid.Row="0"
                Header="Сроки проекта"
                Margin="0,0,0,12">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Height="21"
                                Kind="CalendarClock"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Width="21" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Сроки проекта"
                                VerticalAlignment="Center" />

                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  Старт  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="ClockOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Старт проекта:" VerticalAlignment="Center" />

                    </StackPanel>

                    <DatePicker
                        Grid.Column="1"
                        Grid.Row="0"
                        HorizontalAlignment="Left"
                        Margin="5"
                        MaxWidth="180"
                        SelectedDate="{Binding CurrentProjectModel.StartDate}" />


                    <!--  Выход из производства  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="Factory"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Выход из производства:" VerticalAlignment="Center" />

                    </StackPanel>

                    <DatePicker
                        Grid.Column="1"
                        Grid.Row="1"
                        HorizontalAlignment="Left"
                        Margin="5"
                        MaxWidth="180"
                        SelectedDate="{Binding CurrentProjectModel.OutOfProduction}" />


                    <!--  Окончание договора  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="CalendarRemoveOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Дата окончания договора:" VerticalAlignment="Center" />

                    </StackPanel>

                    <DatePicker
                        Grid.Column="1"
                        Grid.Row="2"
                        HorizontalAlignment="Left"
                        Margin="5"
                        MaxWidth="180"
                        SelectedDate="{Binding CurrentProjectModel.EndDate}" />

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  ПРОИЗВОДСТВО  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Column="0"
                Grid.Row="1"
                Header="Производство"
                Margin="0,0,0,12">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Height="21"
                                Kind="Factory"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Width="21" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Производство"
                                VerticalAlignment="Center" />

                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  Заказ покупателя  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="ClipboardTextOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Заказ покупателя:" VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Grid.Row="0"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.OrderCustomer}" />


                    <!--  Заявка  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="FileDocumentOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Заявка на производство:" VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Grid.Row="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.RequestProduction}" />


                    <!--  Количество  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="Counter"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Кол-во стендов (шт.):" VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Grid.Row="2"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.StandCount}" />


                    <!--  Стоимость  -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="CashMultiple"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Стоимость (руб.):" VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Grid.Row="3"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.Cost}" />


                    <!--  Трудозатраты  -->
                    <StackPanel
                        Grid.Row="4"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="ClockOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Трудозатраты (чел/час):" VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Grid.Row="4"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.HumanCost}" />


                    <!--  Оцинкование  -->
                    <CheckBox
                        Content="Оцинкование стендов"
                        Grid.ColumnSpan="2"
                        Grid.Row="5"
                        IsChecked="{Binding CurrentProjectModel.IsGalvanized}"
                        Margin="5" />

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  УПРАВЛЕНИЕ  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Column="2"
                Grid.Row="1"
                Header="Управление"
                Margin="0,0,0,12">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Height="21"
                                Kind="AccountGroupOutline"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Width="21" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Управление"
                                VerticalAlignment="Center" />

                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  Статус  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="FlagOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Статус:" VerticalAlignment="Center" />

                    </StackPanel>

                    <ComboBox
                        Grid.Column="1"
                        Grid.Row="0"
                        ItemsSource="{Binding CurrentProjectModel.Statuses}"
                        Margin="5"
                        SelectedItem="{Binding CurrentProjectModel.Status}" />


                    <!--  Руководитель  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Height="18"
                            Kind="AccountOutline"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Width="18" />

                        <TextBlock Text="Руководитель:" VerticalAlignment="Center" />

                    </StackPanel>

                    <TextBox
                        Grid.Column="1"
                        Grid.Row="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.Manager}" />

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  МАРКИРОВКА  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="2"
                Header="Маркировка"
                Margin="0,0,0,12">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Height="21"
                                Kind="TagOutline"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Width="21" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Text="Маркировка"
                                VerticalAlignment="Center" />

                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <TextBlock
                        Grid.Column="0"
                        Margin="5"
                        Text="Маркировка +:"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.MarkPlus}" />


                    <TextBlock
                        Grid.Column="3"
                        Margin="5"
                        Text="Маркировка -:"
                        VerticalAlignment="Center" />

                    <TextBox
                        Grid.Column="4"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.MarkMinus}" />

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  НИЖНЯЯ ПАНЕЛЬ  -->
            <!--  =========================================================  -->

            <Grid
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Grid.Row="3"
                Margin="0,0,0,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <!--  Сводка  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="5,10,0,5"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <materialDesign:PackIcon
                        Height="18"
                        Kind="InformationOutline"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Width="18" />

                    <TextBlock
                        Opacity="0.65"
                        Text="Проект: "
                        VerticalAlignment="Center" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Margin="3,0,15,0"
                        Text="{Binding CurrentProjectModel.Description}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        Opacity="0.65"
                        Text="• "
                        VerticalAlignment="Center" />

                    <TextBlock
                        Margin="3,0,0,0"
                        Opacity="0.65"
                        Text="Стендов: "
                        VerticalAlignment="Center" />

                    <TextBlock
                        FontWeight="SemiBold"
                        Margin="3,0,0,0"
                        Text="{Binding CurrentProjectModel.StandCount}"
                        VerticalAlignment="Center" />

                </StackPanel>


                <!--  Кнопки  -->
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Margin="5,10,5,5"
                    Orientation="Horizontal">

                    <Button
                        Command="{Binding ProjectCommandProvider.CreateNewCardCommand}"
                        Content="Добавить новый"
                        Margin="0,0,10,0"
                        Width="150" />

                    <Button
                        Command="{Binding ProjectCommandProvider.SaveChangesCommand}"
                        Content="Сохранить изменения"
                        Width="200" />

                </StackPanel>

            </Grid>

        </Grid>

    </ScrollViewer>

</UserControl>