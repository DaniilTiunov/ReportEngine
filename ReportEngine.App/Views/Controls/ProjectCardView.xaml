<UserControl
    x:Class="ReportEngine.App.Views.Controls.ProjectCardView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    HorizontalContentAlignment="Stretch"
    FontSize="16"
    Style="{DynamicResource AnimatedUserControlStyle}">

    <ScrollViewer
        Margin="10"
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        HorizontalScrollBarVisibility="Disabled"
        VerticalScrollBarVisibility="Auto">

        <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>


            <!--  =========================================================  -->
            <!--  ОСНОВНАЯ ИНФОРМАЦИЯ  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Row="0"
                Grid.Column="0"
                Margin="0,0,0,12"
                Header="Основная информация">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="21"
                                Height="21"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Kind="InformationOutline" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Основная информация" />
                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  №  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Pound" />

                        <TextBlock VerticalAlignment="Center" Text="№ п/п:" />

                    </StackPanel>

                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.Number}" />


                    <!--  Обозначение  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="FileDocumentOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Обозначение КД:" />

                    </StackPanel>

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.Description}" />


                    <!--  Дата  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="CalendarOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Дата запроса:" />

                    </StackPanel>

                    <DatePicker
                        Grid.Row="2"
                        Grid.Column="1"
                        MaxWidth="180"
                        Margin="5"
                        HorizontalAlignment="Left"
                        SelectedDate="{Binding CurrentProjectModel.CreationDate}" />


                    <!--  Заказчик  -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="OfficeBuildingOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Заказчик:" />

                    </StackPanel>

                    <Grid Grid.Row="3" Grid.Column="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="5"
                            Text="{Binding CurrentProjectModel.Company}" />

                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Margin="5"
                            Command="{Binding ProjectCommandProvider.ShowCompanyDialogCommand}"
                            Content="..." />

                    </Grid>


                    <!--  Объект  -->
                    <StackPanel
                        Grid.Row="4"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="MapMarkerOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Объект:" />

                    </StackPanel>

                    <Grid Grid.Row="4" Grid.Column="1">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox
                            Grid.Column="0"
                            Margin="5"
                            Text="{Binding CurrentProjectModel.Object}" />

                        <Button
                            Grid.Column="1"
                            Width="32"
                            Height="32"
                            Margin="5"
                            Command="{Binding ProjectCommandProvider.ShowSubjectDialogCommand}"
                            Content="..." />

                    </Grid>

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  СРОКИ ПРОЕКТА  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Row="0"
                Grid.Column="2"
                Margin="0,0,0,12"
                Header="Сроки проекта">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="21"
                                Height="21"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Kind="CalendarClock" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Сроки проекта" />

                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  Старт  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="ClockOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Старт проекта:" />

                    </StackPanel>

                    <DatePicker
                        Grid.Row="0"
                        Grid.Column="1"
                        MaxWidth="180"
                        Margin="5"
                        HorizontalAlignment="Left"
                        SelectedDate="{Binding CurrentProjectModel.StartDate}" />


                    <!--  Выход из производства  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Factory" />

                        <TextBlock VerticalAlignment="Center" Text="Выход из производства:" />

                    </StackPanel>

                    <DatePicker
                        Grid.Row="1"
                        Grid.Column="1"
                        MaxWidth="180"
                        Margin="5"
                        HorizontalAlignment="Left"
                        SelectedDate="{Binding CurrentProjectModel.OutOfProduction}" />


                    <!--  Окончание договора  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="CalendarRemoveOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Дата окончания договора:" />

                    </StackPanel>

                    <DatePicker
                        Grid.Row="2"
                        Grid.Column="1"
                        MaxWidth="180"
                        Margin="5"
                        HorizontalAlignment="Left"
                        SelectedDate="{Binding CurrentProjectModel.EndDate}" />

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  ПРОИЗВОДСТВО  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Row="1"
                Grid.Column="0"
                Margin="0,0,0,12"
                Header="Производство">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="21"
                                Height="21"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Kind="Factory" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Производство" />

                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  Заказ покупателя  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="ClipboardTextOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Заказ покупателя:" />

                    </StackPanel>

                    <TextBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.OrderCustomer}" />


                    <!--  Заявка  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="FileDocumentOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Заявка на производство:" />

                    </StackPanel>

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.RequestProduction}" />


                    <!--  Количество  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="Counter" />

                        <TextBlock VerticalAlignment="Center" Text="Кол-во стендов (шт.):" />

                    </StackPanel>

                    <TextBox
                        Grid.Row="2"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.StandCount}" />


                    <!--  Стоимость  -->
                    <StackPanel
                        Grid.Row="3"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="CashMultiple" />

                        <TextBlock VerticalAlignment="Center" Text="Стоимость (руб.):" />

                    </StackPanel>

                    <TextBox
                        Grid.Row="3"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.Cost}" />


                    <!--  Трудозатраты  -->
                    <StackPanel
                        Grid.Row="4"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="ClockOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Трудозатраты (чел/час):" />

                    </StackPanel>

                    <TextBox
                        Grid.Row="4"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.HumanCost}" />


                    <!--  Оцинкование  -->
                    <ui:ToggleSwitch
                        Grid.Row="5"
                        Grid.ColumnSpan="2"
                        Margin="5"
                        Content="Оцинкование стендов"
                        IsChecked="{Binding CurrentProjectModel.IsGalvanized}"
                        Style="{DynamicResource FluentToggleSwitchStyle}" />

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  УПРАВЛЕНИЕ  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Row="1"
                Grid.Column="2"
                Margin="0,0,0,12"
                Header="Управление">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="21"
                                Height="21"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Kind="AccountGroupOutline" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Управление" />

                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>


                    <!--  Статус  -->
                    <StackPanel
                        Grid.Row="0"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="FlagOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Статус:" />

                    </StackPanel>

                    <ComboBox
                        Grid.Row="0"
                        Grid.Column="1"
                        Margin="5"
                        ItemsSource="{Binding CurrentProjectModel.Statuses}"
                        SelectedItem="{Binding CurrentProjectModel.Status}" />


                    <!--  Руководитель  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="5"
                        Orientation="Horizontal">

                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Kind="AccountOutline" />

                        <TextBlock VerticalAlignment="Center" Text="Руководитель:" />

                    </StackPanel>

                    <TextBox
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.Manager}" />

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  МАРКИРОВКА  -->
            <!--  =========================================================  -->

            <GroupBox
                Grid.Row="2"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,12"
                Header="Маркировка">

                <GroupBox.HeaderTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">

                            <materialDesign:PackIcon
                                Width="21"
                                Height="21"
                                Margin="0,0,9,0"
                                VerticalAlignment="Center"
                                Kind="TagOutline" />

                            <TextBlock
                                VerticalAlignment="Center"
                                FontWeight="SemiBold"
                                Text="Маркировка" />

                        </StackPanel>
                    </DataTemplate>
                </GroupBox.HeaderTemplate>

                <Grid Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="30" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>


                    <TextBlock
                        Grid.Column="0"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Маркировка +:" />

                    <TextBox
                        Grid.Column="1"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.MarkPlus}" />


                    <TextBlock
                        Grid.Column="3"
                        Margin="5"
                        VerticalAlignment="Center"
                        Text="Маркировка -:" />

                    <TextBox
                        Grid.Column="4"
                        Margin="5"
                        Text="{Binding CurrentProjectModel.MarkMinus}" />

                </Grid>

            </GroupBox>


            <!--  =========================================================  -->
            <!--  НИЖНЯЯ ПАНЕЛЬ  -->
            <!--  =========================================================  -->

            <Grid
                Grid.Row="3"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                Margin="0,0,0,5">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>


                <!--  Сводка  -->
                <StackPanel
                    Grid.Column="0"
                    Margin="5,10,0,5"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">

                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Kind="InformationOutline" />

                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.65"
                        Text="Проект: " />

                    <TextBlock
                        Margin="3,0,15,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding CurrentProjectModel.Description}" />

                    <TextBlock
                        VerticalAlignment="Center"
                        Opacity="0.65"
                        Text="• " />

                    <TextBlock
                        Margin="3,0,0,0"
                        VerticalAlignment="Center"
                        Opacity="0.65"
                        Text="Стендов: " />

                    <TextBlock
                        Margin="3,0,0,0"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Text="{Binding CurrentProjectModel.StandCount}" />

                </StackPanel>


                <!--  Кнопки  -->
                <StackPanel
                    Grid.Column="1"
                    Margin="5,10,5,5"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">

                    <Button
                        Width="150"
                        Margin="0,0,10,0"
                        Command="{Binding ProjectCommandProvider.CreateNewCardCommand}"
                        Content="Добавить новый" />

                    <Button
                        Width="200"
                        Command="{Binding ProjectCommandProvider.SaveChangesCommand}"
                        Content="Сохранить изменения" />

                </StackPanel>

            </Grid>

        </Grid>

    </ScrollViewer>

</UserControl>
