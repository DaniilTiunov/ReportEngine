<UserControl
    x:Class="ReportEngine.App.Views.Controls.TreeProjectView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Style="{DynamicResource AnimatedUserControlStyle}"
    mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>
            <converters:RectConverter x:Key="WorkspaceRectConverter" />
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12" Background="{DynamicResource PrimaryColor}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border
            x:Name="NavigationPanel"
            Grid.Column="0"
            Style="{DynamicResource ProjectNavigationPanelStyle}">
            <Grid x:Name="NavigationPanelContent">
                <Grid.Clip>
                    <RectangleGeometry RadiusX="10" RadiusY="10">
                        <RectangleGeometry.Rect>
                            <MultiBinding Converter="{StaticResource WorkspaceRectConverter}">
                                <Binding ElementName="NavigationPanelContent" Path="ActualWidth" />
                                <Binding ElementName="NavigationPanelContent" Path="ActualHeight" />
                            </MultiBinding>
                        </RectangleGeometry.Rect>
                    </RectangleGeometry>
                </Grid.Clip>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{DynamicResource ProjectNavigationHeaderStyle}">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,10,0"
                            Foreground="{DynamicResource AccentColor}"
                            Symbol="Navigation24" />
                        <StackPanel>
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Text="Навигация по проекту" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource SecondaryForeground}"
                                Text="Двойной щелчок открывает раздел" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Дерево разделов проекта  -->
                <TreeView
                    x:Name="NavigationTree"
                    Grid.Row="1"
                    Padding="8"
                    FontSize="15">
                    <!--  ПРОЕКТ  -->
                    <TreeViewItem IsExpanded="True">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource PrimaryForeground}"
                                    Symbol="Folder24" />
                                <TextBlock VerticalAlignment="Center" Text="Проект" />
                            </StackPanel>
                        </TreeViewItem.Header>

                        <!--  Карточка проекта  -->
                        <TreeViewItem MouseDoubleClick="OpenCurrentView" Tag="ProjectCard">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="CardUi24" />
                                    <TextBlock VerticalAlignment="Center" Text="Карточка проекта" />
                                </StackPanel>
                            </TreeViewItem.Header>
                        </TreeViewItem>

                        <!--  Редактирование стенда  -->
                        <TreeViewItem IsExpanded="True">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="Edit24" />
                                    <TextBlock VerticalAlignment="Center" Text="Редактирование стенда" />
                                </StackPanel>
                            </TreeViewItem.Header>

                            <!--  Расчёт стенда  -->
                            <TreeViewItem MouseDoubleClick="OpenCurrentView" Tag="ProjectPreview">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            Foreground="{DynamicResource PrimaryForeground}"
                                            Symbol="Calculator24" />
                                        <TextBlock VerticalAlignment="Center" Text="Расчёт стенда" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>

                            <!--  Формирование упаковки  -->
                            <TreeViewItem MouseDoubleClick="OpenCurrentView" Tag="StandsContainer">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            Foreground="{DynamicResource PrimaryForeground}"
                                            Symbol="Box24" />
                                        <TextBlock VerticalAlignment="Center" Text="Формирование упаковки" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>

                            <!--  Предпросмотр документов  -->
                            <TreeViewItem MouseDoubleClick="OpenCurrentView" Tag="DockViewer">
                                <TreeViewItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            Foreground="{DynamicResource PrimaryForeground}"
                                            Symbol="Document24" />
                                        <TextBlock VerticalAlignment="Center" Text="Просмотр документов" />
                                    </StackPanel>
                                </TreeViewItem.Header>
                            </TreeViewItem>
                        </TreeViewItem>
                    </TreeViewItem>

                    <!--  РАСЧЁТ ПРОЕКТА  -->
                    <TreeViewItem IsExpanded="True">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource PrimaryForeground}"
                                    Symbol="Calculator24" />
                                <TextBlock VerticalAlignment="Center" Text="Расчёт проекта" />
                            </StackPanel>
                        </TreeViewItem.Header>

                        <TreeViewItem Tag="CalculateProject">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="Play24" />
                                    <TextBlock VerticalAlignment="Center" Text="Рассчитать проект" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CalculateProjectCommandAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="CalculateProject">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="ArrowSync24" />
                                    <TextBlock VerticalAlignment="Center" Text="Пересчёт" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding RecalculateProjectCommandAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>
                    </TreeViewItem>

                    <!--  ОТЧЁТЫ  -->
                    <TreeViewItem IsExpanded="True">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource PrimaryForeground}"
                                    Symbol="DocumentMultiple24" />
                                <TextBlock VerticalAlignment="Center" Text="Отчёты" />
                            </StackPanel>
                        </TreeViewItem.Header>

                        <TreeViewItem Tag="SummaryReport">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="DocumentTable24" />
                                    <TextBlock VerticalAlignment="Center" Text="Сводная ведомость" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateSummaryReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="ComponentsList">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="TextBulletList24" />
                                    <TextBlock VerticalAlignment="Center" Text="Ведомость комплектующих" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateComponentsListReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="NamePlates">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="Tag24" />
                                    <TextBlock VerticalAlignment="Center" Text="Шильдики и таблички" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateNamePlatesReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="MarksReport">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="TagEdit24" />
                                    <TextBlock VerticalAlignment="Center" Text="Маркировка" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateMarksReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="ProductionList">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="BuildingFactory24" />
                                    <TextBlock VerticalAlignment="Center" Text="Производство" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateProductionListReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="FinPlan">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="Money24" />
                                    <TextBlock VerticalAlignment="Center" Text="Фин. план" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateFinPlanReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="ContainersReport">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="Box24" />
                                    <TextBlock VerticalAlignment="Center" Text="Отчёт тара" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateContainersReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="Passport">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="DocumentPerson20" />
                                    <TextBlock VerticalAlignment="Center" Text="Паспорт" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreatePassportReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>

                        <TreeViewItem Tag="TechCards">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="ClipboardTask24" />
                                    <TextBlock VerticalAlignment="Center" Text="Технологические карты" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateTechCardsReportAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>
                    </TreeViewItem>

                    <!--  1C  -->
                    <TreeViewItem IsExpanded="True">
                        <TreeViewItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    Foreground="{DynamicResource PrimaryForeground}"
                                    Symbol="Database24" />
                                <TextBlock VerticalAlignment="Center" Text="1C" />
                            </StackPanel>
                        </TreeViewItem.Header>

                        <TreeViewItem Tag="SummaryReport">
                            <TreeViewItem.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        Foreground="{DynamicResource PrimaryForeground}"
                                        Symbol="DocumentTable24" />
                                    <TextBlock VerticalAlignment="Center" Text="Сводная ведомость (1C)" />
                                </StackPanel>
                            </TreeViewItem.Header>
                            <TreeViewItem.InputBindings>
                                <MouseBinding Command="{Binding CreateFlatSummaryReportCommandAsync}" Gesture="LeftDoubleClick" />
                            </TreeViewItem.InputBindings>
                        </TreeViewItem>
                    </TreeViewItem>
                </TreeView>
            </Grid>
        </Border>

        <Border
            x:Name="TabPanel"
            Grid.Column="2"
            Style="{DynamicResource ProjectTabPanelStyle}">
            <TabControl
                x:Name="MainTabControl"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Stretch">
                <TabControl.Clip>
                    <RectangleGeometry RadiusX="11" RadiusY="11">
                        <RectangleGeometry.Rect>
                            <MultiBinding Converter="{StaticResource WorkspaceRectConverter}">
                                <Binding ElementName="MainTabControl" Path="ActualWidth" />
                                <Binding ElementName="MainTabControl" Path="ActualHeight" />
                            </MultiBinding>
                        </RectangleGeometry.Rect>
                    </RectangleGeometry>
                </TabControl.Clip>
                <TabControl.Resources>
                    <Style BasedOn="{StaticResource {x:Type TabItem}}" TargetType="TabItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="VerticalContentAlignment" Value="Stretch" />
                    </Style>
                </TabControl.Resources>
            </TabControl>
        </Border>
    </Grid>
</UserControl>
