<UserControl
    d:DesignHeight="800"
    d:DesignWidth="1200"
    mc:Ignorable="d"
    x:Class="ReportEngine.App.Views.Controls.StandsContainerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Верхняя панель с кнопками  -->
        <Border
            BorderBrush="Gray"
            BorderThickness="1"
            Grid.Row="0"
            Margin="0,0,0,10"
            Padding="10">
            <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                <Button
                    Command="{Binding CreateBatchCommand}"
                    Content="➕ Создать партию"
                    Margin="2" />
                <Button
                    Command="{Binding RefreshBatchesCommand}"
                    Content="🔄 Обновить"
                    Margin="2" />
                <Separator Margin="5,0" Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" />
                <CheckBox
                    Content="Только свободные"
                    IsChecked="{Binding ShowOnlyFreeStands}"
                    Margin="10,0"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!--  Основная область  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Левая панель: Список партий  -->
            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                Grid.Column="0"
                Margin="0,0,5,0"
                Padding="10">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8"
                        Text="📦 Партии" />

                    <StackPanel
                        DockPanel.Dock="Bottom"
                        Margin="0,5,0,0"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding CreateBatchCommand}"
                            Content="➕ Создать"
                            Margin="2" />
                        <Button
                            Command="{Binding RemoveSelectedBatchCommand}"
                            Content="🗑 Удалить"
                            Margin="2" />
                        <Button
                            Command="{Binding EditBatchCommand}"
                            Content="✏ Редактировать"
                            Margin="2" />
                    </StackPanel>

                    <ListBox
                        ItemsSource="{Binding AllProjectBatches}"
                        Margin="0,5,0,0"
                        SelectedItem="{Binding SelectedBatch}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            FontWeight="Bold"
                                            Grid.Column="0"
                                            Margin="0,0,10,0"
                                            Text="{Binding BatchOrder}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{Binding Name}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Margin="0,0,5,0" Text="{Binding ContainersCount}" />
                                            <TextBlock Text="📦" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal">
                                            <TextBlock Margin="10,0,0,0" Text="{Binding StandsCount}" />
                                            <TextBlock Text=" Стенды" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!--  Центральная панель: Контейнеры выбранной партии  -->
            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                Grid.Column="1"
                Margin="5,0,5,0"
                Padding="10">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8">
                        <Run Text="📋 Контейнеры" />
                        <Run Text="{Binding SelectedBatch.Name, StringFormat=' ({0})'}" />
                    </TextBlock>

                    <StackPanel
                        DockPanel.Dock="Bottom"
                        Margin="0,5,0,0"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding AddContainerToBatchCommand}"
                            Content="➕ Добавить"
                            Margin="2" />
                        <Button
                            Command="{Binding RemoveContainerFromBatchCommand}"
                            Content="🗑 Удалить"
                            Margin="2" />
                        <Button
                            Command="{Binding EditContainerCommand}"
                            Content="✏ Редактировать"
                            Margin="2" />
                    </StackPanel>

                    <ListBox
                        ItemsSource="{Binding SelectedBatch.Containers}"
                        Margin="0,5,0,0"
                        SelectedItem="{Binding SelectedStandContainer}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,2" Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Name}" />

                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="10,0,2,0"
                                            Text="Стендов:" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Margin="0,0,10,0"
                                            Text="{Binding StandsCount}" />

                                        <TextBlock
                                            Grid.Column="3"
                                            Margin="10,0,2,0"
                                            Text="Вес стендов:" />
                                        <TextBlock
                                            Grid.Column="4"
                                            Margin="0,0,10,0"
                                            Text="{Binding StandsWeight}" />

                                        <TextBlock Grid.Column="5" Text="кг" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!--  Правая панель: Стенды  -->
            <Border
                BorderBrush="Gray"
                BorderThickness="1"
                Grid.Column="2"
                Margin="5,0,0,0"
                Padding="10">
                <DockPanel>
                    <TextBlock
                        DockPanel.Dock="Top"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Margin="0,0,0,8">
                        <Run Text="📐 Стенды" />
                        <Run Text="{Binding SelectedContainer.Name, StringFormat=' ({0})'}" />
                    </TextBlock>

                    <!--  Панель управления стендами  -->
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,5,0,0">
                        <Border Margin="0,0,0,5" Padding="5">
                            <TextBlock FontSize="11" Text="Выберите стенд для добавления/удаления" />
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Button
                                    Command="{Binding AddStandToContainerCommand}"
                                    Content="← Добавить"
                                    Margin="2" />
                                <Button
                                    Command="{Binding RemoveContainerFromBatchCommand}"
                                    Content="Удалить →"
                                    Margin="2" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button
                                    Command="{Binding MoveStandUpCommand}"
                                    Content="↑"
                                    Margin="2" />
                                <Button
                                    Command="{Binding MoveStandDownCommand}"
                                    Content="↓"
                                    Margin="2" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>

                    <TabControl Margin="0,5,0,0">
                        <TabItem Header="В контейнере">
                            <ListBox ItemsSource="{Binding StandsInContainer}" SelectedItem="{Binding SelectedStand}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,1" Padding="8,4">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    FontWeight="Bold"
                                                    Grid.Column="0"
                                                    Text="{Binding KKSCode}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{Binding SerialNumber}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>

                        <TabItem Header="Доступные">
                            <DockPanel>
                                <TextBlock
                                    DockPanel.Dock="Top"
                                    FontSize="11"
                                    Margin="0,0,0,5">
                                    Всего:<Run Text="{Binding FilteredAvailableStands.Count}" />
                                    стендов</TextBlock>

                                <TextBox
                                    DockPanel.Dock="Top"
                                    Margin="0,0,0,5"
                                    Padding="5"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                                <ListBox ItemsSource="{Binding FilteredAvailableStands}" SelectedItem="{Binding SelectedAvailableStand}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Margin="0,1" Padding="8,4">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="80" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        FontWeight="Bold"
                                                        Grid.Column="0"
                                                        Text="{Binding KKSCode}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Text="{Binding SerialNumber}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>