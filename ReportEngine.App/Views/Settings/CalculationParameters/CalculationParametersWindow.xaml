<mah:MetroWindow
    Background="{DynamicResource PrimaryColor}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="900"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="True"
    Title="Настройки параметров расчета"
    TitleForeground="{DynamicResource PrimaryForeground}"
    Width="1300"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="ReportEngine.App.Views.Settings.CalculationParameters.CalculationParametersWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Border Style="{DynamicResource WindowBorder}">
        <DockPanel>

            <Grid Background="{DynamicResource PrimaryColor}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Левая панель  -->
                <Border
                    Background="{DynamicResource PrimaryColor}"
                    BorderBrush="{DynamicResource BorderLightColor}"
                    BorderThickness="0,0,1,0"
                    Grid.Column="0"
                    Margin="5"
                    Padding="10">

                    <ListBox
                        Background="{DynamicResource PrimaryColor}"
                        BorderThickness="0"
                        Foreground="{DynamicResource PrimaryForeground}"
                        ItemsSource="{Binding SettingsItems}"
                        Margin="5"
                        SelectedItem="{Binding SelectedSetting}">

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border
                                    CornerRadius="6"
                                    Margin="0,4"
                                    Padding="12">
                                    <TextBlock FontSize="15" Text="{Binding}" />
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>

                    </ListBox>
                </Border>

                <!--  Правая часть  -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Background="{DynamicResource PrimaryColor}"
                        BorderBrush="{DynamicResource BorderLightColor}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Grid.Row="0"
                        Margin="20"
                        Padding="20">

                        <ContentControl Content="{Binding CurrentView}" />
                    </Border>

                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="0,0,20,20"
                        Orientation="Horizontal">

                        <Button
                            Command="{Binding UpdateAllParametersCommand}"
                            Content="Сохранить"
                            Height="36"
                            Margin="0,0,10,0"
                            Width="110" />

                        <Button
                            Click="CloseButton_Click"
                            Content="Отмена"
                            Height="36"
                            Width="110" />
                    </StackPanel>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</mah:MetroWindow>