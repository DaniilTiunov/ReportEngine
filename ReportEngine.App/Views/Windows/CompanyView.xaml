<mah:MetroWindow
    Background="{DynamicResource PrimaryColor}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="600"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="True"
    Title="Заказчики"
    TitleForeground="{DynamicResource PrimaryForeground}"
    Width="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.CompanyView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Border Style="{DynamicResource WindowBorder}">
        <DockPanel>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.Row="0"
                    HorizontalAlignment="Right"
                    Margin="0,0,30,0"
                    Text="Поиск:"
                    VerticalAlignment="Center" />

                <TextBox
                    Grid.Column="1"
                    Grid.Row="0"
                    Margin="0,0,0,0"
                    TextChanged="SearchTextBox_TextChanged"
                    VerticalAlignment="Center"
                    x:Name="SearchTextBox" />

                <DataGrid
                    CanUserAddRows="True"
                    CanUserDeleteRows="True"
                    CanUserReorderColumns="True"
                    CanUserSortColumns="True"
                    Grid.ColumnSpan="4"
                    Grid.Row="1"
                    Margin="10,14,5,75"
                    MouseDoubleClick="CompaniesDataGrid_MouseDoubleClick"
                    RowHeaderWidth="40"
                    SelectedItem="{Binding CurrentCompany.SelectedCompany, Mode=TwoWay}"
                    SelectionUnit="FullRow"
                    x:Name="CompaniesDataGrid">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding LoadAllCompaniesCommand}" Header="Показать всех" />
                            <Separator />
                            <MenuItem Command="{Binding SaveChangesCommand}" Header="Сохранить изменения" />
                            <MenuItem Command="{Binding AddNewCompanyCommand}" Header="Добавить" />
                            <Separator />
                            <MenuItem Command="{Binding DeleteCompanyCommand}" Header="Удалить" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding Number, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Номер"
                            Width="90" />
                        <DataGridTextColumn
                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Название организации"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding RegisterDate, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Дата регистрации"
                            Width="150" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>
    </Border>
</mah:MetroWindow>