<Window
    Background="{DynamicResource PrimaryColor}"
    FontFamily="Bahnschrift"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="450"
    Title="Просмотр всего сортамента"
    Width="1100"
    WindowStyle="None"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.AllSortamentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource WindowBorder}">
        <DockPanel>
            <Border
                Background="#2D2D30"
                DockPanel.Dock="Top"
                Height="34"
                MouseLeftButtonDown="Window_MouseLeftButtonDown"
                x:Name="FormedFrameWindowTitle">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Margin="10,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Image
                            Height="18"
                            Margin="0,0,8,0"
                            Source="/Resources/Icons/estimate_cost_icon_213382.ico"
                            Width="18" />
                        <TextBlock
                            FontSize="14"
                            Foreground="White"
                            Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            Click="MinimizeButton_Click"
                            FontSize="16"
                            Height="30"
                            ToolTip="Свернуть"
                            Width="40"
                            x:Name="MinimizeButton">
                            ─
                        </Button>
                        <Button
                            Click="MaxRestoreButton_Click"
                            FontSize="16"
                            Height="30"
                            Margin="10,0,0,0"
                            ToolTip="Развернуть"
                            Width="40"
                            x:Name="MaxRestoreButton">
                            ▢
                        </Button>
                        <Button
                            Click="CloseButton_Click"
                            FontSize="16"
                            Height="30"
                            Margin="10,0,10,0"
                            ToolTip="Закрыть"
                            Width="40"
                            x:Name="CloseButton">
                            ✕
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TabControl Grid.Row="0" x:Name="MainTabControl">
                    <TabItem Header="Трубы">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged" x:Name="SubTab">
                            <TabItem Header="Жаропрочные" Tag="Трубы\Жаропрочные" />
                            <TabItem Header="Нержавеющие" Tag="Трубы\Нержавеющие" />
                            <TabItem Header="Углеродистые" Tag="Трубы\Углеродистые" />
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Арматуры">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                            <TabItem Header="Жаропрочные" Tag="Арматуры\Жаропрочные" />
                            <TabItem Header="Нержавеющие" Tag="Арматуры\Нержавеющие" />
                            <TabItem Header="Углеродистые" Tag="Арматуры\Углеродистые" />
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Тройники и КМЧ">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                            <TabItem Header="Жаропрочные" Tag="Тройники и КМЧ\Жаропрочные" />
                            <TabItem Header="Нержавеющие" Tag="Тройники и КМЧ\Нержавеющие" />
                            <TabItem Header="Углеродистые" Tag="Тройники и КМЧ\Углеродистые" />
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Дренаж">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                            <TabItem Header="Дренажи и крепления" Tag="Дренажи и крепления" />
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Рамные комплектующие">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                            <TabItem Header="Детали рамы" Tag="Детали рамы" />
                            <TabItem Header="Комплектующие для стойки" Tag="Комплектующие для стойки" />
                            <TabItem Header="Прокат" Tag="Прокат" />
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Кронштейны">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                            <TabItem Header="Крепление датчиков" Tag="Крепление датчиков" />
                            <TabItem Header="Крепление дренажа" Tag="Крепление дренажа" />
                            <TabItem Header="Крепление клеммных коробок" Tag="Крепление клеммных коробок" />
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Электрические компоненты">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                            <TabItem Header="Кабельная продукция" Tag="Кабельная продукция" />
                            <TabItem Header="Кабельные вводы" Tag="Кабельные вводы" />
                            <TabItem Header="Клеммные коробки" Tag="Клеммные коробки" />
                            <TabItem Header="Обогрев" Tag="Обогрев" />
                            <TabItem Header="Средства прокладки и защиты кабеля" Tag="Средства прокладки" />
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Прочие">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged" x:Name="OtherTab">
                            <TabItem Header="Прочие" Tag="Прочие" />
                        </TabControl>
                    </TabItem>

                    <TabItem Header="Тара">
                        <TabControl SelectionChanged="SubTabControl_SelectionChanged" x:Name="ConTab">
                            <TabItem Header="Тара" Tag="Тара" />
                        </TabControl>
                    </TabItem>
                </TabControl>

                <TextBox
                    FontFamily="Bahnschrift"
                    FontSize="16"
                    Grid.Row="1"
                    HorizontalAlignment="Left"
                    Margin="72,9,0,10"
                    TextChanged="SearchTextBox_TextChanged"
                    Width="436"
                    x:Name="SearchTextBox" />

                <TextBlock
                    FontFamily="Bahnschrift"
                    FontSize="16"
                    Grid.Row="1"
                    Margin="10,9,1042,10"
                    Text="Поиск:" />

                <DataGrid
                    AutoGenerateColumns="False"
                    FontFamily="Bahnschrift"
                    Grid.Row="2"
                    Margin="5"
                    MouseDoubleClick="SelectEquip_DoubleClick"
                    SelectedItem="{Binding SelectedEquip, Mode=TwoWay}"
                    x:Name="EquipDataGrid" />
            </Grid>
        </DockPanel>
    </Border>
</Window>