<mah:MetroWindow
    x:Class="ReportEngine.App.Views.Windows.AllSortamentsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    Title="Просмотр всего сортамента"
    Width="1380"
    Height="820"
    MinWidth="1100"
    MinHeight="700"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    Background="{DynamicResource PrimaryColor}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="False"
    TitleForeground="{DynamicResource PrimaryForeground}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <mah:MetroWindow.Resources>
        <converters:BoolToVisibility x:Key="BoolToVisibility" />
        <Style x:Key="FormLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,7,0,4" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryForeground}" />
        </Style>
        <Style
            x:Key="FormTextBoxStyle"
            BasedOn="{StaticResource {x:Type TextBox}}"
            TargetType="TextBox">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </mah:MetroWindow.Resources>

    <DockPanel Background="{DynamicResource PrimaryColor}">
        <Separator DockPanel.Dock="Top" Style="{DynamicResource WindowTitleSeparatorStyle}" />
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Padding="16,12"
                Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Width="30"
                        Height="30"
                        Margin="0,0,12,0"
                        Foreground="{DynamicResource AccentColor}"
                        Symbol="Database24" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Text="Каталог сортамента" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Foreground="{DynamicResource SecondaryForeground}"
                            Text="Просматривайте, редактируйте и добавляйте позиции по выбранной категории." />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="370" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Padding="14"
                    Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TabControl x:Name="MainTabControl" Grid.Row="0">
                            <TabItem Header="Трубы">
                                <TabControl x:Name="SubTab" SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Жаропрочные" Tag="Трубы\Жаропрочные" />
                                    <TabItem Header="Нержавеющие" Tag="Трубы\Нержавеющие" />
                                    <TabItem Header="Углеродистые" Tag="Трубы\Углеродистые" />
                                </TabControl>
                            </TabItem>
                            <TabItem Header="Арматуры">
                                <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Жаропрочные" Tag="Арматуры\Жаропрочные" />
                                    <TabItem Header="Нержавеющие" Tag="Арматуры\Нержавеющие" />
                                    <TabItem Header="Углеродистые" Tag="Арматуры\Углеродистые" />
                                </TabControl>
                            </TabItem>
                            <TabItem Header="Тройники и КМЧ">
                                <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Жаропрочные" Tag="Тройники и КМЧ\Жаропрочные" />
                                    <TabItem Header="Нержавеющие" Tag="Тройники и КМЧ\Нержавеющие" />
                                    <TabItem Header="Углеродистые" Tag="Тройники и КМЧ\Углеродистые" />
                                </TabControl>
                            </TabItem>
                            <TabItem Header="Дренаж">
                                <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Дренажи и крепления" Tag="Дренажи и крепления" />
                                </TabControl>
                            </TabItem>
                            <TabItem Header="Рамные комплектующие">
                                <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Детали рамы" Tag="Детали рамы" />
                                    <TabItem Header="Комплектующие для стойки" Tag="Комплектующие для стойки" />
                                    <TabItem Header="Прокат" Tag="Прокат" />
                                </TabControl>
                            </TabItem>
                            <TabItem Header="Кронштейны">
                                <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Крепление датчиков" Tag="Крепление датчиков" />
                                    <TabItem Header="Крепление дренажа" Tag="Крепление дренажа" />
                                    <TabItem Header="Крепление клеммных коробок" Tag="Крепление клеммных коробок" />
                                </TabControl>
                            </TabItem>
                            <TabItem Header="Электрические компоненты">
                                <TabControl SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Кабельная продукция" Tag="Кабельная продукция" />
                                    <TabItem Header="Кабельные вводы" Tag="Кабельные вводы" />
                                    <TabItem Header="Клеммные коробки" Tag="Клеммные коробки" />
                                    <TabItem Header="Обогрев" Tag="Обогрев" />
                                    <TabItem Header="Средства прокладки и защиты кабеля" Tag="Средства прокладки" />
                                </TabControl>
                            </TabItem>
                            <TabItem Header="Прочие">
                                <TabControl x:Name="OtherTab" SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Прочие" Tag="Прочие" />
                                </TabControl>
                            </TabItem>
                            <TabItem Header="Тара">
                                <TabControl x:Name="ConTab" SelectionChanged="SubTabControl_SelectionChanged">
                                    <TabItem Header="Тара" Tag="Тара" />
                                </TabControl>
                            </TabItem>
                        </TabControl>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Width="20"
                                    Height="20"
                                    Margin="2,0,8,0"
                                    Foreground="{DynamicResource SecondaryForeground}"
                                    Symbol="Search20" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="Поиск по наименованию" />
                            </StackPanel>
                            <TextBox
                                x:Name="SearchTextBox"
                                Grid.Column="1"
                                Height="36"
                                Margin="18,0,0,0"
                                Padding="12,0"
                                VerticalContentAlignment="Center"
                                FontSize="14"
                                TextChanged="SearchTextBox_TextChanged" />
                        </Grid>

                        <Border
                            Grid.Row="4"
                            Background="{DynamicResource PrimaryColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <DataGrid
                                x:Name="EquipDataGrid"
                                Margin="1"
                                AutoGenerateColumns="False"
                                MouseDoubleClick="SelectEquip_DoubleClick"
                                SelectedItem="{Binding SelectedEquip, Mode=TwoWay}" />
                        </Border>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="2"
                    Padding="14"
                    Style="{StaticResource CardPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="8" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Width="24"
                                Height="24"
                                Margin="0,0,9,0"
                                Foreground="{DynamicResource AccentColor}"
                                Symbol="Add24" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Новая позиция" />
                                <TextBlock
                                    Margin="0,-5,0,0"
                                    Foreground="{DynamicResource SecondaryForeground}"
                                    Text="Поля зависят от выбранной категории."
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="2,2,8,4">
                                <TextBlock Style="{StaticResource FormLabelStyle}" Text="Название" />
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.Name}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Вес, кг" />
                                        <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.Weight}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource FormLabelStyle}" Text="Дни экспорта" />
                                        <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.ExportDays}" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock
                                    Style="{StaticResource FormLabelStyle}"
                                    Text="Единица измерения"
                                    Visibility="{Binding ShowMeasureComboBox, Converter={StaticResource BoolToVisibility}}" />
                                <ComboBox
                                    Height="34"
                                    Margin="0,0,0,5"
                                    Text="{Binding InputEquip.Measure}"
                                    Visibility="{Binding ShowMeasureComboBox, Converter={StaticResource BoolToVisibility}}">
                                    <ComboBoxItem Content="" />
                                    <ComboBoxItem Content="шт" />
                                    <ComboBoxItem Content="м" />
                                    <ComboBoxItem Content="кг" />
                                    <ComboBoxItem Content="т" />
                                    <ComboBoxItem Content="м²" />
                                    <ComboBoxItem Content="м³" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource FormLabelStyle}" Text="Стоимость, руб." />
                                <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.Cost}" />

                                <StackPanel Visibility="{Binding ShowElectricalFields, Converter={StaticResource BoolToVisibility}}">
                                    <Separator Margin="0,12,0,8" />
                                    <TextBlock Style="{StaticResource HeaderStyle}" Text="Электрические параметры" />
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Кабельный ввод" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.CabelInput}" />
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Кабель" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.Cabel}" />
                                    <TextBlock Style="{StaticResource FormLabelStyle}" Text="Электрозащита" />
                                    <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.ElectricProtection}" />
                                </StackPanel>

                                <StackPanel Visibility="{Binding ShowContainerFields, Converter={StaticResource BoolToVisibility}}">
                                    <Separator Margin="0,12,0,8" />
                                    <TextBlock Style="{StaticResource HeaderStyle}" Text="Габариты тары" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Ширина" />
                                            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.Width}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Высота" />
                                            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.Height}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Style="{StaticResource FormLabelStyle}" Text="Глубина" />
                                            <TextBox Style="{StaticResource FormTextBoxStyle}" Text="{Binding InputEquip.Depth}" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource SecondaryForeground}"
                                        Text="Размеры указываются в миллиметрах." />
                                </StackPanel>

                                <Button
                                    Width="Auto"
                                    Height="40"
                                    Margin="0,18,0,0"
                                    Command="{Binding AddAsyncCommand}"
                                    Content="Добавить позицию"
                                    FontSize="15"
                                    Style="{StaticResource ActionButtonStyle}" />
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
