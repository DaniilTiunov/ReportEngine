<Window
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Bahnschrift"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="800"
    MinHeight="700"
    MinWidth="1100"
    ResizeMode="CanResize"
    Title="Создание и редактирование рам"
    Width="1300"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.FormedFrameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="12"
            GlassFrameThickness="0"
            ResizeBorderThickness="6" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <converters:FrameComponentsCountConverter x:Key="FrameComponentsCountConverter" />

            <DropShadowEffect
                BlurRadius="30"
                Color="#000000"
                Opacity="0.2"
                ShadowDepth="0"
                x:Key="WindowShadow" />
        </ResourceDictionary>
    </Window.Resources>

    <Border
        ClipToBounds="True"
        CornerRadius="12"
        Effect="{StaticResource WindowShadow}">
        <Border
            Background="{DynamicResource PrimaryColor}"
            BorderBrush="{DynamicResource WindowBorderColor}"
            BorderThickness="1"
            CornerRadius="12">
            <DockPanel>
                <!--  Заголовок окна  -->
                <Border
                    Background="#2D2D30"
                    CornerRadius="12,12,0,0"
                    DockPanel.Dock="Top"
                    Height="40"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown"
                    x:Name="FormedFrameWindowTitle">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Margin="12,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Image
                                Height="18"
                                Margin="0,0,8,0"
                                Source="/Resources/Icons/estimate_cost_icon_213382.ico"
                                Width="18" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Button
                                Click="MinimizeButton_Click"
                                Height="30"
                                Margin="0,0,5,0"
                                Style="{StaticResource CloseButtonStyle}"
                                ToolTip="Свернуть"
                                Width="40"
                                x:Name="MinimizeButton">
                                ─
                            </Button>
                            <Button
                                Click="MaxRestoreButton_Click"
                                Height="30"
                                Margin="5,0"
                                Style="{StaticResource CloseButtonStyle}"
                                ToolTip="Развернуть"
                                Width="40"
                                x:Name="MaxRestoreButton">
                                ▢
                            </Button>
                            <Button
                                Click="CloseButton_Click"
                                Height="30"
                                Margin="5,0,10,0"
                                Style="{StaticResource CloseButtonStyle}"
                                ToolTip="Закрыть"
                                Width="40"
                                x:Name="CloseButton">
                                ✕
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Основное содержимое  -->
                <Grid Margin="12,12,12,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="0.75*" />
                    </Grid.ColumnDefinitions>

                    <!--  Левая часть: Список рам и параметры  -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Карточка: Список рам  -->
                        <Border
                            Grid.Row="0"
                            Margin="0,0,10,10"
                            Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource HeaderStyle}"
                                    Text="Список рам" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ScrollViewer
                                        Grid.Column="0"
                                        MaxHeight="300"
                                        VerticalScrollBarVisibility="Auto">
                                        <DataGrid
                                            AutoGenerateColumns="False"
                                            BeginningEdit="DataGrid_BeginningEdit"
                                            CanUserAddRows="False"
                                            ItemsSource="{Binding FormedFrameModel.AllFrames}"
                                            Margin="5"
                                            MinHeight="100"
                                            MouseDoubleClick="DataGrid_MouseDoubleClick"
                                            SelectedItem="{Binding FormedFrameModel.SelectedFrame}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn
                                                    Binding="{Binding Name}"
                                                    Header="Наименование"
                                                    Width="*" />
                                                <DataGridTextColumn
                                                    Binding="{Binding FrameType}"
                                                    Header="Тип"
                                                    Width="Auto" />
                                                <DataGridTextColumn
                                                    Binding="{Binding Width}"
                                                    Header="Ширина"
                                                    Width="Auto" />
                                                <DataGridTextColumn
                                                    Binding="{Binding Height}"
                                                    Header="Высота"
                                                    Width="Auto" />
                                                <DataGridTextColumn
                                                    Binding="{Binding Depth}"
                                                    Header="Глубина"
                                                    Width="Auto" />
                                                <DataGridTextColumn
                                                    Binding="{Binding Weight}"
                                                    Header="Масса"
                                                    Width="Auto" />
                                                <DataGridTextColumn
                                                    Binding="{Binding Designe}"
                                                    Header="Описание по КД"
                                                    Width="*" />
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </ScrollViewer>

                                    <Border
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Grid.Column="1"
                                        Margin="10,5,5,5"
                                        Style="{StaticResource CardPanelStyle}">
                                        <StackPanel>
                                            <TextBlock
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource AccentColor}"
                                                Margin="0,0,0,8"
                                                Text="Комплектующие рамы" />
                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                                <DataGrid
                                                    AutoGenerateColumns="False"
                                                    BeginningEdit="DataGrid_BeginningEdit"
                                                    CanUserAddRows="False"
                                                    IsReadOnly="False"
                                                    ItemsSource="{Binding FormedFrameModel.DisplayedComponents}"
                                                    Margin="5"
                                                    MinHeight="100"
                                                    MouseDoubleClick="DataGrid_MouseDoubleClick"
                                                    SelectedItem="{Binding FormedFrameModel.SelectedComponentInFrame}">
                                                    <DataGrid.Columns>
                                                        <DataGridTextColumn
                                                            Binding="{Binding Component.Name}"
                                                            Header="Наименование"
                                                            Width="*" />
                                                        <DataGridTextColumn
                                                            Binding="{Binding CostComponent, StringFormat={}{0:N2}}"
                                                            Header="Цена за ед."
                                                            Width="Auto" />
                                                        <DataGridTextColumn
                                                            Binding="{Binding Measure}"
                                                            Header="Ед. изм."
                                                            Width="Auto" />
                                                        <DataGridTemplateColumn Header="Кол-во" Width="Auto">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding Converter={StaticResource FrameComponentsCountConverter}}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBox Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40" />
                                                                        <TextBlock Margin="5,0" Text=" / " />
                                                                        <TextBox Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellEditingTemplate>
                                                        </DataGridTemplateColumn>
                                                        <DataGridTemplateColumn Header="Действия" Width="Auto">
                                                            <DataGridTemplateColumn.CellTemplate>
                                                                <DataTemplate>
                                                                    <Button
                                                                        Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}"
                                                                        Content="Удалить"
                                                                        FontSize="11"
                                                                        Height="24"
                                                                        Margin="2"
                                                                        Padding="8,2"
                                                                        Style="{StaticResource CancelButtonStyle}"
                                                                        Width="Auto" />
                                                                </DataTemplate>
                                                            </DataGridTemplateColumn.CellTemplate>
                                                        </DataGridTemplateColumn>
                                                    </DataGrid.Columns>
                                                </DataGrid>
                                            </ScrollViewer>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Карточка: Добавление новой рамы  -->
                        <Border
                            Grid.Row="1"
                            Margin="0,5,10,5"
                            Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource HeaderStyle}"
                                    Text="Добавление новой рамы" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="0"
                                        Margin="0,5"
                                        Text="Наименование:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.NewFrame.Name}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Margin="0,5"
                                        Text="Тип:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.NewFrame.FrameType}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="2"
                                        Margin="0,5"
                                        Text="Ширина:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.NewFrame.Width}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="3"
                                        Margin="0,5"
                                        Text="Высота:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="3"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.NewFrame.Height}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="4"
                                        Margin="0,5"
                                        Text="Глубина:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="4"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.NewFrame.Depth}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="5"
                                        Margin="0,5"
                                        Text="Масса:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="5"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.NewFrame.Weight}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="6"
                                        Margin="0,5"
                                        Text="Обозначение по КД:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="6"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.NewFrame.Designe}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Карточка: Редактирование рамы из списка  -->
                        <Border
                            Grid.Row="2"
                            Margin="0,5,10,5"
                            Style="{StaticResource CardPanelStyle}">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource HeaderStyle}"
                                    Text="Редактирование рамы из списка" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="0"
                                        Margin="0,5"
                                        Text="Наименование:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="0"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.SelectedFrame.Name}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="1"
                                        Margin="0,5"
                                        Text="Тип:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="1"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.SelectedFrame.FrameType}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="2"
                                        Margin="0,5"
                                        Text="Ширина:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="2"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.SelectedFrame.Width}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="3"
                                        Margin="0,5"
                                        Text="Высота:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="3"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.SelectedFrame.Height}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="4"
                                        Margin="0,5"
                                        Text="Глубина:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="4"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.SelectedFrame.Depth}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="5"
                                        Margin="0,5"
                                        Text="Масса:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="5"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.SelectedFrame.Weight}" />

                                    <TextBlock
                                        Grid.Column="0"
                                        Grid.Row="6"
                                        Margin="0,5"
                                        Text="Обозначение по КД:"
                                        VerticalAlignment="Center" />
                                    <TextBox
                                        Grid.Column="1"
                                        Grid.Row="6"
                                        Margin="0,5"
                                        Text="{Binding FormedFrameModel.SelectedFrame.Designe}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!--  Кнопки управления  -->
                        <StackPanel
                            Grid.Row="3"
                            HorizontalAlignment="Center"
                            Margin="0,10,10,0"
                            Orientation="Horizontal">
                            <Button
                                Command="{Binding AddNewFrameCommand}"
                                Content="Добавить новую"
                                Margin="5,0"
                                Style="{StaticResource ActionButtonStyle}"
                                Width="150" />
                            <Button
                                Command="{Binding SaveChangesCommand}"
                                Content="Сохранить изменения"
                                Margin="5,0"
                                Style="{StaticResource ActionButtonStyle}"
                                Width="180" />
                            <Button
                                Command="{Binding DeleteFrameCommand}"
                                Content="Удалить выбранную раму"
                                Margin="5,0"
                                Style="{StaticResource CancelButtonStyle}"
                                Width="200" />
                        </StackPanel>
                    </Grid>

                    <!--  Правая часть: Комплектующие  -->
                    <Grid Grid.Column="1" Margin="10,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border
                            Margin="0"
                            Padding="5"
                            Style="{StaticResource CardPanelStyle}">
                            <TabControl Margin="0,0,0,5" x:Name="ComponentsTabControl">
                                <TabItem Header="Детали рамы">
                                    <StackPanel Margin="0,5">
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <DataGrid
                                                AutoGenerateColumns="False"
                                                BeginningEdit="DataGrid_BeginningEdit"
                                                CanUserAddRows="False"
                                                ItemsSource="{Binding FormedFrameModel.FrameDetails}"
                                                Margin="0,5"
                                                MinHeight="100"
                                                MouseDoubleClick="DataGrid_MouseDoubleClick"
                                                SelectedItem="{Binding FormedFrameModel.SelectedComponentForAdd}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Binding="{Binding Name}"
                                                        Header="Наименование"
                                                        Width="*" />
                                                    <DataGridTextColumn
                                                        Binding="{Binding Cost}"
                                                        Header="Цена"
                                                        Width="Auto" />
                                                    <DataGridTextColumn
                                                        Binding="{Binding Measure}"
                                                        Header="Ед. изм."
                                                        Width="Auto" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ScrollViewer>
                                        <StackPanel Margin="5,5,0,5" Orientation="Horizontal">
                                            <TextBlock
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Margin="0,0,5,0"
                                                Text="Кол-во:"
                                                VerticalAlignment="Center" />
                                            <TextBox Text="{Binding FormedFrameModel.ComponentLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                        </StackPanel>
                                        <Button
                                            Command="{Binding AddDetailsCommand}"
                                            CommandParameter="FrameDetail"
                                            Content="Добавить комплектующую"
                                            Margin="5,5,5,10"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Комплектующие для стойки">
                                    <StackPanel Margin="0,5">
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <DataGrid
                                                AutoGenerateColumns="False"
                                                BeginningEdit="DataGrid_BeginningEdit"
                                                CanUserAddRows="False"
                                                ItemsSource="{Binding FormedFrameModel.PillarEqiups}"
                                                Margin="0,5"
                                                MinHeight="100"
                                                MouseDoubleClick="DataGrid_MouseDoubleClick"
                                                SelectedItem="{Binding FormedFrameModel.SelectedComponentForAdd}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Binding="{Binding Name}"
                                                        Header="Наименование"
                                                        Width="*" />
                                                    <DataGridTextColumn
                                                        Binding="{Binding Cost}"
                                                        Header="Цена"
                                                        Width="Auto" />
                                                    <DataGridTextColumn
                                                        Binding="{Binding Measure}"
                                                        Header="Ед. изм."
                                                        Width="Auto" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ScrollViewer>
                                        <StackPanel Margin="5,5,0,5" Orientation="Horizontal">
                                            <TextBlock
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Margin="0,0,5,0"
                                                Text="Кол-во:"
                                                VerticalAlignment="Center" />
                                            <TextBox Text="{Binding FormedFrameModel.ComponentLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                        </StackPanel>
                                        <Button
                                            Command="{Binding AddDetailsCommand}"
                                            CommandParameter="PillarEqiup"
                                            Content="Добавить комплектующую"
                                            Margin="5,5,5,10"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="Прокат">
                                    <StackPanel Margin="0,5">
                                        <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto">
                                            <DataGrid
                                                AutoGenerateColumns="False"
                                                BeginningEdit="DataGrid_BeginningEdit"
                                                CanUserAddRows="False"
                                                ItemsSource="{Binding FormedFrameModel.FrameRolls}"
                                                Margin="0,5"
                                                MinHeight="100"
                                                MouseDoubleClick="DataGrid_MouseDoubleClick"
                                                SelectedItem="{Binding FormedFrameModel.SelectedComponentForAdd}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn
                                                        Binding="{Binding Name}"
                                                        Header="Наименование"
                                                        Width="*" />
                                                    <DataGridTextColumn
                                                        Binding="{Binding Cost}"
                                                        Header="Цена"
                                                        Width="Auto" />
                                                    <DataGridTextColumn
                                                        Binding="{Binding Measure}"
                                                        Header="Ед. изм."
                                                        Width="Auto" />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                        </ScrollViewer>
                                        <StackPanel Margin="5,5,0,5" Orientation="Horizontal">
                                            <TextBlock
                                                Foreground="{DynamicResource PrimaryForeground}"
                                                Margin="0,0,5,0"
                                                Text="Кол-во:"
                                                VerticalAlignment="Center" />
                                            <TextBox Text="{Binding FormedFrameModel.ComponentLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="60" />
                                        </StackPanel>
                                        <Button
                                            Command="{Binding AddDetailsCommand}"
                                            CommandParameter="FrameRoll"
                                            Content="Добавить комплектующую"
                                            Margin="5,5,5,10"
                                            Style="{StaticResource ActionButtonStyle}" />
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </Border>
                    </Grid>
                </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>