<mah:MetroWindow
    x:Class="ReportEngine.App.Views.Windows.FormedFrameView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    Title="Создание и редактирование рам"
    Width="1380"
    Height="820"
    MinWidth="1100"
    MinHeight="700"
    Background="{DynamicResource PrimaryColor}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="False"
    TitleForeground="{DynamicResource PrimaryForeground}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True">

    <mah:MetroWindow.Resources>
        <converters:FrameComponentsCountConverter x:Key="FrameComponentsCountConverter" />
    </mah:MetroWindow.Resources>

    <DockPanel Background="{DynamicResource PrimaryColor}">
        <Separator DockPanel.Dock="Top" Style="{DynamicResource WindowTitleSeparatorStyle}" />

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Padding="16,12" Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Width="30"
                        Height="30"
                        Margin="0,0,12,0"
                        Foreground="{DynamicResource AccentColor}"
                        Symbol="DesignIdeas24" />
                    <StackPanel Grid.Column="1">
                        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Конструктор рам" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Foreground="{DynamicResource SecondaryForeground}"
                            Text="Выберите раму, измените её параметры или добавьте необходимые комплектующие." />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.45*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1.05*" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="14" Style="{StaticResource CardPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource HeaderStyle}" Text="Список рам" />
                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                BeginningEdit="DataGrid_BeginningEdit"
                                CanUserAddRows="False"
                                HeadersVisibility="Column"
                                ItemsSource="{Binding FormedFrameModel.AllFrames}"
                                MouseDoubleClick="DataGrid_MouseDoubleClick"
                                SelectedItem="{Binding FormedFrameModel.SelectedFrame}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="1.4*" Binding="{Binding Name}" Header="Наименование" />
                                    <DataGridTextColumn Width="*" Binding="{Binding FrameType}" Header="Тип" />
                                    <DataGridTextColumn Width="0.7*" Binding="{Binding Width}" Header="Ширина" />
                                    <DataGridTextColumn Width="0.7*" Binding="{Binding Height}" Header="Высота" />
                                    <DataGridTextColumn Width="0.7*" Binding="{Binding Depth}" Header="Глубина" />
                                    <DataGridTextColumn Width="0.7*" Binding="{Binding Weight}" Header="Масса" />
                                    <DataGridTextColumn Width="1.5*" Binding="{Binding Designe}" Header="Описание по КД" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="14" Style="{StaticResource CardPanelStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource HeaderStyle}" Text="Комплектующие выбранной рамы" />
                            <DataGrid
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                BeginningEdit="DataGrid_BeginningEdit"
                                CanUserAddRows="False"
                                ItemsSource="{Binding FormedFrameModel.DisplayedComponents}"
                                MouseDoubleClick="DataGrid_MouseDoubleClick"
                                SelectedItem="{Binding FormedFrameModel.SelectedComponentInFrame}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="2*" Binding="{Binding Component.Name}" Header="Наименование" />
                                    <DataGridTextColumn Width="*" Binding="{Binding CostComponent, StringFormat={}{0:N2}}" Header="Цена за ед." />
                                    <DataGridTextColumn Width="0.8*" Binding="{Binding Measure}" Header="Ед. изм." />
                                    <DataGridTemplateColumn Width="*" Header="Кол-во / длина">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource FrameComponentsCountConverter}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                        <DataGridTemplateColumn.CellEditingTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBox Width="44" Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    <TextBlock Margin="5,0" VerticalAlignment="Center" Text="/" />
                                                    <TextBox Width="64" Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellEditingTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Width="Auto" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Margin="2"
                                                    Padding="10,3"
                                                    Command="{Binding DataContext.RemoveComponentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Удалить"
                                                    Style="{StaticResource CancelButtonStyle}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Column="2" Padding="10" Style="{StaticResource CardPanelStyle}">
                    <TabControl x:Name="ComponentsTabControl">
                        <TabItem Header="Новая рама">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <TextBlock Margin="0,0,0,12" Style="{StaticResource HeaderStyle}" Text="Параметры новой рамы" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Margin="0,6" VerticalAlignment="Center" Text="Наименование:" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.NewFrame.Name}" />
                                        <TextBlock Grid.Row="1" Margin="0,6" VerticalAlignment="Center" Text="Тип:" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.NewFrame.FrameType}" />
                                        <TextBlock Grid.Row="2" Margin="0,6" VerticalAlignment="Center" Text="Ширина:" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.NewFrame.Width}" />
                                        <TextBlock Grid.Row="3" Margin="0,6" VerticalAlignment="Center" Text="Высота:" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.NewFrame.Height}" />
                                        <TextBlock Grid.Row="4" Margin="0,6" VerticalAlignment="Center" Text="Глубина:" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.NewFrame.Depth}" />
                                        <TextBlock Grid.Row="5" Margin="0,6" VerticalAlignment="Center" Text="Масса:" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.NewFrame.Weight}" />
                                        <TextBlock Grid.Row="6" Margin="0,6" VerticalAlignment="Center" Text="Обозначение по КД:" />
                                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.NewFrame.Designe}" />
                                    </Grid>
                                    <Button
                                        Margin="0,16,0,0"
                                        HorizontalAlignment="Right"
                                        MinWidth="160"
                                        Command="{Binding AddNewFrameCommand}"
                                        Content="Добавить новую"
                                        Style="{StaticResource ActionButtonStyle}" />
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Редактирование">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="14">
                                    <TextBlock Margin="0,0,0,12" Style="{StaticResource HeaderStyle}" Text="Выбранная рама" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="145" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Margin="0,6" VerticalAlignment="Center" Text="Наименование:" />
                                        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.SelectedFrame.Name}" />
                                        <TextBlock Grid.Row="1" Margin="0,6" VerticalAlignment="Center" Text="Тип:" />
                                        <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.SelectedFrame.FrameType}" />
                                        <TextBlock Grid.Row="2" Margin="0,6" VerticalAlignment="Center" Text="Ширина:" />
                                        <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.SelectedFrame.Width}" />
                                        <TextBlock Grid.Row="3" Margin="0,6" VerticalAlignment="Center" Text="Высота:" />
                                        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.SelectedFrame.Height}" />
                                        <TextBlock Grid.Row="4" Margin="0,6" VerticalAlignment="Center" Text="Глубина:" />
                                        <TextBox Grid.Row="4" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.SelectedFrame.Depth}" />
                                        <TextBlock Grid.Row="5" Margin="0,6" VerticalAlignment="Center" Text="Масса:" />
                                        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.SelectedFrame.Weight}" />
                                        <TextBlock Grid.Row="6" Margin="0,6" VerticalAlignment="Center" Text="Обозначение по КД:" />
                                        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Text="{Binding FormedFrameModel.SelectedFrame.Designe}" />
                                    </Grid>
                                    <WrapPanel Margin="0,16,0,0" HorizontalAlignment="Right">
                                        <Button
                                            MinWidth="180"
                                            Margin="0,0,8,0"
                                            Command="{Binding SaveChangesCommand}"
                                            Content="Сохранить изменения"
                                            Style="{StaticResource ActionButtonStyle}" />
                                        <Button
                                            MinWidth="190"
                                            Command="{Binding DeleteFrameCommand}"
                                            Content="Удалить выбранную раму"
                                            Style="{StaticResource CancelButtonStyle}" />
                                    </WrapPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>

                        <TabItem Header="Комплектующие">
                            <Grid Margin="10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Style="{StaticResource HeaderStyle}" Text="Добавление комплектующих" />
                                <TabControl Grid.Row="2">
                                    <TabItem Header="Детали рамы">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGrid AutoGenerateColumns="False" BeginningEdit="DataGrid_BeginningEdit" CanUserAddRows="False" ItemsSource="{Binding FormedFrameModel.FrameDetails}" MouseDoubleClick="DataGrid_MouseDoubleClick" SelectedItem="{Binding FormedFrameModel.SelectedComponentForAdd}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Наименование" />
                                                    <DataGridTextColumn Width="Auto" Binding="{Binding Cost}" Header="Цена" />
                                                    <DataGridTextColumn Width="Auto" Binding="{Binding Measure}" Header="Ед. изм." />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Grid.Row="1" Margin="0,10,0,8" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Количество / длина:" />
                                                <TextBox Width="80" Text="{Binding FormedFrameModel.ComponentLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Command="{Binding AddDetailsCommand}" CommandParameter="FrameDetail" Content="Добавить комплектующую" Style="{StaticResource ActionButtonStyle}" />
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Для стойки">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGrid AutoGenerateColumns="False" BeginningEdit="DataGrid_BeginningEdit" CanUserAddRows="False" ItemsSource="{Binding FormedFrameModel.PillarEqiups}" MouseDoubleClick="DataGrid_MouseDoubleClick" SelectedItem="{Binding FormedFrameModel.SelectedComponentForAdd}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Наименование" />
                                                    <DataGridTextColumn Width="Auto" Binding="{Binding Cost}" Header="Цена" />
                                                    <DataGridTextColumn Width="Auto" Binding="{Binding Measure}" Header="Ед. изм." />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Grid.Row="1" Margin="0,10,0,8" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Количество / длина:" />
                                                <TextBox Width="80" Text="{Binding FormedFrameModel.ComponentLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Command="{Binding AddDetailsCommand}" CommandParameter="PillarEqiup" Content="Добавить комплектующую" Style="{StaticResource ActionButtonStyle}" />
                                        </Grid>
                                    </TabItem>
                                    <TabItem Header="Прокат">
                                        <Grid Margin="8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DataGrid AutoGenerateColumns="False" BeginningEdit="DataGrid_BeginningEdit" CanUserAddRows="False" ItemsSource="{Binding FormedFrameModel.FrameRolls}" MouseDoubleClick="DataGrid_MouseDoubleClick" SelectedItem="{Binding FormedFrameModel.SelectedComponentForAdd}">
                                                <DataGrid.Columns>
                                                    <DataGridTextColumn Width="*" Binding="{Binding Name}" Header="Наименование" />
                                                    <DataGridTextColumn Width="Auto" Binding="{Binding Cost}" Header="Цена" />
                                                    <DataGridTextColumn Width="Auto" Binding="{Binding Measure}" Header="Ед. изм." />
                                                </DataGrid.Columns>
                                            </DataGrid>
                                            <StackPanel Grid.Row="1" Margin="0,10,0,8" Orientation="Horizontal">
                                                <TextBlock Margin="0,0,8,0" VerticalAlignment="Center" Text="Количество / длина:" />
                                                <TextBox Width="80" Text="{Binding FormedFrameModel.ComponentLength, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <Button Grid.Row="2" Command="{Binding AddDetailsCommand}" CommandParameter="FrameRoll" Content="Добавить комплектующую" Style="{StaticResource ActionButtonStyle}" />
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
