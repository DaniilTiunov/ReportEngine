<Window
    Background="{DynamicResource PrimaryColor}"
    FontFamily="Bahnschrift"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="700"
    Title="Управление пользователями"
    Width="1000"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.UsersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <ResourceDictionary />
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource WindowBorder}">
        <DockPanel>
            <Border
                Background="#2D2D30"
                DockPanel.Dock="Top"
                Height="34"
                MouseLeftButtonDown="Window_MouseLeftButtonDown"
                x:Name="FormedFrameWindowTitle">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Margin="10,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Image
                            Height="18"
                            Margin="0,0,8,0"
                            Source="/Resources/Icons/estimate_cost_icon_213382.ico"
                            Width="18" />
                        <TextBlock
                            FontSize="14"
                            Foreground="White"
                            Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            Click="MinimizeButton_Click"
                            FontSize="16"
                            Height="30"
                            ToolTip="Свернуть"
                            Width="40"
                            x:Name="MinimizeButton">
                            ─
                        </Button>
                        <Button
                            Click="MaxRestoreButton_Click"
                            FontSize="16"
                            Height="30"
                            Margin="10,0,0,0"
                            ToolTip="Развернуть"
                            Width="40"
                            x:Name="MaxRestoreButton">
                            ▢
                        </Button>
                        <Button
                            Click="CloseButton_Click"
                            FontSize="16"
                            Height="30"
                            Margin="10,0,10,0"
                            ToolTip="Закрыть"
                            Width="40"
                            x:Name="CloseButton">
                            ✕
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="89*" />
                    <ColumnDefinition Width="63*" />
                    <ColumnDefinition Width="43*" />
                    <ColumnDefinition Width="4*" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <DataGrid
                    CanUserAddRows="True"
                    CanUserDeleteRows="True"
                    CanUserReorderColumns="True"
                    CanUserSortColumns="True"
                    Grid.ColumnSpan="4"
                    Grid.Row="1"
                    ItemsSource="{Binding CurrentUser.AllUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Margin="10,79,5,10"
                    RowHeaderWidth="40"
                    SelectedItem="{Binding CurrentUser.SelectedUser, Mode=TwoWay}"
                    SelectionUnit="FullRow"
                    x:Name="UsersDataGrid">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Command="{Binding ShowAllUsersCommand}" Header="Показать всех" />
                            <Separator />
                            <MenuItem Command="{Binding SaveUserCommand}" Header="Сохранить изменения" />
                            <MenuItem Command="{Binding AddNewUserCommand}" Header="Добавить" />
                            <Separator />
                            <MenuItem Command="{Binding DeleteUserCommand}" Header="Удалить" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Binding="{Binding SecondName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Фамилия"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Имя"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding LastName, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Отчество"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding Position, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Должность"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding Cabinet, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Кабинет"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Почта"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding PhoneContact, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                            Header="Номер для связи"
                            Width="*" />
                        <DataGridTextColumn
                            Binding="{Binding UserLogin}"
                            Header="Имя в системе"
                            Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </DockPanel>
    </Border>
</Window>