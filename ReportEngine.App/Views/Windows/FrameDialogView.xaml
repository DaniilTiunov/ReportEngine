<mah:MetroWindow
    x:Class="ReportEngine.App.Views.Windows.FrameDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    Title="Выбор рамы"
    Width="1040"
    Height="680"
    MinWidth="820"
    MinHeight="520"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="False"
    TitleForeground="{DynamicResource PrimaryForeground}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">


    <mah:MetroWindow.Resources>
        <DropShadowEffect
            x:Key="WindowShadow"
            BlurRadius="30"
            Opacity="0.2"
            ShadowDepth="0"
            Color="#000000" />
    </mah:MetroWindow.Resources>
    <DockPanel Background="{DynamicResource PrimaryColor}">
        <Separator DockPanel.Dock="Top" Style="{DynamicResource WindowTitleSeparatorStyle}" />

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Width="28"
                        Height="28"
                        Margin="0,0,12,0"
                        Foreground="{DynamicResource AccentColor}"
                        Symbol="TableSimple24" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Рамы для стенда" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Foreground="{DynamicResource SecondaryForeground}"
                            Text="Выберите подходящую раму двойным щелчком или настройте выбранную запись ниже." />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid
                x:Name="FrameDataGrid"
                Grid.Row="1"
                MinHeight="260"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                ItemsSource="{Binding FormedFrameModel.AllFrames}"
                MouseDoubleClick="FormedFrameGrid_MouseDoubleClick"
                SelectedItem="{Binding FormedFrameModel.SelectedFrame}">
                <DataGrid.Columns>
                    <DataGridTextColumn Width="1.4*" Binding="{Binding Name}" Header="Наименование" />
                    <DataGridTextColumn Width="*" Binding="{Binding FrameType}" Header="Тип" />
                    <DataGridTextColumn Width="0.7*" Binding="{Binding Width}" Header="Ширина" />
                    <DataGridTextColumn Width="0.7*" Binding="{Binding Height}" Header="Высота" />
                    <DataGridTextColumn Width="0.7*" Binding="{Binding Depth}" Header="Глубина" />
                    <DataGridTextColumn Width="0.7*" Binding="{Binding Weight}" Header="Масса" />
                    <DataGridTextColumn Width="1.6*" Binding="{Binding Designe}" Header="Описание по КД" />
                </DataGrid.Columns>
            </DataGrid>

            <Border
                Grid.Row="2"
                Margin="0,12,0,0"
                Padding="16,10"
                Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Конструкция выбранной рамы" />
                        <TextBlock
                            Margin="0,2,18,0"
                            Foreground="{DynamicResource SecondaryForeground}"
                            Text="Включите параметр, если рама поставляется в разборном исполнении." />
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Content="Разборная"
                        IsChecked="{Binding FormedFrameModel.SelectedFrame.Disassembled, Mode=TwoWay}"
                        Style="{DynamicResource FluentToggleSwitchStyle}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
