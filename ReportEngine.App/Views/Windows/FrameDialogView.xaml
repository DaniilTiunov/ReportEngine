<mah:MetroWindow
    x:Class="ReportEngine.App.Views.Windows.FrameDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    Title="Выбор рамы"
    Width="1040"
    Height="680"
    MinWidth="820"
    MinHeight="520"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="False"
    TitleForeground="{DynamicResource PrimaryForeground}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">


    <mah:MetroWindow.Resources>
        <converters:FrameComponentsCountConverter x:Key="FrameComponentsCountConverter" />

        <DropShadowEffect
            x:Key="WindowShadow"
            BlurRadius="30"
            Opacity="0.2"
            ShadowDepth="0"
            Color="#000000" />
    </mah:MetroWindow.Resources>

    <DockPanel Background="{DynamicResource PrimaryColor}">
        <Separator DockPanel.Dock="Top" Style="{DynamicResource WindowTitleSeparatorStyle}" />

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Grid.Row="0"
                Margin="0,0,0,12"
                Padding="16,12"
                Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Width="28"
                        Height="28"
                        Margin="0,0,12,0"
                        Foreground="{DynamicResource AccentColor}"
                        Symbol="TableSimple24" />
                    <StackPanel Grid.Column="1">
                        <TextBlock
                            FontSize="17"
                            FontWeight="SemiBold"
                            Text="Рамы для стенда" />
                        <TextBlock
                            Margin="0,3,0,0"
                            Foreground="{DynamicResource SecondaryForeground}"
                            Text="Выберите подходящую раму двойным щелчком или настройте выбранную запись ниже." />
                    </StackPanel>
                </Grid>
            </Border>

            <DataGrid
                x:Name="FrameDataGrid"
                Grid.Row="1"
                MinHeight="260"
                AutoGenerateColumns="False"
                CanUserAddRows="False"
                HeadersVisibility="Column"
                ItemsSource="{Binding FormedFrameModel.AllFrames}"
                MouseDoubleClick="FormedFrameGrid_MouseDoubleClick"
                SelectedItem="{Binding FormedFrameModel.SelectedFrame}">

                <DataGrid.Resources>
                    <DataTemplate x:Key="FrameComponentsToolTipTemplate">
                        <Border
                            MaxWidth="560"
                            Padding="12"
                            Background="{DynamicResource SecondaryColor}"
                            BorderBrush="{DynamicResource BorderColor}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    Margin="0,0,0,8"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource PrimaryForeground}"
                                    Text="Комплектующие выбранной рамы" />
                                <DataGrid
                                    Grid.Row="1"
                                    MaxHeight="260"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    HeadersVisibility="Column"
                                    IsHitTestVisible="False"
                                    IsReadOnly="True"
                                    ItemsSource="{Binding}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="2*"
                                            Binding="{Binding ComponentName}"
                                            Header="Наименование" />
                                        <DataGridTemplateColumn Width="*" Header="Кол-во / длина">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock VerticalAlignment="Center" Text="{Binding Converter={StaticResource FrameComponentsCountConverter}}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                            <DataGridTemplateColumn.CellEditingTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBox Width="44" Text="{Binding Count, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                        <TextBlock
                                                            Margin="5,0"
                                                            VerticalAlignment="Center"
                                                            Text="/" />
                                                        <TextBox Width="64" Text="{Binding Length, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellEditingTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn
                                            Width="*"
                                            Binding="{Binding Measure}"
                                            Header="Ед. изм." />
                                        <DataGridTextColumn
                                            Width="1.2*"
                                            Binding="{Binding CostComponent, StringFormat={}{0:N2}}"
                                            Header="Цена за ед." />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </DataTemplate>

                    <Style TargetType="ToolTip">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="ContentTemplate" Value="{StaticResource FrameComponentsToolTipTemplate}" />
                        <Setter Property="Placement" Value="Mouse" />
                        <Setter Property="HorizontalOffset" Value="14" />
                        <Setter Property="VerticalOffset" Value="10" />
                    </Style>
                </DataGrid.Resources>

                <DataGrid.RowStyle>
                    <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                        <Setter Property="ToolTip" Value="{Binding Components}" />
                        <Setter Property="ToolTipService.InitialShowDelay" Value="350" />
                        <Setter Property="ToolTipService.ShowDuration" Value="20000" />
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.Columns>
                    <DataGridTextColumn
                        Width="1.4*"
                        Binding="{Binding Name}"
                        Header="Наименование" />
                    <DataGridTextColumn
                        Width="*"
                        Binding="{Binding FrameType}"
                        Header="Тип" />
                    <DataGridTextColumn
                        Width="0.7*"
                        Binding="{Binding Width}"
                        Header="Ширина" />
                    <DataGridTextColumn
                        Width="0.7*"
                        Binding="{Binding Height}"
                        Header="Высота" />
                    <DataGridTextColumn
                        Width="0.7*"
                        Binding="{Binding Depth}"
                        Header="Глубина" />
                    <DataGridTextColumn
                        Width="0.7*"
                        Binding="{Binding Weight}"
                        Header="Масса" />
                    <DataGridTextColumn
                        Width="1.6*"
                        Binding="{Binding Designe}"
                        Header="Описание по КД" />
                </DataGrid.Columns>
            </DataGrid>

            <Border
                Grid.Row="2"
                Margin="0,12,0,0"
                Padding="16,10"
                Style="{StaticResource CardPanelStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" Text="Конструкция выбранной рамы" />
                        <TextBlock
                            Margin="0,2,18,0"
                            Foreground="{DynamicResource SecondaryForeground}"
                            Text="Включите параметр, если рама поставляется в разборном исполнении." />
                    </StackPanel>
                    <ui:ToggleSwitch
                        Grid.Column="1"
                        Content="Разборная"
                        IsChecked="{Binding FormedFrameModel.SelectedFrame.Disassembled, Mode=TwoWay}"
                        Style="{DynamicResource FluentToggleSwitchStyle}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
