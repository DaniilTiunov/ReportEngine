<mah:MetroWindow
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="700"
    ResizeMode="NoResize"
    ShowIconOnTitleBar="True"
    Title="Выбор рамы"
    TitleForeground="{DynamicResource PrimaryForeground}"
    Width="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.FrameDialogView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <mah:MetroWindow.Resources>
        <DropShadowEffect
            BlurRadius="30"
            Color="#000000"
            Opacity="0.2"
            ShadowDepth="0"
            x:Key="WindowShadow" />
    </mah:MetroWindow.Resources>

    <Border
        ClipToBounds="True"
        CornerRadius="12"
        Effect="{StaticResource WindowShadow}">
        <Border
            Background="{DynamicResource PrimaryColor}"
            BorderBrush="{DynamicResource WindowBorderColor}"
            BorderThickness="1"
            CornerRadius="12">
            <DockPanel>
                <!--  Заголовок окна  -->


                <!--  Основное содержимое  -->
                <Grid Margin="15,10,15,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>

                    <ScrollViewer
                        Grid.Column="0"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            ItemsSource="{Binding FormedFrameModel.AllFrames}"
                            Margin="0,5,10,5"
                            MinHeight="200"
                            MouseDoubleClick="FormedFrameGrid_MouseDoubleClick"
                            SelectedItem="{Binding FormedFrameModel.SelectedFrame}"
                            x:Name="FrameDataGrid">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding Name}"
                                    Header="Наименование"
                                    Width="*" />
                                <DataGridTextColumn
                                    Binding="{Binding FrameType}"
                                    Header="Тип"
                                    Width="Auto" />
                                <DataGridTextColumn
                                    Binding="{Binding Width}"
                                    Header="Ширина"
                                    Width="Auto" />
                                <DataGridTextColumn
                                    Binding="{Binding Height}"
                                    Header="Высота"
                                    Width="Auto" />
                                <DataGridTextColumn
                                    Binding="{Binding Depth}"
                                    Header="Глубина"
                                    Width="Auto" />
                                <DataGridTextColumn
                                    Binding="{Binding Weight}"
                                    Header="Масса"
                                    Width="Auto" />
                                <DataGridTextColumn
                                    Binding="{Binding Designe}"
                                    Header="Описание по КД"
                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>

                    <Border
                        Grid.Column="1"
                        Margin="10,5,0,5"
                        Padding="10"
                        Style="{StaticResource CardPanelStyle}"
                        VerticalAlignment="Top">
                        <CheckBox
                            Content="Разборная"
                            FontSize="16"
                            IsChecked="{Binding FormedFrameModel.SelectedFrame.Disassembled, Mode=TwoWay}"
                            VerticalAlignment="Top" />
                    </Border>
                </Grid>
            </DockPanel>
        </Border>
    </Border>
</mah:MetroWindow>