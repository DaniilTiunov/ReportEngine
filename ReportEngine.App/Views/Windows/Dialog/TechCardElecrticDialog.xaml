<mah:MetroWindow
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    MaxHeight="600"
    ResizeMode="NoResize"
    ShowIconOnTitleBar="True"
    SizeToContent="Height"
    Title="Выбор наполнения отчета"
    TitleForeground="{DynamicResource PrimaryForeground}"
    Topmost="True"
    Width="450"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.Dialog.TechCardElecrticDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <mah:MetroWindow.Resources>
        <DropShadowEffect
            BlurRadius="30"
            Color="#000000"
            Opacity="0.2"
            ShadowDepth="0"
            x:Key="WindowShadow" />
    </mah:MetroWindow.Resources>

    <!--  Основной контейнер с тенью и рамкой  -->
    <Border CornerRadius="12" Effect="{StaticResource WindowShadow}">
        <Border
            Background="{DynamicResource PrimaryColor}"
            BorderBrush="{DynamicResource WindowBorderColor}"
            BorderThickness="1"
            CornerRadius="12">
            <DockPanel>
                <!--  Заголовок окна  -->


                <!--  Основной контент  -->
                <Border
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="0,0,12,12"
                    Padding="20,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Текст сообщения  -->
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryForeground}"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"
                            Text="Выберите тип технологической карты"
                            TextWrapping="Wrap"
                            x:Name="MessageText" />

                        <!--  Кнопки действий  -->
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="0,5"
                            Orientation="Horizontal">
                            <Button
                                Click="WithButton_Click"
                                Content="С электрикой"
                                Margin="5,0"
                                Style="{StaticResource ActionButtonStyle}"
                                Width="130"
                                x:Name="WithButton" />
                            <Button
                                Click="WithoutButton_Click"
                                Content="Без электрики"
                                Margin="5,0"
                                Style="{StaticResource ActionButtonStyle}"
                                Width="130"
                                x:Name="WithoutButton" />
                            <Button
                                Click="CancelButton_Click"
                                Content="Отмена"
                                Margin="5,0"
                                Style="{StaticResource CancelButtonStyle}"
                                Width="130"
                                x:Name="CancelButton" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Border>
</mah:MetroWindow>