<Window
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Bahnschrift"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    MaxHeight="600"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Title="Выбор наполнения отчета"
    Topmost="True"
    Width="450"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.Dialog.TechCardElecrticDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="12"
            GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <DropShadowEffect
            BlurRadius="30"
            Color="#000000"
            Opacity="0.2"
            ShadowDepth="0"
            x:Key="WindowShadow" />
    </Window.Resources>

    <!--  Основной контейнер с тенью и рамкой  -->
    <Border CornerRadius="12" Effect="{StaticResource WindowShadow}">
        <Border
            Background="{DynamicResource PrimaryColor}"
            BorderBrush="{DynamicResource WindowBorderColor}"
            BorderThickness="1"
            CornerRadius="12">
            <DockPanel>
                <!--  Заголовок окна  -->
                <Border
                    Background="#2D2D30"
                    CornerRadius="12,12,0,0"
                    DockPanel.Dock="Top"
                    Height="40"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Margin="12,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Image
                                Height="18"
                                Margin="0,0,8,0"
                                Width="18"
                                x:Name="TitleIcon" />
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="White"
                                VerticalAlignment="Center"
                                x:Name="TitleText" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Button
                                Click="CloseButton_Click"
                                Height="30"
                                Margin="0,0,10,0"
                                Style="{StaticResource CloseButtonStyle}"
                                ToolTip="Закрыть"
                                Width="40"
                                x:Name="CloseButton">
                                ✕
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Основной контент  -->
                <Border
                    Background="{DynamicResource SecondaryColor}"
                    CornerRadius="0,0,12,12"
                    Padding="20,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Текст сообщения  -->
                        <TextBlock
                            FontSize="18"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource PrimaryForeground}"
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"
                            Text="Выберите тип технологической карты"
                            TextWrapping="Wrap"
                            x:Name="MessageText" />

                        <!--  Кнопки действий  -->
                        <StackPanel
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            Margin="0,5"
                            Orientation="Horizontal">
                            <Button
                                Click="WithButton_Click"
                                Content="С электрикой"
                                Margin="5,0"
                                Style="{StaticResource ActionButtonStyle}"
                                Width="130"
                                x:Name="WithButton" />
                            <Button
                                Click="WithoutButton_Click"
                                Content="Без электрики"
                                Margin="5,0"
                                Style="{StaticResource ActionButtonStyle}"
                                Width="130"
                                x:Name="WithoutButton" />
                            <Button
                                Click="CancelButton_Click"
                                Content="Отмена"
                                Margin="5,0"
                                Style="{StaticResource CancelButtonStyle}"
                                Width="130"
                                x:Name="CancelButton" />
                        </StackPanel>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Border>
</Window>