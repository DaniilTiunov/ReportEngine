<Window
    Background="{DynamicResource PrimaryColor}"
    FontFamily="Bahnschrift"
    Foreground="{DynamicResource PrimaryForeground}"
    MaxHeight="600"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Title="Выбор наполнения отчета"
    Topmost="True"
    Width="400"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.Dialog.TechCardElecrticDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource WindowBorder}">
        <Border>
            <DockPanel>
                <Border
                    Background="#2D2D30"
                    DockPanel.Dock="Top"
                    Height="34"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Margin="10,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Image
                                Height="18"
                                Margin="0,0,8,0"
                                Width="18"
                                x:Name="TitleIcon" />
                            <TextBlock
                                FontSize="14"
                                Foreground="White"
                                VerticalAlignment="Center"
                                x:Name="TitleText" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Button
                                Click="CloseButton_Click"
                                FontSize="16"
                                Height="30"
                                Margin="10,0,10,0"
                                ToolTip="Закрыть"
                                Width="40"
                                x:Name="CloseButton">
                                ✕
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Контент уведомления  -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>


                        <!--  Текст уведомления  -->
                        <TextBlock
                            FontSize="16"
                            Grid.Column="1"
                            HorizontalAlignment="Center"
                            Margin="5"
                            Text="Выберите тип технологической карты"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            x:Name="MessageText" />
                    </Grid>

                    <!--  Кнопки  -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,0"
                        Orientation="Horizontal">
                        <Button
                            Click="WithButton_Click"
                            Content="С электрикой"
                            Margin="5,0"
                            Width="120"
                            x:Name="WithButton" />
                        <Button
                            Click="WithoutButton_Click"
                            Content="Без электрики"
                            Margin="5,0"
                            Width="120"
                            x:Name="WithoutButton" />
                        <Button
                            Click="CancelButton_Click"
                            Content="Отмена"
                            Margin="5,0"
                            Width="120"
                            x:Name="CancelButton" />
                    </StackPanel>
                </Grid>

            </DockPanel>
        </Border>
    </Border>
</Window>