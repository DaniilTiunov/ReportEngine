<Window
    AllowsTransparency="True"
    Background="Transparent"
    Height="480"
    Title="Загрузка"
    Width="720"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    x:Class="ReportEngine.App.Views.Windows.Dialog.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ReportEngine.App.Views.Windows.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <!--  Светлый градиент для фона  -->
        <LinearGradientBrush EndPoint="1,1" StartPoint="0,0" x:Key="BackgroundGradient">
            <GradientStop Color="#F8F9FA" Offset="0" />
            <GradientStop Color="#E9ECEF" Offset="1" />
        </LinearGradientBrush>

        <!--  Тень для окна  -->
        <DropShadowEffect
            BlurRadius="40"
            Color="#000000"
            Opacity="0.15"
            ShadowDepth="0"
            x:Key="WindowShadow" />

        <!--  Стиль для заголовка  -->
        <Style TargetType="TextBlock" x:Key="TitleTextStyle">
            <Setter Property="FontSize" Value="32" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1A1A1A" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <!--  Стиль для подзаголовка (канал)  -->
        <Style TargetType="TextBlock" x:Key="ChannelTextStyle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="Foreground" Value="#888888" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!--  Стиль для второстепенного текста  -->
        <Style TargetType="TextBlock" x:Key="SubTextStyle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#999999" />
            <Setter Property="FontFamily" Value="Segoe UI" />
        </Style>

        <!--  Стиль для статусного текста  -->
        <Style TargetType="TextBlock" x:Key="StatusTextStyle">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#444444" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,20" />
        </Style>

        <!--  Стиль для нижнего текста  -->
        <Style TargetType="TextBlock" x:Key="FooterTextStyle">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#AAAAAA" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>

    <!--  Основной контейнер с тенью  -->
    <Border CornerRadius="16" Effect="{StaticResource WindowShadow}">
        <Border
            Background="{StaticResource BackgroundGradient}"
            CornerRadius="16"
            Padding="40">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Верхняя декоративная линия  -->
                <Border
                    Background="#333333"
                    CornerRadius="2"
                    Grid.Row="0"
                    Height="3"
                    HorizontalAlignment="Left"
                    Margin="0,0,0,20"
                    Width="60" />

                <!--  Заголовок и информация  -->
                <StackPanel Grid.Row="0">
                    <!--  Логотип + заголовок  -->
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <!--  Увеличенный логотип с белым фоном  -->
                        <Border
                            Background="White"
                            BorderBrush="#EEEEEE"
                            BorderThickness="1"
                            CornerRadius="12"
                            Height="90"
                            HorizontalAlignment="Center"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            Width="156">
                            <Image
                                Height="80"
                                Source="/Resources/Images/Etalon.jpg"
                                Stretch="Uniform"
                                Width="140" />
                        </Border>

                        <StackPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource TitleTextStyle}">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Стенды КИПиА v{0}">
                                            <Binding Path="Version" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                                <TextBlock Style="{StaticResource ChannelTextStyle}">
                                    <TextBlock.Text>
                                        <Binding Path="Channel" />
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>

                            <!--  Информация о компании  -->
                            <StackPanel Margin="0,4,0,0">
                                <TextBlock Style="{StaticResource SubTextStyle}" Text="ЗАО «ЭТАЛОН-ПРИБОР», Группа разработки ПО" />
                                <TextBlock Style="{StaticResource SubTextStyle}" Text="© Все права защищены" />
                                <TextBlock Style="{StaticResource SubTextStyle}" Text="2026 г." />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!--  Центральная область со статусом и прогрессом  -->
                <Grid Grid.Row="1" VerticalAlignment="Center">
                    <StackPanel>
                        <!--  Анимированные точки (серые)  -->
                        <StackPanel
                            HorizontalAlignment="Center"
                            Margin="0,0,0,20"
                            Orientation="Horizontal">
                            <Border
                                Background="#555555"
                                CornerRadius="6"
                                Height="12"
                                Margin="0,0,8,0"
                                Width="12">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    AutoReverse="True"
                                                    Duration="0:0:0.6"
                                                    From="0.3"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <Border
                                Background="#888888"
                                CornerRadius="6"
                                Height="12"
                                Margin="0,0,8,0"
                                Width="12">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    AutoReverse="True"
                                                    BeginTime="0:0:0.2"
                                                    Duration="0:0:0.6"
                                                    From="0.3"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                            <Border
                                Background="#BBBBBB"
                                CornerRadius="6"
                                Height="12"
                                Margin="0,0,0,0"
                                Width="12">
                                <Border.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    AutoReverse="True"
                                                    BeginTime="0:0:0.4"
                                                    Duration="0:0:0.6"
                                                    From="0.3"
                                                    Storyboard.TargetProperty="Opacity"
                                                    To="1" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Border.Triggers>
                            </Border>
                        </StackPanel>

                        <!--  Текст статуса  -->
                        <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding StatusText}" />

                        <!--  Прогресс-бар  -->
                        <ProgressBar
                            Background="#DDDDDD"
                            BorderThickness="0"
                            Foreground="#333333"
                            Height="4"
                            HorizontalAlignment="Center"
                            IsIndeterminate="True"
                            Width="300" />
                    </StackPanel>
                </Grid>

                <!--  Нижний меняющийся текст  -->
                <TextBlock
                    Grid.Row="3"
                    Style="{StaticResource FooterTextStyle}"
                    Text="Инициализация системы...">
                    <TextBlock.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <StringAnimationUsingKeyFrames
                                        Duration="0:0:3"
                                        RepeatBehavior="Forever"
                                        Storyboard.TargetProperty="Text">
                                        <DiscreteStringKeyFrame KeyTime="0:0:0" Value="Инициализация системы..." />
                                        <DiscreteStringKeyFrame KeyTime="0:0:1" Value="Загрузка модулей..." />
                                        <DiscreteStringKeyFrame KeyTime="0:0:2" Value="Подготовка интерфейса..." />
                                    </StringAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </TextBlock.Triggers>
                </TextBlock>
            </Grid>
        </Border>
    </Border>
</Window>