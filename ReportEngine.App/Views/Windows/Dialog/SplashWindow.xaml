<Window
    Height="450"
    Title="Загрузка"
    Width="800"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="ReportEngine.App.Views.Windows.Dialog.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ReportEngine.App.Views.Windows.Dialog"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border CornerRadius="12" Padding="35">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Название  -->
            <StackPanel Grid.Row="0">
                <TextBlock FontSize="28" FontWeight="SemiBold">
                    <TextBlock.Text>
                        <MultiBinding StringFormat="Стенды КИПиА v{0} {1}">
                            <Binding Path="Version" />
                            <Binding Path="Channel" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>

                <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                            <RowDefinition Height="25" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            FontSize="11"
                            Grid.Row="0"
                            Opacity="0.45"
                            Text="ЗАО «ЭТАЛОН-ПРИБОР», Группа разработки ПО" />

                        <TextBlock
                            FontSize="11"
                            Grid.Row="1"
                            Opacity="0.45"
                            Text="@Все права защищены" />

                        <TextBlock
                            FontSize="11"
                            Grid.Row="2"
                            Opacity="0.45"
                            Text="2026 г." />
                    </Grid>
                </StackPanel>
            </StackPanel>

            <!--  Центральная область  -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        Margin="0,0,0,14"
                        Text="Запуск приложения..."
                        x:Name="StatusText" />

                    <ProgressBar
                        Height="4"
                        IsIndeterminate="True"
                        x:Name="ProgressBar" />
                </StackPanel>
            </Grid>

            <!--  Нижний текст  -->
            <TextBlock
                FontSize="11"
                Grid.Row="3"
                HorizontalAlignment="Right"
                Opacity="0.45"
                Text="Инициализация..." />
        </Grid>
    </Border>
</Window>