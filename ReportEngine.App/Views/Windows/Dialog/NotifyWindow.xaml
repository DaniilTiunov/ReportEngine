<Window
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Bahnschrift"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    MaxHeight="600"
    ResizeMode="NoResize"
    SizeToContent="Height"
    Title="Уведомление"
    Topmost="True"
    Width="450"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.Dialog.NotifyWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <DropShadowEffect
            BlurRadius="30"
            Color="#000000"
            Opacity="0.25"
            ShadowDepth="0"
            x:Key="WindowShadow" />

        <!--  Стиль для заголовка окна  -->
        <Style TargetType="TextBlock" x:Key="TitleTextStyle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Стиль для кнопки закрытия  -->
        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Margin" Value="10,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="Закрыть" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E81123" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#C40E1E" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Стиль для кнопок действия  -->
        <Style TargetType="Button" x:Key="ActionButtonStyle">
            <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="20,8" />
            <Setter Property="Margin" Value="5,0" />
            <Setter Property="Width" Value="90" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueDarkBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#2A2D5A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Background" Value="#555555" />
                                <Setter Property="Foreground" Value="#999999" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Стиль для кнопки "Отмена"  -->
        <Style
            BasedOn="{StaticResource ActionButtonStyle}"
            TargetType="Button"
            x:Key="CancelButtonStyle">
            <Setter Property="Background" Value="#444444" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#555555" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#333333" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!--  Стиль для текста сообщения  -->
        <Style TargetType="TextBlock" x:Key="MessageTextStyle">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="5" />
        </Style>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="12"
            GlassFrameThickness="0"
            ResizeBorderThickness="0" />
    </WindowChrome.WindowChrome>

    <!--  Основной контейнер с тенью и рамкой  -->
    <Border
        ClipToBounds="True"
        CornerRadius="12"
        Effect="{StaticResource WindowShadow}">
        <Border
            Background="{DynamicResource PrimaryColor}"
            BorderBrush="{DynamicResource PrimaryForeground}"
            BorderThickness="3"
            CornerRadius="10">
            <DockPanel>
                <!--  Заголовок  -->
                <Border
                    Background="#2D2D30"
                    CornerRadius="10,10,0,0"
                    DockPanel.Dock="Top"
                    Height="40"
                    MouseLeftButtonDown="Window_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Заголовок с иконкой  -->
                        <StackPanel
                            Margin="12,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Image
                                Height="18"
                                Margin="0,0,8,0"
                                Width="18"
                                x:Name="TitleIcon" />
                            <TextBlock Style="{StaticResource TitleTextStyle}" x:Name="TitleText" />
                        </StackPanel>

                        <!--  Кнопка закрытия  -->
                        <StackPanel
                            Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Button
                                Click="CloseButton_Click"
                                Style="{StaticResource CloseButtonStyle}"
                                x:Name="CloseButton">
                                ✕
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Основной контент  -->
                <Grid Margin="20,15,20,15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Контент уведомления  -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Иконка уведомления  -->
                        <Border
                            Background="{DynamicResource SecondaryColor}"
                            CornerRadius="8"
                            Grid.Column="0"
                            Height="52"
                            Margin="0,0,12,0"
                            VerticalAlignment="Top"
                            Width="52">
                            <Image
                                Height="36"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="36"
                                x:Name="IconImage" />
                        </Border>

                        <!--  Текст уведомления  -->
                        <TextBlock
                            Grid.Column="1"
                            Style="{StaticResource MessageTextStyle}"
                            x:Name="MessageText" />
                    </Grid>

                    <!--  Кнопки  -->
                    <StackPanel
                        Grid.Row="1"
                        HorizontalAlignment="Right"
                        Margin="0,15,0,0"
                        Orientation="Horizontal">
                        <Button
                            Click="OkButton_Click"
                            Style="{StaticResource ActionButtonStyle}"
                            x:Name="OkButton">
                            ОК
                        </Button>
                        <Button
                            Click="CancelButton_Click"
                            Style="{StaticResource CancelButtonStyle}"
                            x:Name="CancelButton">
                            Отмена
                        </Button>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>