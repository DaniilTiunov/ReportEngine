<Window
    Background="{DynamicResource PrimaryColor}"
    FontFamily="Bahnschrift"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    ResizeMode="CanResize"
    Title="🏗️ Все стенды"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.Dialog.AllStandsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource WindowBorder}">
        <DockPanel>
            <Border
                Background="#2D2D30"
                DockPanel.Dock="Top"
                Height="34"
                MouseLeftButtonDown="Window_MouseLeftButtonDown"
                x:Name="FormedFrameWindowTitle">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Margin="10,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="16"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center">
                            🏗️
                        </TextBlock>
                        <TextBlock
                            FontSize="14"
                            Foreground="White"
                            Text="🗂️ Все стенды"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            Click="MinimizeButton_Click"
                            FontSize="16"
                            Height="30"
                            ToolTip="Свернуть ➖"
                            Width="40"
                            x:Name="MinimizeButton">
                            ─
                        </Button>
                        <Button
                            Click="MaxRestoreButton_Click"
                            FontSize="16"
                            Height="30"
                            Margin="10,0,0,0"
                            ToolTip="Развернуть ⬜"
                            Width="40"
                            x:Name="MaxRestoreButton">
                            ▢
                        </Button>
                        <Button
                            Click="CloseButton_Click"
                            FontSize="16"
                            Height="30"
                            Margin="10,0,10,0"
                            ToolTip="Закрыть ✕"
                            Width="40"
                            x:Name="CloseButton">
                            ✕
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <GroupBox
                    FontSize="16"
                    Grid.Column="0"
                    Header="📋 Все проекты"
                    Margin="0,0,5,0">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" Margin="0,0,8,0">📋</TextBlock>
                                <TextBlock FontWeight="SemiBold" Text="Все проекты" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="Gray"
                                    Margin="10,0,0,0"
                                    Text="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>

                    <ListView
                        BorderThickness="3"
                        ItemsSource="{Binding AllProjects}"
                        Margin="5"
                        SelectedItem="{Binding SelectedProject}"
                        x:Name="ProjectList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn DisplayMemberBinding="{Binding Company}" Header="🏢 Заказчик" />
                                <GridViewColumn DisplayMemberBinding="{Binding Object}" Header="📍 Объект" />
                                <GridViewColumn DisplayMemberBinding="{Binding Description}" Header="📄 Обозначение по КД" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>

                <GroupBox
                    FontSize="16"
                    Grid.Column="1"
                    Header="🏗️ Стенды в проекте"
                    Margin="5,0,0,0">
                    <GroupBox.HeaderTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="18" Margin="0,0,8,0">🏗️</TextBlock>
                                <TextBlock FontWeight="SemiBold" Text="Стенды в проекте" />
                                <TextBlock
                                    FontSize="12"
                                    Foreground="Gray"
                                    Margin="10,0,0,0"
                                    Text="{Binding Items.Count, RelativeSource={RelativeSource AncestorType=ListView}}"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </GroupBox.HeaderTemplate>

                    <ListView
                        BorderThickness="3"
                        ItemsSource="{Binding SelectedProject.Stands}"
                        Margin="5"
                        MouseDoubleClick="StandsList_MouseDoubleClick"
                        SelectedItem="{Binding SelectedStand}"
                        x:Name="StandsList">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn DisplayMemberBinding="{Binding KKSCode}" Header="🔢 Код ККС" />
                                <GridViewColumn DisplayMemberBinding="{Binding Design}" Header="📐 Обозначение стенда" />
                                <GridViewColumn DisplayMemberBinding="{Binding SerialNumber}" Header="🔢 Серийный номер" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
            </Grid>
        </DockPanel>
    </Border>
</Window>