<Window
    AllowsTransparency="True"
    Background="Transparent"
    FontFamily="Bahnschrift"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="150"
    ResizeMode="NoResize"
    Title="Идёт выполнение"
    Topmost="True"
    Width="400"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    x:Class="ReportEngine.App.Views.Windows.Dialog.ProgressDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Window.Resources>
        <!--  Тень  -->
        <DropShadowEffect
            BlurRadius="30"
            Color="#000000"
            Opacity="0.35"
            ShadowDepth="0"
            x:Key="WindowShadow" />
        <!--  Заголовок  -->
        <Style TargetType="TextBlock" x:Key="TitleTextStyle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!--  Статус  -->
        <Style TargetType="TextBlock" x:Key="StatusTextStyle">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="FontFamily" Value="Bahnschrift" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <!--  ProgressBar  -->
        <Style TargetType="ProgressBar" x:Key="ProgressBarStyle">
            <Setter Property="Height" Value="6" />
            <Setter Property="Width" Value="300" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource BorderColor}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="IsIndeterminate" Value="True" />
        </Style>
    </Window.Resources>
    <!--  Шаблон самого Window  -->
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <Border
                Background="{DynamicResource PrimaryColor}"
                BorderBrush="{DynamicResource PrimaryForeground}"
                BorderThickness="2"
                CornerRadius="12"
                Effect="{StaticResource WindowShadow}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <!--  Заголовок  -->
                    <Border
                        Background="#2D2D30"
                        CornerRadius="10,10,0,0"
                        Grid.Row="0">
                        <StackPanel
                            Margin="12,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                            <Image
                                Height="18"
                                Margin="0,0,8,0"
                                Source="/Resources/Icons/estimate_cost_icon_213382.ico"
                                Width="18" />
                            <TextBlock Style="{StaticResource TitleTextStyle}" Text="{TemplateBinding Title}" />
                        </StackPanel>
                    </Border>
                    <!--  Содержимое Window  -->
                    <Border Grid.Row="1">
                        <AdornerDecorator>
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </AdornerDecorator>
                    </Border>
                </Grid>
            </Border>
        </ControlTemplate>
    </Window.Template>
    <!--  Всё это уже является Content самого Window  -->
    <StackPanel
        HorizontalAlignment="Center"
        Margin="20,15,20,15"
        VerticalAlignment="Center">
        <!--  Спиннер  -->
        <StackPanel
            HorizontalAlignment="Center"
            Margin="0,0,0,15"
            Orientation="Horizontal">
            <Border
                Background="{DynamicResource PrimaryHueMidBrush}"
                CornerRadius="5"
                Height="10"
                Margin="0,0,8,0"
                Width="10">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    AutoReverse="True"
                                    Duration="0:0:0.6"
                                    From="0.2"
                                    Storyboard.TargetProperty="Opacity"
                                    To="1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Border
                Background="{DynamicResource PrimaryHueMidBrush}"
                CornerRadius="5"
                Height="10"
                Margin="0,0,8,0"
                Opacity="0.5"
                Width="10">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    AutoReverse="True"
                                    BeginTime="0:0:0.2"
                                    Duration="0:0:0.6"
                                    From="0.2"
                                    Storyboard.TargetProperty="Opacity"
                                    To="1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
            <Border
                Background="{DynamicResource PrimaryHueMidBrush}"
                CornerRadius="5"
                Height="10"
                Opacity="0.3"
                Width="10">
                <Border.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation
                                    AutoReverse="True"
                                    BeginTime="0:0:0.4"
                                    Duration="0:0:0.6"
                                    From="0.2"
                                    Storyboard.TargetProperty="Opacity"
                                    To="1" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Border.Triggers>
            </Border>
        </StackPanel>
        <TextBlock Style="{StaticResource StatusTextStyle}" Text="Пожалуйста, подождите..." />
        <ProgressBar Style="{StaticResource ProgressBarStyle}" />
    </StackPanel>
</Window>