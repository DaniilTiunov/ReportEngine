<Window
    Background="{DynamicResource PrimaryColor}"
    FontFamily="Bahnschrift"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="1050"
    ResizeMode="CanResize"
    Title="Создание и редактирование обвязок"
    Width="950"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.Dialog.ObvSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Window.Resources>
        <converters:ObvyazkaImagePathConverter x:Key="ObvyazkaImagePathConverter" />

    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="0"
            CornerRadius="0"
            GlassFrameThickness="0" />
    </WindowChrome.WindowChrome>

    <Border Style="{DynamicResource WindowBorder}">
        <DockPanel>
            <Border
                Background="#2D2D30"
                DockPanel.Dock="Top"
                Height="34"
                MouseLeftButtonDown="Window_MouseLeftButtonDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Margin="10,0,0,0"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Image
                            Height="18"
                            Margin="0,0,8,0"
                            Source="/Resources/Icons/estimate_cost_icon_213382.ico"
                            Width="18" />
                        <TextBlock
                            FontSize="14"
                            Foreground="White"
                            Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                            VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel
                        Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <Button
                            Click="MinimizeButton_Click"
                            FontSize="16"
                            Height="30"
                            ToolTip="Свернуть"
                            Width="40"
                            x:Name="MinimizeButton">
                            ─
                        </Button>
                        <Button
                            Click="MaxRestoreButton_Click"
                            FontSize="16"
                            Height="30"
                            Margin="10,0,0,0"
                            ToolTip="Развернуть"
                            Width="40"
                            x:Name="MaxRestoreButton">
                            ▢
                        </Button>
                        <Button
                            Click="CloseButton_Click"
                            FontSize="16"
                            Height="30"
                            Margin="10,0,10,0"
                            ToolTip="Закрыть"
                            Width="40"
                            x:Name="CloseButton">
                            ✕
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="700" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="450" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <GroupBox
                        BorderThickness="0"
                        Grid.Column="0"
                        Grid.Row="0"
                        Margin="5">
                        <GroupBox.Header>
                            <TextBlock>
                                <Run
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="Обвязки и датчики в стенде — " />
                                <Run
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(нет данных)'}" />
                            </TextBlock>
                        </GroupBox.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="70" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="30" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="0"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="№ обвязки:"
                                VerticalAlignment="Top" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="0"
                                HorizontalAlignment="Left"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.NN}"
                                VerticalAlignment="Top"
                                Width="50"
                                x:Name="ObvImg" />

                            <TextBlock
                                FontWeight="DemiBold"
                                Grid.Column="1"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Margin="5"
                                Text="Материал" />
                            <TextBlock
                                FontWeight="DemiBold"
                                Grid.Column="2"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Margin="5"
                                Text="Кол-во" />
                            <TextBlock
                                FontWeight="DemiBold"
                                Grid.Column="3"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Margin="5,5,5,5"
                                Text="Ед. изм" />
                            <TextBlock
                                FontWeight="DemiBold"
                                Grid.Column="4"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                Margin="5,5,5,5"
                                Text="Тип материала" />

                            <TextBlock
                                Grid.Column="2"
                                Grid.ColumnSpan="2"
                                Grid.Row="0"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="Тип обвязки:"
                                VerticalAlignment="Top" />
                            <TextBox
                                Grid.Column="4"
                                Grid.Row="0"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.ObvyazkaName}"
                                VerticalAlignment="Top" />
                            <Button
                                Command="{Binding ProjectCommandProvider.SelectObvFromDialogCommand}"
                                Content="..."
                                Grid.Column="5"
                                Grid.Row="0"
                                Height="25"
                                Margin="0,5,0,0"
                                VerticalAlignment="Top"
                                Width="25" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="2"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="Линия:" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="2"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.MaterialLine}" />
                            <TextBox
                                Grid.Column="2"
                                Grid.Row="2"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.MaterialLineCount}"
                                ToolTip="Количество материала линии"
                                Width="50" />
                            <TextBox
                                Grid.Column="3"
                                Grid.Row="2"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.MaterialLineMeasure}"
                                ToolTip="Ед. измерения"
                                Width="50" />

                            <ComboBox
                                Grid.Column="4"
                                Grid.Row="2"
                                Height="25"
                                ItemsSource="{Binding CurrentMaterials.MaterialLineTypes}"
                                Margin="5,5,5,5"
                                SelectedItem="{Binding CurrentMaterials.SelectedMaterialLine, Mode=TwoWay}"
                                Width="140" />

                            <Button
                                Command="{Binding ProjectCommandProvider.SelectMaterialLineDialogCommand}"
                                Content="..."
                                Grid.Column="5"
                                Grid.Row="2"
                                Height="25"
                                Margin="5,0,0,0"
                                Width="25" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="3"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="Арматура:" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="3"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.Armature}" />
                            <TextBox
                                Grid.Column="2"
                                Grid.Row="3"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.ArmatureCount}"
                                ToolTip="Количество арматуры"
                                Width="50" />
                            <TextBox
                                Grid.Column="3"
                                Grid.Row="3"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.ArmatureMeasure}"
                                ToolTip="Ед. измерения"
                                Width="50" />
                            <ComboBox
                                Grid.Column="4"
                                Grid.Row="3"
                                Height="25"
                                ItemsSource="{Binding CurrentMaterials.AramuteresTypes}"
                                Margin="5,5,5,5"
                                SelectedItem="{Binding CurrentMaterials.SelectedAramuteres, Mode=TwoWay}"
                                Width="140" />
                            <Button
                                Command="{Binding ProjectCommandProvider.SelectArmatureDialogCommand}"
                                Content="..."
                                Grid.Column="5"
                                Grid.Row="3"
                                Height="25"
                                Margin="5,0,0,0"
                                Width="25" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="4"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="Тройник:" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="4"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.TreeSocket}" />
                            <TextBox
                                Grid.Column="2"
                                Grid.Row="4"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.TreeSocketMaterialCount}"
                                ToolTip="Количество тройников"
                                Width="50" />
                            <TextBox
                                Grid.Column="3"
                                Grid.Row="4"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.TreeSocketMaterialMeasure}"
                                ToolTip="Ед. измерения"
                                Width="50" />
                            <ComboBox
                                Grid.Column="4"
                                Grid.Row="4"
                                ItemsSource="{Binding CurrentMaterials.TreeSocketTypes}"
                                Margin="5,5,5,5"
                                SelectedItem="{Binding CurrentMaterials.SelectedSocketTypes, Mode=TwoWay}"
                                Width="140" />
                            <Button
                                Command="{Binding ProjectCommandProvider.SelectTreeSocketDialogCommand}"
                                Content="..."
                                Grid.Column="5"
                                Grid.Row="4"
                                Height="25"
                                Margin="5,0,0,0"
                                Width="25" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="5"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="КМЧ:" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="5"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.KMCH}" />
                            <TextBox
                                Grid.Column="2"
                                Grid.Row="5"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.KMCHCount}"
                                ToolTip="Количество КМЧ"
                                Width="50" />
                            <TextBox
                                Grid.Column="3"
                                Grid.Row="5"
                                Height="25"
                                Margin="5,5,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.KMCHMeasure}"
                                ToolTip="Ед. измерения"
                                Width="50" />
                            <ComboBox
                                Grid.Column="4"
                                Grid.Row="5"
                                Height="25"
                                ItemsSource="{Binding CurrentMaterials.KMCHTypes}"
                                Margin="5,5,5,5"
                                SelectedItem="{Binding CurrentMaterials.SelectedKMCHType, Mode=TwoWay}"
                                Width="140" />
                            <Button
                                Command="{Binding ProjectCommandProvider.SelectKMCHDialogCommand}"
                                Content="..."
                                Grid.Column="5"
                                Grid.Row="5"
                                Height="25"
                                Margin="5,0,0,0"
                                Width="25" />

                            <Grid Grid.ColumnSpan="7" Grid.Row="6">
                                <DataGrid
                                    AutoGenerateColumns="False"
                                    BeginningEdit="DataGrid_BeginningEdit"
                                    CanUserAddRows="True"
                                    Height="200"
                                    ItemsSource="{Binding CurrentProjectModel.SelectedStand.ObvyazkaAdditionalComponents}"
                                    LoadingRow="ObvyazkiDataGrid_LoadingRow"
                                    Margin="5"
                                    MouseDoubleClick="DataGrid_MouseDoubleClick"
                                    ScrollViewer.CanContentScroll="True"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                                    SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedObvyazkaAdditionalEquipPurpose}"
                                    x:Name="ObvyazkiDataGrid">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Binding="{Binding Purpose, Mode=TwoWay}"
                                            Header="Назначение"
                                            Width="Auto" />
                                        <DataGridTextColumn
                                            Binding="{Binding Material, Mode=TwoWay}"
                                            Header="Доп.комплектующее"
                                            Width="*" />
                                        <DataGridTextColumn
                                            Binding="{Binding Quantity, Mode=TwoWay}"
                                            Header="Кол-во"
                                            Width="Auto" />
                                        <DataGridTextColumn
                                            Binding="{Binding Measure, Mode=TwoWay}"
                                            Header="Ед. изм."
                                            Width="Auto" />
                                        <DataGridTextColumn
                                            Binding="{Binding CostPerUnit}"
                                            Header="Цена"
                                            Width="Auto" />
                                        <DataGridTemplateColumn Header="Выбрать">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button
                                                        Command="{Binding DataContext.ProjectCommandProvider.OpenAllSortamentsDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Content="Выбрать"
                                                        Margin="2,0,2,0"
                                                        Padding="5,0,5,0"
                                                        Width="Auto" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Command="{Binding ProjectCommandProvider.UpdateAdditionalEquipFromObvCommand}" Header="Сохранить изменения" />
                                            <Separator />
                                            <MenuItem Command="{Binding ProjectCommandProvider.DeleteAdditionalEquipFromObvCommand}" Header="Удалить" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                </DataGrid>
                            </Grid>
                        </Grid>
                    </GroupBox>

                    <Border
                        Background="WhiteSmoke"
                        BorderBrush="LightGray"
                        BorderThickness="1"
                        CornerRadius="4"
                        Grid.Column="1"
                        Grid.Row="0"
                        Height="245"
                        HorizontalAlignment="Right"
                        Margin="0,0,10,195"
                        Padding="6"
                        VerticalAlignment="Bottom"
                        Width="215">
                        <Image
                            MaxHeight="200"
                            MaxWidth="200"
                            Source="{Binding CurrentProjectModel.SelectedStand.ImageName, Converter={StaticResource ObvyazkaImagePathConverter}}"
                            Stretch="Uniform"
                            ToolTip="Изображение обвязки"
                            VerticalAlignment="Top" />
                    </Border>

                    <GroupBox
                        BorderThickness="0"
                        Grid.Row="1"
                        Margin="5,0,5,5"
                        Padding="8">
                        <GroupBox.Header>
                            <TextBlock>
                                <Run
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="Датчики в обвязке" />
                                <Run
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(нет данных)'}" />
                            </TextBlock>
                        </GroupBox.Header>
                        <Grid>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="0"
                                Text="Тип датчика 1:" />
                            <ComboBox
                                Grid.Column="1"
                                Grid.Row="0"
                                ItemsSource="{Binding CurrentProjectModel.SelectedStand.SensorType}"
                                Margin="0,0,200,5"
                                SelectedIndex="1"
                                SelectedItem="{Binding CurrentProjectModel.SelectedStand.FirstSensorType, Mode=TwoWay}"
                                materialDesign:HintAssist.Hint="Выбор типа датчика" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="1"
                                Text="KKS-контура:" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="1"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.FirstSensorKKS}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="2"
                                Text="Маркировка (+):" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="2"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.FirstSensorMarkPlus}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="3"
                                Text="Маркировка (-):" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="3"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.FirstSensorMarkMinus}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="4"
                                Text="Описание:" />
                            <TextBox
                                AcceptsReturn="True"
                                Grid.Column="1"
                                Grid.Row="4"
                                Height="40"
                                Margin="0,0,5,0"
                                Text="{Binding CurrentProjectModel.SelectedStand.FirstSensorDescription}"
                                TextWrapping="Wrap" />
                            <!--  <Border  -->
                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="5"
                                Text="Тип датчика 2:" />
                            <ComboBox
                                Grid.Column="1"
                                Grid.Row="5"
                                ItemsSource="{Binding CurrentProjectModel.SelectedStand.SensorType}"
                                Margin="0,0,200,5"
                                SelectedItem="{Binding CurrentProjectModel.SelectedStand.SecondSensorType}"
                                materialDesign:HintAssist.Hint="Выбор типа датчика" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="6"
                                Text="KKS-контура:" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="6"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.SecondSensorKKS}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="7"
                                Text="Маркировка (+):" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="7"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.SecondSensorMarkPlus}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="8"
                                Text="Маркировка (-):" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="8"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.SecondSensorMarkMinus}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="9"
                                Text="Описание:" />
                            <TextBox
                                AcceptsReturn="True"
                                Grid.Column="1"
                                Grid.Row="9"
                                Height="40"
                                Margin="0,0,5,0"
                                Text="{Binding CurrentProjectModel.SelectedStand.SecondSensorDescription}"
                                TextWrapping="Wrap" />
                            <!--  <Border  -->
                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="10"
                                Text="Тип датчика 3:" />
                            <ComboBox
                                Grid.Column="1"
                                Grid.Row="10"
                                ItemsSource="{Binding CurrentProjectModel.SelectedStand.SensorType}"
                                Margin="0,0,200,5"
                                SelectedItem="{Binding CurrentProjectModel.SelectedStand.ThirdSensorType}"
                                materialDesign:HintAssist.Hint="Выбор типа датчика" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="11"
                                Text="KKS-контура:" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="11"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.ThirdSensorKKS}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="12"
                                Text="Маркировка (+):" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="12"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.ThirdSensorMarkPlus}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="13"
                                Text="Маркировка (-):" />
                            <TextBox
                                Grid.Column="1"
                                Grid.Row="13"
                                Margin="0,0,5,5"
                                Text="{Binding CurrentProjectModel.SelectedStand.ThirdSensorMarkMinus}" />

                            <TextBlock
                                Grid.Column="0"
                                Grid.Row="14"
                                Text="Описание:" />
                            <TextBox
                                AcceptsReturn="True"
                                Grid.Column="1"
                                Grid.Row="14"
                                Height="40"
                                Margin="0,0,5,0"
                                Text="{Binding CurrentProjectModel.SelectedStand.ThirdSensorDescription}"
                                TextWrapping="Wrap" />

                            <UniformGrid
                                Columns="4"
                                Grid.ColumnSpan="2"
                                Grid.Row="15"
                                HorizontalAlignment="Stretch"
                                Margin="10"
                                Rows="1">
                                <Button
                                    Command="{Binding ProjectCommandProvider.SaveObvCommand}"
                                    Content="Добавить&#10;  новую"
                                    Margin="5,0" />
                                <Button
                                    Command="{Binding ProjectCommandProvider.UpdateObvInStandCommand}"
                                    Content="Сохранить &#10;изменения"
                                    Margin="5,0" />
                                <Button
                                    Command="{Binding ProjectCommandProvider.AdditionalTestCommand}"
                                    Content="    Заполнить&#10;доп.компоненты"
                                    Margin="5,0" />
                                <Button
                                    Command="{Binding ProjectCommandProvider.FillMarkInObvCommand}"
                                    Content=" Заполнить&#10;маркировку"
                                    Margin="5,0" />
                            </UniformGrid>
                        </Grid>
                    </GroupBox>

                    <GroupBox
                        BorderThickness="0"
                        Grid.Column="1"
                        Grid.Row="1"
                        Margin="5,0,5,5">
                        <GroupBox.Header>
                            <TextBlock>
                                <Run
                                    FontSize="16"
                                    FontWeight="Bold"
                                    Text="Обвязки в проекте" />
                            </TextBlock>
                        </GroupBox.Header>
                        <DataGrid
                            AutoGenerateColumns="False"
                            IsReadOnly="True"
                            ItemsSource="{Binding CurrentProjectModel.ObvyazkiInProject}"
                            SelectedItem="{Binding CurrentProjectModel.SelectedObvyazkaToCopy}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Binding="{Binding ObvyazkaName}"
                                    Header="Тип"
                                    Width="*" />
                                <DataGridTextColumn
                                    Binding="{Binding MaterialLine}"
                                    Header="Материал"
                                    Width="*" />
                                <DataGridTextColumn
                                    Binding="{Binding Armature}"
                                    Header="Арматура"
                                    Width="*" />
                            </DataGrid.Columns>
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Command="{Binding ProjectCommandProvider.CopyObvyazkaToStandsCommand}" Header="Скопировать в выбранный стенд" />
                                    <Separator />
