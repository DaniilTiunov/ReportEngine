<mah:MetroWindow
    x:Class="ReportEngine.App.Views.Windows.Dialog.ObvSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:converters="clr-namespace:ReportEngine.App.Display"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:enums="clr-namespace:ReportEngine.App.Enums"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    Title="Создание и редактирование обвязок"
    Width="1400"
    Height="900"
    MinWidth="1100"
    MinHeight="650"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    Background="{DynamicResource PrimaryColor}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="False"
    TitleForeground="{DynamicResource PrimaryForeground}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <mah:MetroWindow.Resources>
        <converters:ObvyazkaImagePathConverter x:Key="ObvyazkaImagePathConverter" />

        <DropShadowEffect
            x:Key="WindowShadow"
            BlurRadius="30"
            Opacity="0.25"
            ShadowDepth="0"
            Color="#000000" />

        <Style x:Key="WindowBorder" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryForeground}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Effect" Value="{StaticResource WindowShadow}" />
        </Style>

    </mah:MetroWindow.Resources>



    <DockPanel Background="{DynamicResource PrimaryColor}">
        <Separator DockPanel.Dock="Top" Style="{DynamicResource WindowTitleSeparatorStyle}" />

        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid Margin="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2.4*" MinWidth="760" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Обвязки и датчики в стенде  -->
                <GroupBox
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{DynamicResource SettingsGroupBoxStyle}">
                    <GroupBox.Header>
                        <TextBlock TextWrapping="Wrap">
                            <Run
                                FontSize="16"
                                FontWeight="Bold"
                                Text="Обвязки и датчики в стенде — " />
                            <Run
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(нет данных)'}" />
                        </TextBlock>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="90" />
                            <ColumnDefinition Width="2*" MinWidth="260" />
                            <ColumnDefinition Width="Auto" MinWidth="72" />
                            <ColumnDefinition Width="Auto" MinWidth="82" />
                            <ColumnDefinition Width="Auto" MinWidth="110" />
                            <ColumnDefinition Width="42" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            VerticalAlignment="Top"
                            Text="№ обвязки:" />
                        <TextBox
                            x:Name="ObvImg"
                            Grid.Row="0"
                            Grid.Column="1"
                            Width="50"
                            Margin="5,5,5,5"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Text="{Binding CurrentProjectModel.SelectedStand.NN}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="5"
                            HorizontalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Материал" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="3"
                            Margin="5"
                            HorizontalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Кол-во" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="4"
                            Margin="5,5,5,5"
                            HorizontalAlignment="Center"
                            FontWeight="DemiBold"
                            Text="Ед. изм" />


                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="2"
                            Grid.ColumnSpan="2"
                            HorizontalAlignment="Center"
                            MinHeight="34"
                            VerticalAlignment="Center"
                            Text="Тип обвязки:" />
                        <TextBox
                            Grid.Row="0"
                            Grid.Column="4"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            VerticalAlignment="Top"
                            Text="{Binding CurrentProjectModel.SelectedStand.ObvyazkaName}" />
                        <Button
                            Grid.Row="0"
                            Grid.Column="5"
                            Width="34"
                            MinHeight="34"
                            Margin="0,5,0,0"
                            VerticalAlignment="Top"
                            Command="{Binding ProjectCommandProvider.SelectObvFromDialogCommand}"
                            Content="..." />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="Линия:" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            HorizontalScrollBarVisibility="Auto"
                            Text="{Binding CurrentProjectModel.SelectedStand.MaterialLine}"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CurrentProjectModel.SelectedStand.MaterialLine}" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="3"
                            Width="50"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.MaterialLineCount}"
                            ToolTip="Количество материала линии" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="4"                
                            Width="50"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.MaterialLineMeasure}"
                            ToolTip="Ед. измерения" />

                        <Button
                            Grid.Row="2"
                            Grid.Column="5"
                            Width="34"
                            MaxHeight="34"
                            Margin="5,0,0,0"
                            Command="{Binding ProjectCommandProvider.SelectEquipCommand}"
                            CommandParameter="{x:Static enums:EquipField.Line}"
                            Content="..." />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="Арматура:" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            HorizontalScrollBarVisibility="Auto"
                            Text="{Binding CurrentProjectModel.SelectedStand.Armature}"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CurrentProjectModel.SelectedStand.Armature}" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="3"
                            Width="50"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.ArmatureCount}"
                            ToolTip="Количество арматуры" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="4"
                            Width="50"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.ArmatureMeasure}"
                            ToolTip="Ед. измерения" />
                        
                        <Button
                            Grid.Row="3"
                            Grid.Column="5"
                            Width="34"
                            MaxHeight="34"
                            Margin="5,0,0,0"
                            Command="{Binding ProjectCommandProvider.SelectEquipCommand}"
                            CommandParameter="{x:Static enums:EquipField.Armature}"
                            Content="..." />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="Тройник:" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            VerticalContentAlignment="Center"
                            HorizontalScrollBarVisibility="Auto"
                            Text="{Binding CurrentProjectModel.SelectedStand.TreeSocket}"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CurrentProjectModel.SelectedStand.TreeSocket}" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="3"
                            Width="50"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.TreeSocketMaterialCount}"
                            ToolTip="Количество тройников" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="4"
                            Width="50"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.TreeSocketMaterialMeasure}"
                            ToolTip="Ед. измерения" />
                        
                        <Button
                            Grid.Row="4"
                            Grid.Column="5"
                            Width="34"
                            MaxHeight="34"
                            Margin="5,0,0,0"
                            Command="{Binding ProjectCommandProvider.SelectEquipCommand}"
                            CommandParameter="{x:Static enums:EquipField.TreeSocket}"
                            Content="..." />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="КМЧ:" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="1"
                            Grid.ColumnSpan="2"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            HorizontalScrollBarVisibility="Auto"
                            Text="{Binding CurrentProjectModel.SelectedStand.KMCH}"
                            TextWrapping="NoWrap"
                            ToolTip="{Binding CurrentProjectModel.SelectedStand.KMCH}" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="3"
                            Width="50"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.KMCHCount}"
                            ToolTip="Количество КМЧ" />
                        <TextBox
                            Grid.Row="5"
                            Grid.Column="4"
                            Width="50"
                            MinHeight="34"
                            Margin="5,5,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.KMCHMeasure}"
                            ToolTip="Ед. измерения" />
                        
                        <Button
                            Grid.Row="5"
                            Grid.Column="5"
                            Width="34"
                            MaxHeight="34"
                            Margin="5,0,0,0"
                            Command="{Binding ProjectCommandProvider.SelectEquipCommand}"
                            CommandParameter="{x:Static enums:EquipField.KMCH}"
                            Content="..." />

                        <Grid Grid.Row="6" Grid.ColumnSpan="7">
                            <DataGrid
                                x:Name="ObvyazkiDataGrid"
                                Height="200"
                                Margin="5"
                                AutoGenerateColumns="False"
                                BeginningEdit="DataGrid_BeginningEdit"
                                CanUserAddRows="True"
                                ItemsSource="{Binding CurrentProjectModel.SelectedStand.ObvyazkaAdditionalComponents}"
                                LoadingRow="ObvyazkiDataGrid_LoadingRow"
                                MouseDoubleClick="DataGrid_MouseDoubleClick"
                                ScrollViewer.CanContentScroll="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                SelectedItem="{Binding CurrentProjectModel.SelectedStand.SelectedObvyazkaAdditionalEquipPurpose}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="Auto"
                                        Binding="{Binding Purpose, Mode=TwoWay}"
                                        Header="Назначение" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding Material, Mode=TwoWay}"
                                        Header="Доп.комплектующее" />
                                    <DataGridTextColumn
                                        Width="Auto"
                                        Binding="{Binding Quantity, Mode=TwoWay}"
                                        Header="Кол-во" />
                                    <DataGridTextColumn
                                        Width="Auto"
                                        Binding="{Binding Measure, Mode=TwoWay}"
                                        Header="Ед. изм." />
                                    <DataGridTextColumn
                                        Width="Auto"
                                        Binding="{Binding CostPerUnit}"
                                        Header="Цена" />
                                    <DataGridTemplateColumn Header="Выбрать">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button
                                                    Width="Auto"
                                                    Margin="2,0,2,0"
                                                    Padding="5,0,5,0"
                                                    Command="{Binding DataContext.ProjectCommandProvider.OpenAllSortamentsDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Content="Выбрать" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding ProjectCommandProvider.UpdateAdditionalEquipFromObvCommand}" Header="Сохранить изменения" />
                                        <Separator />
                                        <MenuItem Command="{Binding ProjectCommandProvider.DeleteAdditionalEquipFromObvCommand}" Header="Удалить" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </GroupBox>

                <!--  Изображение обвязки  -->
                <Border
                    Grid.Row="0"
                    Grid.Column="1"
                    Height="245"
                    Margin="10"
                    Padding="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SecondaryColor}"
                    BorderBrush="{DynamicResource BorderColor}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Image
                        MaxWidth="200"
                        MaxHeight="200"
                        VerticalAlignment="Top"
                        Source="{Binding CurrentProjectModel.SelectedStand.ImageName, Converter={StaticResource ObvyazkaImagePathConverter}}"
                        Stretch="Uniform"
                        ToolTip="Изображение обвязки" />
                </Border>

                <!--  Датчики в обвязке  -->
                <GroupBox Grid.Row="1" Style="{DynamicResource SettingsGroupBoxStyle}">
                    <GroupBox.Header>
                        <TextBlock TextWrapping="Wrap">
                            <Run
                                FontSize="16"
                                FontWeight="Bold"
                                Text="Датчики в обвязке" />
                            <Run
                                FontSize="16"
                                FontWeight="Bold"
                                Text="{Binding CurrentProjectModel.SelectedStand.KKSCode, TargetNullValue='(нет данных)'}" />
                        </TextBlock>
                    </GroupBox.Header>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Row="0"
                            Grid.Column="0"
                            Text="Тип датчика 1:" />
                        <ComboBox
                            Grid.Row="0"
                            Grid.Column="1"
                            MinHeight="34"
                            Margin="0,0,5,5"
                            materialDesign:HintAssist.Hint="Выбор типа датчика"
                            ItemsSource="{Binding CurrentProjectModel.SelectedStand.SensorType}"
                            SelectedIndex="1"
                            SelectedItem="{Binding CurrentProjectModel.SelectedStand.FirstSensorType, Mode=TwoWay}" />

                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="0"
                            Text="KKS-контура:" />
                        <TextBox
                            Grid.Row="1"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.FirstSensorKKS}" />

                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="0"
                            Text="Маркировка (+):" />
                        <TextBox
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.FirstSensorMarkPlus}" />

                        <TextBlock
                            Grid.Row="3"
                            Grid.Column="0"
                            Text="Маркировка (-):" />
                        <TextBox
                            Grid.Row="3"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.FirstSensorMarkMinus}" />

                        <TextBlock
                            Grid.Row="4"
                            Grid.Column="0"
                            Text="Описание:" />
                        <TextBox
                            Grid.Row="4"
                            Grid.Column="1"
                            Height="40"
                            Margin="0,0,5,0"
                            AcceptsReturn="True"
                            Text="{Binding CurrentProjectModel.SelectedStand.FirstSensorDescription}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="5"
                            Grid.Column="0"
                            Text="Тип датчика 2:" />
                        <ComboBox
                            Grid.Row="5"
                            Grid.Column="1"
                            MinHeight="34"
                            Margin="0,0,5,5"
                            materialDesign:HintAssist.Hint="Выбор типа датчика"
                            ItemsSource="{Binding CurrentProjectModel.SelectedStand.SensorType}"
                            SelectedItem="{Binding CurrentProjectModel.SelectedStand.SecondSensorType}" />

                        <TextBlock
                            Grid.Row="6"
                            Grid.Column="0"
                            Text="KKS-контура:" />
                        <TextBox
                            Grid.Row="6"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.SecondSensorKKS}" />

                        <TextBlock
                            Grid.Row="7"
                            Grid.Column="0"
                            Text="Маркировка (+):" />
                        <TextBox
                            Grid.Row="7"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.SecondSensorMarkPlus}" />

                        <TextBlock
                            Grid.Row="8"
                            Grid.Column="0"
                            Text="Маркировка (-):" />
                        <TextBox
                            Grid.Row="8"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.SecondSensorMarkMinus}" />

                        <TextBlock
                            Grid.Row="9"
                            Grid.Column="0"
                            Text="Описание:" />
                        <TextBox
                            Grid.Row="9"
                            Grid.Column="1"
                            Height="40"
                            Margin="0,0,5,0"
                            AcceptsReturn="True"
                            Text="{Binding CurrentProjectModel.SelectedStand.SecondSensorDescription}"
                            TextWrapping="Wrap" />

                        <TextBlock
                            Grid.Row="10"
                            Grid.Column="0"
                            Text="Тип датчика 3:" />
                        <ComboBox
                            Grid.Row="10"
                            Grid.Column="1"
                            MinHeight="34"
                            Margin="0,0,5,5"
                            materialDesign:HintAssist.Hint="Выбор типа датчика"
                            ItemsSource="{Binding CurrentProjectModel.SelectedStand.SensorType}"
                            SelectedItem="{Binding CurrentProjectModel.SelectedStand.ThirdSensorType}" />

                        <TextBlock
                            Grid.Row="11"
                            Grid.Column="0"
                            Text="KKS-контура:" />
                        <TextBox
                            Grid.Row="11"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.ThirdSensorKKS}" />

                        <TextBlock
                            Grid.Row="12"
                            Grid.Column="0"
                            Text="Маркировка (+):" />
                        <TextBox
                            Grid.Row="12"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.ThirdSensorMarkPlus}" />

                        <TextBlock
                            Grid.Row="13"
                            Grid.Column="0"
                            Text="Маркировка (-):" />
                        <TextBox
                            Grid.Row="13"
                            Grid.Column="1"
                            Margin="0,0,5,5"
                            Text="{Binding CurrentProjectModel.SelectedStand.ThirdSensorMarkMinus}" />

                        <TextBlock
                            Grid.Row="14"
                            Grid.Column="0"
                            Text="Описание:" />
                        <TextBox
                            Grid.Row="14"
                            Grid.Column="1"
                            Height="40"
                            Margin="0,0,5,0"
                            AcceptsReturn="True"
                            Text="{Binding CurrentProjectModel.SelectedStand.ThirdSensorDescription}"
                            TextWrapping="Wrap" />

                        <WrapPanel
                            Grid.Row="15"
                            Grid.ColumnSpan="2"
                            Margin="10"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                MinWidth="150"
                                Margin="5"
                                Command="{Binding ProjectCommandProvider.SaveObvCommand}"
                                Content="Добавить новую" />
                            <Button
                                MinWidth="170"
                                Margin="5"
                                Command="{Binding ProjectCommandProvider.UpdateObvInStandCommand}"
                                Content="Сохранить изменения" />
                            <Button
                                MinWidth="210"
                                Margin="5"
                                Command="{Binding ProjectCommandProvider.AdditionalTestCommand}"
                                Content="Заполнить доп.компоненты" />
                            <Button
                                MinWidth="190"
                                Margin="5"
                                Command="{Binding ProjectCommandProvider.FillMarkInObvCommand}"
                                Content="Заполнить маркировку" />
                        </WrapPanel>
                    </Grid>
                </GroupBox>

                <!--  Обвязки в проекте  -->
                <GroupBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{DynamicResource SettingsGroupBoxStyle}">
                    <GroupBox.Header>
                        <TextBlock TextWrapping="Wrap">
                            <Run
                                FontSize="16"
                                FontWeight="Bold"
                                Text="Обвязки в проекте" />
                        </TextBlock>
                    </GroupBox.Header>
                    <DataGrid
                        AutoGenerateColumns="False"
                        IsReadOnly="True"
                        ItemsSource="{Binding CurrentProjectModel.ObvyazkiInProject}"
                        SelectedItem="{Binding CurrentProjectModel.SelectedObvyazkaToCopy}">
                        <DataGrid.Columns>
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding ObvyazkaName}"
                                Header="Тип" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding MaterialLine}"
                                Header="Материал" />
                            <DataGridTextColumn
                                Width="*"
                                Binding="{Binding Armature}"
                                Header="Арматура" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Command="{Binding ProjectCommandProvider.CopyObvyazkaToStandsCommand}" Header="Скопировать в выбранный стенд" />
                                <Separator />
                                <MenuItem Command="{Binding ProjectCommandProvider.FillObvFieldsTiEditCommand}" Header="Заполнить поля из этой обвязки" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </GroupBox>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</mah:MetroWindow>
