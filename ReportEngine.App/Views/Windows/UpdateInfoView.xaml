<mah:MetroWindow
    Background="{DynamicResource PrimaryColor}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="600"
    ResizeMode="CanResize"
    ShowIconOnTitleBar="True"
    Title="История обновлений"
    TitleForeground="{DynamicResource PrimaryForeground}"
    Width="1000"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.UpdateInfoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <DockPanel>
        <Separator
            Background="{DynamicResource PrimaryForeground}"
            BorderBrush="{DynamicResource PrimaryForeground}"
            BorderThickness="3"
            DockPanel.Dock="Top"
            Foreground="{DynamicResource PrimaryForeground}"
            Height="3"
            Margin="20,0,20,8" />
        <Grid Margin="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="UpdatesList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Expander
                                Background="{DynamicResource PrimaryColor}"
                                BorderBrush="{DynamicResource BorderColor}"
                                BorderThickness="1"
                                Foreground="{DynamicResource PrimaryForeground}"
                                Margin="0,0,0,10"
                                Padding="10">
                                <Expander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            FontSize="16"
                                            FontWeight="Bold"
                                            Text="{Binding Version}" />
                                        <TextBlock Text="  —  " />
                                        <TextBlock Foreground="{DynamicResource PrimaryForeground}" Text="{Binding Date}" />
                                    </StackPanel>
                                </Expander.Header>

                                <StackPanel Margin="10,5,0,0">
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Margin="0,8,0,4"
                                            Text="Добавлено:" />
                                        <ItemsControl ItemsSource="{Binding Sections.Added}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontWeight="Bold"
                                                            Foreground="{DynamicResource PrimaryForeground}"
                                                            Margin="0,0,6,0"
                                                            Text="• " />
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Margin="0,8,0,4"
                                            Text="Изменено:" />
                                        <ItemsControl ItemsSource="{Binding Sections.Changed}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontWeight="Bold"
                                                            Foreground="{DynamicResource PrimaryForeground}"
                                                            Margin="0,0,6,0"
                                                            Text="• " />
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>

                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock
                                            FontWeight="Bold"
                                            Margin="0,8,0,4"
                                            Text="Исправлено:" />
                                        <ItemsControl ItemsSource="{Binding Sections.Fixed}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,2,0,2" Orientation="Horizontal">
                                                        <TextBlock
                                                            FontWeight="Bold"
                                                            Foreground="{DynamicResource PrimaryForeground}"
                                                            Margin="0,0,6,0"
                                                            Text="• " />
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</mah:MetroWindow>