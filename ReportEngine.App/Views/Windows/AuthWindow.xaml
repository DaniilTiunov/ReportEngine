<mah:MetroWindow
    Background="{DynamicResource PrimaryColor}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="350"
    ResizeMode="NoResize"
    ShowIconOnTitleBar="True"
    Title="Окно авторизации"
    TitleForeground="{DynamicResource PrimaryForeground}"
    Width="600"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    windowHelpers:WindowBehavior.CloseOnEscape="True"
    x:Class="ReportEngine.App.Views.Windows.AuthWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:windowHelpers="clr-namespace:ReportEngine.App.Views.Windows.WindowHelpers"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <mah:MetroWindow.Resources>
        <ResourceDictionary />
    </mah:MetroWindow.Resources>

    <Border Style="{DynamicResource WindowBorder}">
        <DockPanel>
            <!--  Заголовок окна  -->


            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                    <TextBlock Margin="0,0,0,10" Text="Выберите пользователя:" />

                    <ComboBox
                        DisplayMemberPath="UserLogin"
                        ItemsSource="{Binding AllUsers}"
                        SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                        Width="250"
                        x:Name="UserComboBox" />


                    <StackPanel
                        HorizontalAlignment="Center"
                        Margin="0,20,0,0"
                        Orientation="Horizontal">
                        <Button
                            Command="{Binding LoginCommand}"
                            Content="Войти"
                            Margin="0,0,10,0"
                            Width="120" />
                        <Button
                            Command="{Binding ExitCommand}"
                            Content="Выход"
                            Width="120" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</mah:MetroWindow>