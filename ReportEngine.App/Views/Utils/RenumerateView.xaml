<mah:MetroWindow
    Background="{DynamicResource PrimaryColor}"
    FontFamily="{DynamicResource AppFontFamily}"
    FontSize="14"
    Foreground="{DynamicResource PrimaryForeground}"
    Height="200"
    ResizeMode="NoResize"
    ShowIconOnTitleBar="True"
    Title="Нумерация стендов"
    TitleForeground="{DynamicResource PrimaryForeground}"
    Width="400"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d"
    x:Class="ReportEngine.App.Views.Utils.RenumerateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">


    <Border Style="{DynamicResource WindowBorder}">
        <DockPanel>
            <!--  Заголовок окна  -->


            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="25" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="30" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Grid.Row="0"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,5"
                    Text="Выставить серийный номер для стендов" />

                <StackPanel
                    Grid.Column="0"
                    Grid.Row="1"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        Margin="5,5,5,5"
                        Text="c стенда №"
                        VerticalAlignment="Center" />

                    <TextBox
                        HorizontalAlignment="Center"
                        Margin="0,5,0,5"
                        MinWidth="30"
                        Text="{Binding FromNumber, Mode=TwoWay}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Margin="5,5,5,5"
                        Text="по стенд №"
                        VerticalAlignment="Center" />

                    <TextBox
                        HorizontalAlignment="Center"
                        Margin="0,5,5,5"
                        MinWidth="30"
                        Text="{Binding ToNumber, Mode=TwoWay}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Margin="5,5,5,5"
                        Text="включительно"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        Margin="0,5,0,5"
                        Text="по шаблону:" />

                    <TextBox
                        HorizontalAlignment="Center"
                        Margin="5,5,0,5"
                        MinWidth="30"
                        Text="{Binding Prefix, Mode=TwoWay}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Margin="0,5,0,5"
                        Text="значение"
                        VerticalAlignment="Center" />

                    <TextBox
                        HorizontalAlignment="Center"
                        Margin="0,5,5,5"
                        MinWidth="30"
                        Text="{Binding Postfix, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel
                    Grid.Row="3"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">

                    <TextBlock
                        HorizontalAlignment="Center"
                        Margin="0,5,0,5"
                        Text="Стартовое значение:" />

                    <TextBox
                        HorizontalAlignment="Center"
                        Margin="5,5,5,5"
                        MinWidth="30"
                        Text="{Binding StartValue, Mode=TwoWay}"
                        VerticalAlignment="Center" />

                    <TextBlock
                        HorizontalAlignment="Center"
                        Margin="0,5,0,5"
                        Text="Шаг:"
                        VerticalAlignment="Center" />
                    <TextBox
                        HorizontalAlignment="Center"
                        Margin="5,5,5,5"
                        MinWidth="30"
                        Text="{Binding Step, Mode=TwoWay}"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="0" Grid.Row="4">

                    <Button
                        Click="Button_Click"
                        Command="{Binding ApplyCommand}"
                        Content="Применить"
                        HorizontalAlignment="Center"
                        Margin="0,5,0,5"
                        MinHeight="35"
                        MinWidth="100" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</mah:MetroWindow>