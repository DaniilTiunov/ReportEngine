<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KIPARIS_PCM;component/Resources/Dictionaries/Styles/GigaChadUI.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Современная светлая Fluent-палитра: холодные поверхности и чистый синий акцент.  -->

    <!--  Фоны и панели  -->
    <SolidColorBrush Color="#F5F7FB" x:Key="PrimaryColor" />
    <SolidColorBrush Color="#FFFFFF" x:Key="SecondaryColor" />
    <!--  Чистый белый для панелей и карточек  -->

    <!--  Акцент и интерактивные состояния  -->
    <SolidColorBrush Color="#2563EB" x:Key="AccentColor" />
    <SolidColorBrush Color="#2563EB" x:Key="ButtonBackground" />
    <SolidColorBrush Color="#1D4ED8" x:Key="ButtonHoverBackground" />
    <SolidColorBrush Color="#FFFFFF" x:Key="ButtonForeground" />
    <!--  Белый текст на кнопках  -->
    <SolidColorBrush Color="#1E40AF" x:Key="ButtonPressedBackground" />

    <!--  Подложки, границы и наведения  -->
    <SolidColorBrush Color="#DCE3EE" x:Key="BorderColor" />
    <SolidColorBrush Color="#EEF4FF" x:Key="RowHoverColor" />
    <SolidColorBrush Color="#DBEAFE" x:Key="SelectedRowBackground" />
    <SolidColorBrush Color="#1E3A8A" x:Key="SelectedRowForeground" />

    <!--  Тексты  -->
    <SolidColorBrush Color="#172033" x:Key="PrimaryForeground" />
    <SolidColorBrush Color="#5B667A" x:Key="SecondaryForeground" />
    <SolidColorBrush Color="#CBD5E1" x:Key="WindowBorderColor" />

    <!--  Дополнительные состояния  -->
    <SolidColorBrush Color="#E2E8F0" x:Key="ButtonDisabledBackground" />
    <SolidColorBrush Color="#94A3B8" x:Key="ButtonDisabledForeground" />
    <SolidColorBrush Color="#94A3B8" x:Key="DisabledForeground" />
    <SolidColorBrush Color="#E7ECF3" x:Key="BorderLightColor" />
    <SolidColorBrush Color="#CBD5E1" x:Key="BorderMediumColor" />
    <SolidColorBrush Color="#FDE2E2" x:Key="UnsafeDetails" />

    <!--  Стенды (аккуратные и мягкие)  -->
    <SolidColorBrush Color="#FFFFFF" x:Key="StandCardBackground" />
    <SolidColorBrush Color="#DCE3EE" x:Key="StandCardBorder" />
    <SolidColorBrush Color="#F1F5FF" x:Key="StandCardHover" />
    <SolidColorBrush Color="#2563EB" x:Key="StandKKSSColor" />
    <SolidColorBrush Color="#0F8A62" x:Key="StandWeightColor" />
    <SolidColorBrush Color="#64748B" x:Key="StandLabelColor" />
    <SolidColorBrush Color="#DBEAFE" x:Key="StandInContainerSelected" />
    <SolidColorBrush Color="#2563EB" x:Key="StandInContainerBorderSelected" />
    <SolidColorBrush Color="#DCFCE7" x:Key="StandAvailableSelected" />
    <SolidColorBrush Color="#16A36A" x:Key="StandAvailableBorderSelected" />

    <!--  Акценты MaterialDesign-контролов (DataGrid, ComboBox, TreeView и т.д.)  -->
    <SolidColorBrush Color="#2563EB" x:Key="PrimaryHueMidBrush" />
    <SolidColorBrush Color="#1E40AF" x:Key="PrimaryHueDarkBrush" />
</ResourceDictionary>
