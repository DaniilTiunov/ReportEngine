<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KIPARIS_PCM;component/Resources/Dictionaries/Styles/GigaChadUI.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Современная светлая Fluent-палитра: холодные поверхности и чистый синий акцент.  -->

    <!--  Фоны и панели  -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#F5F7FB" />
    <SolidColorBrush x:Key="SecondaryColor" Color="#FFFFFF" />
    <!--  Чистый белый для панелей и карточек  -->

    <!--  Акцент и интерактивные состояния  -->
    <SolidColorBrush x:Key="AccentColor" Color="#2563EB" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#2563EB" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#1D4ED8" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
    <!--  Белый текст на кнопках  -->
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#1E40AF" />

    <!--  Подложки, границы и наведения  -->
    <SolidColorBrush x:Key="BorderColor" Color="#DCE3EE" />
    <SolidColorBrush x:Key="RowHoverColor" Color="#EEF4FF" />
    <SolidColorBrush x:Key="SelectedRowBackground" Color="#DBEAFE" />
    <SolidColorBrush x:Key="SelectedRowForeground" Color="#1E3A8A" />

    <!--  Тексты  -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#172033" />
    <SolidColorBrush x:Key="SecondaryForeground" Color="#5B667A" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#CBD5E1" />

    <!--  Дополнительные состояния  -->
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#E2E8F0" />
    <SolidColorBrush x:Key="ButtonDisabledForeground" Color="#94A3B8" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#94A3B8" />
    <SolidColorBrush x:Key="BorderLightColor" Color="#E7ECF3" />
    <SolidColorBrush x:Key="BorderMediumColor" Color="#CBD5E1" />
    <SolidColorBrush x:Key="UnsafeDetails" Color="#FDE2E2" />

    <!--  Стенды (аккуратные и мягкие)  -->
    <SolidColorBrush x:Key="StandCardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StandCardBorder" Color="#DCE3EE" />
    <SolidColorBrush x:Key="StandCardHover" Color="#F1F5FF" />
    <SolidColorBrush x:Key="StandKKSSColor" Color="#2563EB" />
    <SolidColorBrush x:Key="StandWeightColor" Color="#0F8A62" />
    <SolidColorBrush x:Key="StandLabelColor" Color="#64748B" />
    <SolidColorBrush x:Key="StandInContainerSelected" Color="#DBEAFE" />
    <SolidColorBrush x:Key="StandInContainerBorderSelected" Color="#2563EB" />
    <SolidColorBrush x:Key="StandAvailableSelected" Color="#DCFCE7" />
    <SolidColorBrush x:Key="StandAvailableBorderSelected" Color="#16A36A" />

    <!--  Акценты MaterialDesign-контролов (DataGrid, ComboBox, TreeView и т.д.)  -->
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#1E40AF" />
</ResourceDictionary>
