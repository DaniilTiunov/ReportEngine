<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/ReportEngine.App;component/Resources/Dictionaries/Styles/GigaChadUI.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Тёмная тема  -->
    <SolidColorBrush Color="#1E1E1E" x:Key="PrimaryColor" />
    <!--  фон окна  -->
    <SolidColorBrush Color="#2B2B2B" x:Key="SecondaryColor" />
    <!--  панели, подложки  -->
    <SolidColorBrush Color="#5C6BC0" x:Key="AccentColor" />
    <!--  акценты (кнопки, выделения)  -->
    <SolidColorBrush Color="#3A3A3A" x:Key="BorderColor" />
    <!--  рамки  -->
    <SolidColorBrush Color="#333333" x:Key="RowHoverColor" />
    <!--  наведение  -->
    <SolidColorBrush Color="#444444" x:Key="SelectedRowBackground" />
    <SolidColorBrush Color="#FFFFFF" x:Key="SelectedRowForeground" />
    <SolidColorBrush Color="#E0E0E0" x:Key="PrimaryForeground" />
    <!--  основной текст  -->
    <SolidColorBrush Color="#B0B0B0" x:Key="SecondaryForeground" />
    <!--  второстепенный текст  -->
    <SolidColorBrush Color="#4A4A4A" x:Key="WindowBorderColor" />
    <SolidColorBrush Color="#3A3A3A" x:Key="ButtonBackground" />
    <SolidColorBrush Color="#B0B0B0" x:Key="ButtonForeground" />
    <SolidColorBrush Color="#555555" x:Key="ButtonHoverBackground" />
    <SolidColorBrush Color="#666666" x:Key="ButtonPressedBackground" />
    <SolidColorBrush Color="#2A2A2A" x:Key="ButtonDisabledBackground" />
    <SolidColorBrush Color="#777777" x:Key="ButtonDisabledForeground" />
    <SolidColorBrush Color="#888888" x:Key="DisabledForeground" />

    <SolidColorBrush Color="#2B2B2B" x:Key="ControlLightColor" />
    <SolidColorBrush Color="#E0E0E0" x:Key="ControlMouseOverColor" />
    <SolidColorBrush Color="#FF184461" x:Key="ControlPressedColor" />
    <SolidColorBrush Color="#FFCCCCCC" x:Key="BorderLightColor" />
    <SolidColorBrush Color="#3A3A3A" x:Key="BorderMediumColor" />
    <SolidColorBrush Color="#5C6BC0" x:Key="GlyphColor" />
    <SolidColorBrush Color="#666666" x:Key="SelectedBackgroundColor" />
    <SolidColorBrush Color="#FF888888" x:Key="DisabledForegroundColor" />
    <SolidColorBrush Color="#FFDDDDDD" x:Key="DisabledControlDarkColor" />
    <SolidColorBrush Color="#383F45" x:Key="UnsafeDetails" />

    <SolidColorBrush Color="#2D2D2D" x:Key="StandCardBackground" />
    <SolidColorBrush Color="#555555" x:Key="StandCardBorder" />
    <SolidColorBrush Color="#3D3D3D" x:Key="StandCardHover" />
    <SolidColorBrush Color="#64B5F6" x:Key="StandKKSSColor" />
    <SolidColorBrush Color="#81C784" x:Key="StandWeightColor" />
    <SolidColorBrush Color="#AAAAAA" x:Key="StandLabelColor" />
    <SolidColorBrush Color="#1A3A5C" x:Key="StandInContainerSelected" />
    <SolidColorBrush Color="#4A9EFF" x:Key="StandInContainerBorderSelected" />
    <SolidColorBrush Color="#1A3A2A" x:Key="StandAvailableSelected" />
    <SolidColorBrush Color="#66BB6A" x:Key="StandAvailableBorderSelected" />
</ResourceDictionary>