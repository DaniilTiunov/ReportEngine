<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KIPARIS_PCM;component/Resources/Dictionaries/Styles/GigaChadUI.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Современная тёмная Fluent-палитра: slate-поверхности и мягкий синий акцент.  -->

    <!--  Фоны и панели  -->
    <SolidColorBrush Color="#0B1120" x:Key="PrimaryColor" />
    <SolidColorBrush Color="#111827" x:Key="SecondaryColor" />

    <!--  Акценты и кнопки (Яркий Indigo, но не кислотный)  -->
    <SolidColorBrush Color="#60A5FA" x:Key="AccentColor" />
    <SolidColorBrush Color="#2563EB" x:Key="ButtonBackground" />
    <SolidColorBrush Color="#3B82F6" x:Key="ButtonHoverBackground" />
    <SolidColorBrush Color="#FFFFFF" x:Key="ButtonForeground" />
    <!--  Белый текст  -->
    <SolidColorBrush Color="#1D4ED8" x:Key="ButtonPressedBackground" />

    <!--  Границы и наведения  -->
    <SolidColorBrush Color="#263244" x:Key="BorderColor" />
    <SolidColorBrush Color="#18243A" x:Key="RowHoverColor" />
    <SolidColorBrush Color="#1E3A5F" x:Key="SelectedRowBackground" />
    <SolidColorBrush Color="#DBEAFE" x:Key="SelectedRowForeground" />

    <!--  Тексты  -->
    <SolidColorBrush Color="#F1F5F9" x:Key="PrimaryForeground" />
    <SolidColorBrush Color="#9AA7BA" x:Key="SecondaryForeground" />
    <SolidColorBrush Color="#334155" x:Key="WindowBorderColor" />

    <!--  Дополнительные состояния  -->
    <SolidColorBrush Color="#1E293B" x:Key="ButtonDisabledBackground" />
    <SolidColorBrush Color="#64748B" x:Key="ButtonDisabledForeground" />
    <SolidColorBrush Color="#64748B" x:Key="DisabledForeground" />
    <SolidColorBrush Color="#1B2638" x:Key="BorderLightColor" />
    <SolidColorBrush Color="#334155" x:Key="BorderMediumColor" />
    <SolidColorBrush Color="#4C2730" x:Key="UnsafeDetails" />

    <!--  Стенды (тёмные карточки с мягким свечением)  -->
    <SolidColorBrush Color="#111C2E" x:Key="StandCardBackground" />
    <SolidColorBrush Color="#2A3850" x:Key="StandCardBorder" />
    <SolidColorBrush Color="#17243A" x:Key="StandCardHover" />
    <SolidColorBrush Color="#60A5FA" x:Key="StandKKSSColor" />
    <SolidColorBrush Color="#34D399" x:Key="StandWeightColor" />
    <SolidColorBrush Color="#9AA7BA" x:Key="StandLabelColor" />
    <SolidColorBrush Color="#1E3A5F" x:Key="StandInContainerSelected" />
    <SolidColorBrush Color="#60A5FA" x:Key="StandInContainerBorderSelected" />
    <SolidColorBrush Color="#12372A" x:Key="StandAvailableSelected" />
    <SolidColorBrush Color="#34D399" x:Key="StandAvailableBorderSelected" />

    <!--  Акценты MaterialDesign-контролов (DataGrid, ComboBox, TreeView и т.д.)  -->
    <SolidColorBrush Color="#60A5FA" x:Key="PrimaryHueMidBrush" />
    <SolidColorBrush Color="#2563EB" x:Key="PrimaryHueDarkBrush" />
</ResourceDictionary>
