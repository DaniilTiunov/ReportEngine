<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KIPARIS_PCM;component/Resources/Dictionaries/Styles/GigaChadUI.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Тёмная тема (Modern Dark Indigo)  -->

    <!--  Фоны и панели  -->
    <SolidColorBrush Color="#14161F" x:Key="PrimaryColor" />
    <!--  Основной фон: глубокий графит с синевой  -->
    <SolidColorBrush Color="#1E202B" x:Key="SecondaryColor" />
    <!--  Панели/подложки: чуть светлее, холодный графит  -->

    <!--  Акценты и кнопки (Яркий Indigo, но не кислотный)  -->
    <SolidColorBrush Color="#7C8BFF" x:Key="AccentColor" />
    <!--  Основной акцент: яркий индиго для тёмного фона  -->
    <SolidColorBrush Color="#3943A8" x:Key="ButtonBackground" />
    <!--  Кнопка в покое: глубокий индиго  -->
    <SolidColorBrush Color="#4A55C9" x:Key="ButtonHoverBackground" />
    <!--  При наведении: ярче  -->
    <SolidColorBrush Color="#FFFFFF" x:Key="ButtonForeground" />
    <!--  Белый текст  -->
    <SolidColorBrush Color="#2E3585" x:Key="ButtonPressedBackground" />
    <!--  При нажатии: темнее  -->

    <!--  Границы и наведения  -->
    <SolidColorBrush Color="#333A4A" x:Key="BorderColor" />
    <!--  Рамки: холодный темный графит  -->
    <SolidColorBrush Color="#2A2E3D" x:Key="RowHoverColor" />
    <!--  Мягкое холодное наведение  -->
    <SolidColorBrush Color="#4A55C9" x:Key="SelectedRowBackground" />
    <!--  Выделение строк: насыщенный индиго  -->
    <SolidColorBrush Color="#FFFFFF" x:Key="SelectedRowForeground" />

    <!--  Тексты  -->
    <SolidColorBrush Color="#E6E8F0" x:Key="PrimaryForeground" />
    <!--  Основной текст: мягкий белый  -->
    <SolidColorBrush Color="#9CA1B5" x:Key="SecondaryForeground" />
    <!--  Второстепенный текст: холодный серый  -->
    <SolidColorBrush Color="#4A4A5A" x:Key="WindowBorderColor" />

    <!--  Дополнительные состояния  -->
    <SolidColorBrush Color="#2A2E3D" x:Key="ButtonDisabledBackground" />
    <SolidColorBrush Color="#6A7082" x:Key="ButtonDisabledForeground" />
    <SolidColorBrush Color="#7A8093" x:Key="DisabledForeground" />
    <SolidColorBrush Color="#1E202B" x:Key="ControlLightColor" />
    <SolidColorBrush Color="#2A2E3D" x:Key="ControlMouseOverColor" />
    <SolidColorBrush Color="#4A55C9" x:Key="ControlPressedColor" />
    <SolidColorBrush Color="#333A4A" x:Key="BorderLightColor" />
    <SolidColorBrush Color="#3F465A" x:Key="BorderMediumColor" />
    <SolidColorBrush Color="#7C8BFF" x:Key="GlyphColor" />
    <SolidColorBrush Color="#4A55C9" x:Key="SelectedBackgroundColor" />
    <SolidColorBrush Color="#7A8093" x:Key="DisabledForegroundColor" />
    <SolidColorBrush Color="#333A4A" x:Key="DisabledControlDarkColor" />
    <SolidColorBrush Color="#525B6E" x:Key="UnsafeDetails" />

    <!--  Стенды (тёмные карточки с мягким свечением)  -->
    <SolidColorBrush Color="#232632" x:Key="StandCardBackground" />
    <SolidColorBrush Color="#3A4052" x:Key="StandCardBorder" />
    <SolidColorBrush Color="#2C3040" x:Key="StandCardHover" />
    <SolidColorBrush Color="#8A9BFF" x:Key="StandKKSSColor" />
    <!--  KKS: яркий индиго  -->
    <SolidColorBrush Color="#5BD587" x:Key="StandWeightColor" />
    <!--  Вес: свежий мятный зеленый  -->
    <SolidColorBrush Color="#9CA1B5" x:Key="StandLabelColor" />
    <SolidColorBrush Color="#2B3B5E" x:Key="StandInContainerSelected" />
    <SolidColorBrush Color="#7C8BFF" x:Key="StandInContainerBorderSelected" />
    <SolidColorBrush Color="#1E3E2C" x:Key="StandAvailableSelected" />
    <SolidColorBrush Color="#5BD587" x:Key="StandAvailableBorderSelected" />

    <!--  Акценты MaterialDesign-контролов (DataGrid, ComboBox, TreeView и т.д.)  -->
    <SolidColorBrush Color="#7C8BFF" x:Key="PrimaryHueMidBrush" />
    <SolidColorBrush Color="#5A64D5" x:Key="PrimaryHueDarkBrush" />
</ResourceDictionary>