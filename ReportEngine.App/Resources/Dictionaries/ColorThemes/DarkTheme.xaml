<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/KIPARIS_PCM;component/Resources/Dictionaries/Styles/GigaChadUI.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Современная тёмная Fluent-палитра: slate-поверхности и мягкий синий акцент.  -->

    <!--  Фоны и панели  -->
    <SolidColorBrush x:Key="PrimaryColor" Color="#0B1120" />
    <SolidColorBrush x:Key="SecondaryColor" Color="#111827" />

    <!--  Акценты и кнопки (Яркий Indigo, но не кислотный)  -->
    <SolidColorBrush x:Key="AccentColor" Color="#60A5FA" />
    <SolidColorBrush x:Key="ButtonBackground" Color="#2563EB" />
    <SolidColorBrush x:Key="ButtonHoverBackground" Color="#3B82F6" />
    <SolidColorBrush x:Key="ButtonForeground" Color="#FFFFFF" />
    <!--  Белый текст  -->
    <SolidColorBrush x:Key="ButtonPressedBackground" Color="#1D4ED8" />

    <!--  Границы и наведения  -->
    <SolidColorBrush x:Key="BorderColor" Color="#263244" />
    <SolidColorBrush x:Key="RowHoverColor" Color="#18243A" />
    <SolidColorBrush x:Key="SelectedRowBackground" Color="#1E3A5F" />
    <SolidColorBrush x:Key="SelectedRowForeground" Color="#DBEAFE" />

    <!--  Тексты  -->
    <SolidColorBrush x:Key="PrimaryForeground" Color="#F1F5F9" />
    <SolidColorBrush x:Key="SecondaryForeground" Color="#9AA7BA" />
    <SolidColorBrush x:Key="WindowBorderColor" Color="#334155" />

    <!--  Дополнительные состояния  -->
    <SolidColorBrush x:Key="ButtonDisabledBackground" Color="#1E293B" />
    <SolidColorBrush x:Key="ButtonDisabledForeground" Color="#64748B" />
    <SolidColorBrush x:Key="DisabledForeground" Color="#64748B" />
    <SolidColorBrush x:Key="BorderLightColor" Color="#1B2638" />
    <SolidColorBrush x:Key="BorderMediumColor" Color="#334155" />
    <SolidColorBrush x:Key="UnsafeDetails" Color="#4C2730" />

    <!--  Стенды (тёмные карточки с мягким свечением)  -->
    <SolidColorBrush x:Key="StandCardBackground" Color="#111C2E" />
    <SolidColorBrush x:Key="StandCardBorder" Color="#2A3850" />
    <SolidColorBrush x:Key="StandCardHover" Color="#17243A" />
    <SolidColorBrush x:Key="StandKKSSColor" Color="#60A5FA" />
    <SolidColorBrush x:Key="StandWeightColor" Color="#34D399" />
    <SolidColorBrush x:Key="StandLabelColor" Color="#9AA7BA" />
    <SolidColorBrush x:Key="StandInContainerSelected" Color="#1E3A5F" />
    <SolidColorBrush x:Key="StandInContainerBorderSelected" Color="#60A5FA" />
    <SolidColorBrush x:Key="StandAvailableSelected" Color="#12372A" />
    <SolidColorBrush x:Key="StandAvailableBorderSelected" Color="#34D399" />

    <!--  Акценты MaterialDesign-контролов (DataGrid, ComboBox, TreeView и т.д.)  -->
    <SolidColorBrush x:Key="PrimaryHueMidBrush" Color="#60A5FA" />
    <SolidColorBrush x:Key="PrimaryHueDarkBrush" Color="#2563EB" />
</ResourceDictionary>
