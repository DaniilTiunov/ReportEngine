<UserControl
    x:Class="ReportEngine.Updater.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="⚙️ Настройки" />
            <TextBlock
                FontSize="13"
                Foreground="#666"
                Text="Настройка путей и параметров обновления" />
        </StackPanel>

        <!--  Настройки  -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,0,20">

                <!--  Путь к серверу  -->
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,0,0,5"
                    Text="Путь к серверу с релизами" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Text="{Binding RemotePath}" />
                    <Button
                        Command="{Binding BrowseServerCommand}"
                        Content="Обзор..."
                        Grid.Column="1"
                        Padding="15,8" />
                </Grid>

                <!--  Путь к локальным версиям  -->
                <TextBlock
                    FontWeight="SemiBold"
                    Margin="0,15,0,5"
                    Text="Локальная папка для версий" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Margin="0,0,10,0"
                        Text="{Binding LocalPath}" />
                    <Button
                        Command="{Binding BrowseLocalCommand}"
                        Content="Обзор..."
                        Grid.Column="1"
                        Padding="15,8" />
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                </Grid>

                <!--  Информация  -->
                <Border
                    Background="#FFF9C4"
                    CornerRadius="4"
                    Margin="0,20,0,0"
                    Padding="15">
                    <TextBlock
                        FontSize="12"
                        Foreground="#666"
                        Text="⚠️ Изменение путей может повлиять на работу обновлений.                                      Убедитесь, что новые пути корректны."
                        TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--  Кнопки  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            Orientation="Horizontal">
            <Button
                Background="#4CAF50"
                Command="{Binding SaveCommand}"
                Content="💾 Сохранить настройки"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White"
                Padding="30,10" />

            <Button
                Background="#FF9800"
                Command="{Binding ResetCommand}"
                Content="🔄 Сбросить"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="10,0,0,0"
                Padding="20,10" />
        </StackPanel>
    </Grid>
</UserControl>