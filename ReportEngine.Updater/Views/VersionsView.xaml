<UserControl
    x:Class="ReportEngine.Updater.Views.VersionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="📋 Список доступных версий" />
            <TextBlock
                FontSize="13"
                Foreground="#666"
                Text="Выберите версию для установки" />
        </StackPanel>

        <!--  Основной контент: список версий + детали  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Левая колонка: список версий  -->
            <ListView
                Grid.Column="0"
                ItemsSource="{Binding Releases}"
                Margin="0,0,10,0"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedRelease}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  Версия  -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock FontSize="16" Text="📦 " />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding Info.Version}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!--  Дата  -->
                                <TextBlock
                                    FontSize="12"
                                    Foreground="#999"
                                    Grid.Column="2"
                                    Text="{Binding Info.Date, StringFormat='dd.MM.yyyy'}"
                                    VerticalAlignment="Center" />

                                <TextBlock
                                    FontSize="12"
                                    Foreground="#999"
                                    Grid.Column="3"
                                    HorizontalAlignment="Stretch"
                                    Text="{Binding Path}"
                                    VerticalAlignment="Stretch" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Правая колонка: детальная информация  -->
            <Border
                Background="#F8F9FA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Column="1"
                Margin="10,0,0,0"
                Padding="15">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  Заголовок деталей  -->
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#333"
                            Margin="0,0,0,15"
                            Text="📄 Детали версии" />

                        <!--  Информация о выбранной версии  -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#666"
                                Grid.Column="0"
                                Grid.Row="0"
                                Margin="0,0,10,5"
                                Text="Версия:" />
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="#333"
                                Grid.Column="1"
                                Grid.Row="0"
                                Margin="0,0,0,5"
                                Text="{Binding SelectedRelease.Info.Version, FallbackValue='Не выбрано'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#666"
                                Grid.Column="0"
                                Grid.Row="1"
                                Margin="0,0,10,0"
                                Text="Дата:" />
                            <TextBlock
                                Foreground="#333"
                                Grid.Column="1"
                                Grid.Row="1"
                                Text="{Binding SelectedRelease.Info.Date, StringFormat='dd.MM.yyyy', FallbackValue='—'}" />
                        </Grid>

                        <!--  Разделитель  -->
                        <Border
                            Background="#E0E0E0"
                            Height="1"
                            Margin="0,0,0,15" />

                        <!--  Секция Added  -->
                        <Border
                            Background="#E8F5E9"
                            CornerRadius="4"
                            Margin="0,0,0,8"
                            Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="14"
                                    Grid.Column="0"
                                    Text="✅ "
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="#2E7D32"
                                    Grid.Column="1"
                                    Text="Добавлено" />
                            </Grid>
                        </Border>

                        <ItemsControl ItemsSource="{Binding SelectedRelease.Info.Sections.Added}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="#333"
                                        Margin="10,2,0,2"
                                        TextWrapping="Wrap">
                                        <Run Text="• " /><Run Text="{Binding Path=., Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Секция Changed  -->
                        <Border
                            Background="#FFF3E0"
                            CornerRadius="4"
                            Margin="0,0,0,8"
                            Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="14"
                                    Grid.Column="0"
                                    Text="🔄 "
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="#E65100"
                                    Grid.Column="1"
                                    Text="Изменено" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding SelectedRelease.Info.Sections.Changed}" Margin="0,0,0,12">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="#333"
                                        Margin="10,2,0,2"
                                        TextWrapping="Wrap">
                                        <Run Text="• " /><Run Text="{Binding Path=., Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Секция Fixed  -->
                        <Border
                            Background="#E3F2FD"
                            CornerRadius="4"
                            Margin="0,0,0,8"
                            Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="14"
                                    Grid.Column="0"
                                    Text="🐛 "
                                    VerticalAlignment="Center" />
                                <TextBlock
                                    FontWeight="Bold"
                                    Foreground="#0D47A1"
                                    Grid.Column="1"
                                    Text="Исправлено" />
                            </Grid>
                        </Border>
                        <ItemsControl ItemsSource="{Binding SelectedRelease.Info.Sections.Fixed}" Margin="0,0,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock
                                        FontSize="13"
                                        Foreground="#333"
                                        Margin="10,2,0,2"
                                        TextWrapping="Wrap">
                                        <Run Text="• " /><Run Text="{Binding Path=., Mode=OneWay}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!--  Сообщение, если ничего не выбрано  -->
                        <TextBlock
                            FontSize="14"
                            Foreground="#999"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0"
                            Text="Выберите версию из списка слева"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  Кнопки действий  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            Orientation="Horizontal">

            <Button
                Background="#4CAF50"
                Command="{Binding InstallCommand}"
                Content="⬇️ Установить выбранную версию"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White"
                Padding="25,10" />

            <Button
                Background="#2196F3"
                Command="{Binding RefreshCommand}"
                Content="🔄 Обновить список"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="10,0,0,0"
                Padding="20,10" />
        </StackPanel>
    </Grid>
</UserControl>