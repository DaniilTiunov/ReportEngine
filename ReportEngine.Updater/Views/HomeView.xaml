<UserControl
    x:Class="ReportEngine.Updater.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <StackPanel>
        <!--  Заголовок  -->
        <TextBlock
            FontSize="22"
            FontWeight="Bold"
            Margin="0,0,0,10"
            Text="Добро пожаловать в Менеджер Стенды КИПиА" />

        <TextBlock
            FontSize="14"
            Foreground="#666"
            Margin="0,0,0,30"
            Text="Управление обновлениями приложения" />

        <!--  Информационные карточки  -->
        <Grid Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Карточка 1: Текущая версия  -->
            <Border
                Background="#E3F2FD"
                CornerRadius="8"
                Margin="0,0,10,0"
                Padding="15">
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="#666"
                        Text="📌 Текущая версия" />
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#1976D2"
                        Text="{Binding CurrentVersion}" />
                </StackPanel>
            </Border>

            <!--  Карточка 2: Доступно обновлений  -->
            <Border
                Background="#E8F5E9"
                CornerRadius="8"
                Margin="5,0,5,0"
                Padding="15">
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="#666"
                        Text="📦 Доступно версий" />
                    <TextBlock
                        FontSize="24"
                        FontWeight="Bold"
                        Foreground="#388E3C"
                        Text="{Binding ReleasesCount}" />
                </StackPanel>
            </Border>

            <!--  Карточка 3: Статус  -->
            <Border
                Background="#FFF3E0"
                CornerRadius="8"
                Margin="10,0,0,0"
                Padding="15">
                <StackPanel>
                    <TextBlock
                        FontSize="12"
                        Foreground="#666"
                        Text="⚡ Статус" />
                    <TextBlock
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="#E65100"
                        Text="{Binding Status}" />
                </StackPanel>
            </Border>
        </Grid>

        <!--  Кнопки действий  -->
        <StackPanel Margin="0,0,0,20" Orientation="Horizontal">
            <Button
                Background="#4CAF50"
                Command="{Binding UpdateToLatestCommand}"
                Content="🔄 Обновить до последней версии"
                Cursor="Hand"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Padding="30,12" />

            <Button
                Background="#2196F3"
                Command="{Binding ViewVersionsCommand}"
                Content="📋 Посмотреть все версии"
                Cursor="Hand"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="10,0,0,0"
                Padding="20,12" />

            <Button
                Background="#FF9800"
                Command="{Binding ViewHistoryCommand}"
                Content="📜 История"
                Cursor="Hand"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="10,0,0,0"
                Padding="20,12" />
        </StackPanel>

        <!--  Последние обновления  -->
        <Border
            Background="#F5F5F5"
            CornerRadius="8"
            Margin="0,20,0,0"
            Padding="15">
            <StackPanel>
                <TextBlock
                    FontSize="14"
                    FontWeight="SemiBold"
                    Margin="0,0,0,10"
                    Text="📋 Последние обновления" />

                <ItemsControl ItemsSource="{Binding RecentReleases}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border
                                Background="White"
                                CornerRadius="4"
                                Margin="0,2"
                                Padding="8,5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock
                                        FontWeight="Bold"
                                        Foreground="#2196F3"
                                        Grid.Column="0"
                                        Text="{Binding Version}" />

                                    <TextBlock
                                        Foreground="#666"
                                        Grid.Column="1"
                                        Margin="15,0,15,0"
                                        Text="{Binding Changelog}" />

                                    <TextBlock
                                        FontSize="12"
                                        Foreground="#999"
                                        Grid.Column="2"
                                        Text="{Binding Date, StringFormat='dd.MM.yyyy'}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>