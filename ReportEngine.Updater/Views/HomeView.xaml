<UserControl
    x:Class="ReportEngine.Updater.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,0,20">

            <!--  Заголовок  -->
            <TextBlock
                FontSize="22"
                FontWeight="Bold"
                Margin="0,0,0,5"
                Text="🏠 Добро пожаловать в Менеджер Стенды КИПиА" />

            <TextBlock
                FontSize="14"
                Foreground="#666"
                Margin="0,0,0,25"
                Text="Управление обновлениями приложения" />

            <!--  Информация о последней версии  -->
            <Border
                Background="#F0F4FF"
                CornerRadius="8"
                Margin="0,0,0,20"
                Padding="20">

                <StackPanel>
                    <TextBlock
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="#666"
                        Text="📌 Последняя версия" />

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#1976D2"
                        Text="{Binding LatestInfo.Version, FallbackValue='—'}" />

                    <TextBlock
                        FontSize="13"
                        Foreground="#999"
                        Text="Канал релиза" />

                    <TextBlock
                        FontSize="28"
                        FontWeight="Bold"
                        Foreground="#1976D2"
                        Text="{Binding LatestInfo.Channel, FallbackValue='—'}" />

                    <TextBlock
                        FontSize="13"
                        Foreground="#999"
                        Text="{Binding LatestInfo.Date, StringFormat='Опубликовано: dd.MM.yyyy', FallbackValue='Опубликовано: —'}" />
                </StackPanel>
            </Border>

            <!--  Изменения  -->
            <TextBlock
                FontSize="16"
                FontWeight="SemiBold"
                Margin="0,0,0,10"
                Text="📋 Что нового" />

            <!--  Added  -->
            <Border
                Background="#E8F5E9"
                CornerRadius="4"
                Margin="0,0,0,8"
                Padding="10,6">
                <TextBlock
                    FontWeight="Bold"
                    Foreground="#2E7D32"
                    Text="✅ Добавлено" />
            </Border>
            <ItemsControl ItemsSource="{Binding LatestInfo.Sections.Added}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontSize="13"
                            Foreground="#333"
                            Margin="20,3,0,3"
                            TextWrapping="Wrap">
                            <Run Text="• " /><Run Text="{Binding Path=., Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Changed  -->
            <Border
                Background="#FFF3E0"
                CornerRadius="4"
                Margin="0,0,0,8"
                Padding="10,6">
                <TextBlock
                    FontWeight="Bold"
                    Foreground="#E65100"
                    Text="🔄 Изменено" />
            </Border>
            <ItemsControl ItemsSource="{Binding LatestInfo.Sections.Changed}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontSize="13"
                            Foreground="#333"
                            Margin="20,3,0,3"
                            TextWrapping="Wrap">
                            <Run Text="• " /><Run Text="{Binding Path=., Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Fixed  -->
            <Border
                Background="#E3F2FD"
                CornerRadius="4"
                Margin="0,0,0,8"
                Padding="10,6">
                <TextBlock
                    FontWeight="Bold"
                    Foreground="#0D47A1"
                    Text="🐛 Исправлено" />
            </Border>
            <ItemsControl ItemsSource="{Binding LatestInfo.Sections.Fixed}" Margin="0,0,0,12">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock
                            FontSize="13"
                            Foreground="#333"
                            Margin="20,3,0,3"
                            TextWrapping="Wrap">
                            <Run Text="• " /><Run Text="{Binding Path=., Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Кнопки действий  -->
            <StackPanel Margin="0,20,0,0" Orientation="Horizontal">
                <Button
                    Background="#2196F3"
                    Command="{Binding NavigateCommand}"
                    CommandParameter="Versions"
                    Content="📋 Все версии"
                    Cursor="Hand"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Padding="20,10" />

                <Button
                    Background="#4CAF50"
                    Command="{Binding CheckForUpdatesCommand}"
                    Content="🔄 Проверить обновления"
                    Cursor="Hand"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="White"
                    Margin="10,0,0,0"
                    Padding="20,10" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>