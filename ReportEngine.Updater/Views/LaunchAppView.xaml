<UserControl
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d"
    x:Class="ReportEngine.Updater.Views.LaunchAppView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Заголовок  -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock
                FontSize="20"
                FontWeight="Bold"
                Text="🚀 Запуск приложений" />
            <TextBlock
                FontSize="13"
                Foreground="#666"
                Text="Выберите приложение для запуска" />
        </StackPanel>

        <!--  Основной контент: список приложений + детали  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Левая колонка: список приложений  -->
            <ListView
                Grid.Column="0"
                ItemsSource="{Binding LocalReleases}"
                Margin="0,0,10,0"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectedItem="{Binding SelectedRelease}">

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,2" Padding="12,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="120" />
                                </Grid.ColumnDefinitions>

                                <!--  Канал  -->
                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <TextBlock FontSize="16" Text="📦 " />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding Info.Channel}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!--  Версия  -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock FontSize="16" Text="v" />
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="Bold"
                                        Text="{Binding Info.Version}"
                                        VerticalAlignment="Center" />
                                </StackPanel>

                                <!--  Дата  -->
                                <TextBlock
                                    FontSize="16"
                                    Foreground="#999"
                                    Grid.Column="2"
                                    Text="{Binding Info.Date, StringFormat='dd.MM.yyyy'}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!--  Правая колонка: детальная информация  -->
            <Border
                Background="#F8F9FA"
                BorderBrush="#E0E0E0"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Column="1"
                Margin="10,0,0,0"
                Padding="15">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!--  Заголовок деталей  -->
                        <TextBlock
                            FontSize="16"
                            FontWeight="Bold"
                            Foreground="#333"
                            Margin="0,0,0,15"
                            Text="📄 Информация о приложении" />

                        <!--  Информация о выбранном приложении  -->
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#666"
                                Grid.Column="0"
                                Grid.Row="0"
                                Margin="0,0,10,0"
                                Text="Канал:" />
                            <TextBlock
                                Foreground="#333"
                                Grid.Column="1"
                                Grid.Row="0"
                                Text="{Binding SelectedRelease.Info.Channel, FallbackValue='Не выбрано'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#666"
                                Grid.Column="0"
                                Grid.Row="1"
                                Margin="0,0,10,5"
                                Text="Версия:" />
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="#333"
                                Grid.Column="1"
                                Grid.Row="1"
                                Margin="0,0,0,5"
                                Text="{Binding SelectedRelease.Info.Version, FallbackValue='Не выбрано'}" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#666"
                                Grid.Column="0"
                                Grid.Row="2"
                                Margin="0,0,10,5"
                                Text="Путь:" />
                            <TextBlock
                                FontSize="13"
                                Foreground="#555"
                                Grid.Column="1"
                                Grid.Row="2"
                                Margin="0,0,0,5"
                                Text="{Binding SelectedRelease.Path, FallbackValue='—'}"
                                TextWrapping="Wrap" />

                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="#666"
                                Grid.Column="0"
                                Grid.Row="3"
                                Margin="0,0,10,0"
                                Text="Статус:" />
                            <TextBlock
                                FontWeight="Bold"
                                Foreground="#4CAF50"
                                Grid.Column="1"
                                Grid.Row="3"
                                Text="✅ Готов к запуску" />
                        </Grid>

                        <!--  Разделитель  -->
                        <Border
                            Background="#E0E0E0"
                            Height="1"
                            Margin="0,0,0,15" />

                        <!--  Сообщение, если ничего не выбрано  -->
                        <TextBlock
                            FontSize="14"
                            Foreground="#999"
                            HorizontalAlignment="Center"
                            Margin="0,30,0,0"
                            Text="Выберите приложение из списка слева"
                            VerticalAlignment="Center" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!--  Кнопки действий  -->
        <StackPanel
            Grid.Row="2"
            Margin="0,15,0,0"
            Orientation="Horizontal">

            <Button
                Background="#4CAF50"
                Command="{Binding LaunchCommand}"
                Content="▶️ Запустить выбранное приложение"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White"
                Padding="25,10" />

            <Button
                Background="#66BB6A"
                Command="{Binding CreateShortcutCommand}"
                Content="🖥️ Создать значок на рабочем столе"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="10,0,0,0"
                Padding="20,10" />

            <Button
                Background="#2196F3"
                Command="{Binding RefreshCommand}"
                Content="🔄 Обновить список"
                Cursor="Hand"
                FontWeight="SemiBold"
                Foreground="White"
                Margin="10,0,0,0"
                Padding="20,10" />

        </StackPanel>
    </Grid>
</UserControl>